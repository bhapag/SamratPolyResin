---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { products } from '../../data/products.js';
import { resources } from '../../data/resources.js';
import { site, buildCanonicalUrl, ORGANIZATION_ID, WEBSITE_ID } from '../../data/site.js';

// "FRP Allied Products" is an existing category in products.js with 7 products
// and, after the September 2026 consolidation, six substantial supporting
// guides — but it had no hub of its own. Only 2 of the 8 catalogue categories
// did, and /products/ itself was ranking at average position 34.8 with a 0%
// CTR, so the catalogue had no working entry point for anything below the
// resin grades themselves.
//
// This hub owns the "everything except the resin" intent: the reinforcement,
// colour, solvent, filler, release and application-tool items a workshop has
// to order alongside a drum of resin and routinely under-orders. No new
// product, claim or specification is introduced here.
const grades = products.filter((p) => p.category === 'FRP Allied Products');

const relatedResourceSlugs = [
  'what-is-glass-fiber-chopped-strand-mat',
  'csm-300-vs-csm-450-glass-fiber',
  'what-is-frp-polyester-pigment',
  'polyester-pigment-paste-vs-gelcoat',
  'what-is-styrene-monomer',
  'what-is-soapstone-talc-powder',
  'what-is-frp-mould-release-wax',
  'selecting-brushes-for-resin-and-gelcoat-application',
  'what-is-nc-thinner',
  'nc-thinner-vs-general-purpose-thinner',
];
const relatedResources = relatedResourceSlugs
  .map((slug) => resources.find((r) => r.slug === slug && !r.draft))
  .filter(Boolean);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: buildCanonicalUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Products', item: buildCanonicalUrl('/products/') },
    { '@type': 'ListItem', position: 3, name: 'FRP Allied Products', item: buildCanonicalUrl('/products/frp-allied-products/') },
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'FRP Allied Products',
  url: buildCanonicalUrl('/products/frp-allied-products/'),
  description: `The ${grades.length} reinforcement, colour, solvent, filler, release and application products Samrat Poly Resins supplies alongside its resin grades.`,
  isPartOf: { '@id': WEBSITE_ID },
  publisher: { '@id': ORGANIZATION_ID },
  hasPart: grades.map((p) => ({
    '@type': 'Product',
    name: p.name,
    url: buildCanonicalUrl(`/products/${p.slug}/`),
  })),
};
---
<Base
  title="FRP Allied Products — Glass Fibre, Pigment, Release Wax & Consumables"
  description={`The ${grades.length} materials an FRP workshop orders alongside resin: E-glass chopped strand mat, polyester pigment, styrene monomer, NC thinner, soapstone filler, mould release wax and application brushes. Published specifications with TDS.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />

  <section class="section fam-hero">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/products/">Products</a> <span aria-hidden="true">/</span>
        <span aria-current="page">FRP Allied Products</span>
      </nav>
      <div class="fam-hero-inner">
        <div>
          <p class="eyebrow">Product family</p>
          <h1>FRP Allied Products</h1>
          <p class="fam-hero-sub">
            Resin is only part of what an FRP job consumes. {site.name} supplies these {grades.length} products alongside its resin grades, covering the rest of the
            bill of materials: E-glass chopped strand mat for reinforcement, polyester pigment for colour,
            styrene monomer as a reactive diluent, NC thinner for lacquer systems, soapstone powder as a
            mineral filler, mould release wax for tooling, and application brushes. Each is a distinct
            published product with its own specifications, and most carry a downloadable TDS.
          </p>
          <p class="fam-hero-note">
            These are the line items most often under-ordered when a job is planned. Brushes used with
            catalysed resin are effectively consumable, and running out mid-batch — with resin already
            catalysed and gelling — is not a good position to be in.
          </p>
        </div>
        <div class="fam-hero-badge">
          <span class="fam-hero-badge-num">{grades.length}</span>
          <span class="fam-hero-badge-label">Published<br/>Products</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section fam-grades">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{grades.length} products</p>
        <h2>Allied products &amp; consumables</h2>
      </div>
      <div class="grid">
        {grades.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  {relatedResources.length > 0 && (
    <section class="section fam-links">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Resources</p>
          <h2>Guides for these materials</h2>
        </div>
        <div class="fam-card-grid">
          {relatedResources.map((r) => (
            <a href={`/resources/${r.slug}/`} class="fam-link-card">
              <span>{r.title}</span>
              <span class="fam-link-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section fam-enquire">
    <div class="wrap fam-enquire-inner">
      <div class="section-head">
        <p class="eyebrow">Enquiry</p>
        <h2>Ask about an allied product</h2>
        <p class="fam-enquiry-note">
          Share the product (if known), what you are making, expected quantity and delivery location.
          For glass fibre, say whether you need CSM 300 or CSM 450; for pigment, the resin or gelcoat
          system and the colour reference. <a href="/how-to-order/">How ordering works →</a>
        </p>
      </div>
      <div class="fam-enquire-box">
        <EnquiryForm pageContext="frp-allied-products-family" messagePlaceholder="Product (if known), application, quantity, delivery location" />
      </div>
      <a href={site.catalogue.url} class="doc-link fam-doc-link" target="_blank" rel="noopener" download
         aria-label={`Download ${site.catalogue.title} (PDF)`}>
        <span class="doc-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V4.5A1.5 1.5 0 0 1 5.5 3H18a1 1 0 0 1 1 1v15.2"/><path d="M6.5 3v18"/><path d="M6.5 21H19a1 1 0 0 0 1-1v-.5a1 1 0 0 0-1-1H6.8"/></svg>
        </span>
        <span class="doc-link-body"><span class="doc-link-kind">Catalogue</span><span class="doc-link-title">Full product range &amp; specs (PDF)</span></span>
        <span class="doc-link-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <style>
    .fam-hero { padding-bottom: 0; }
    .fam-hero-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
    .fam-hero h1 { font-size: clamp(2rem, 5.5vw, 3.2rem); margin-top: 0.6rem; }
    .fam-hero-sub { color: var(--ink-dim); margin-top: 1rem; max-width: 68ch; line-height: 1.7; }
    .fam-hero-note {
      color: var(--ink-faint); margin-top: 0.9rem; max-width: 64ch; line-height: 1.65;
      font-size: 0.88rem; border-left: 2px solid var(--line-2); padding-left: 0.9rem;
    }
    .fam-hero-badge {
      flex-shrink: 0; display: flex; flex-direction: column; align-items: center; text-align: center;
      padding: 1.4rem 1.8rem; border: 1px solid var(--line-2); background: var(--bg-3);
      box-shadow: var(--surface-shadow-rest);
    }
    .fam-hero-badge-num { font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; color: var(--accent-gold-light); line-height: 1; }
    .fam-hero-badge-label {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-faint); margin-top: 0.6rem; line-height: 1.5;
    }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.4rem; }

    .fam-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.9rem; }
    .fam-link-card {
      display: flex; align-items: center; justify-content: space-between; gap: 0.9rem;
      padding: 1rem 1.2rem; background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
      color: var(--ink-dim); font-size: 0.92rem; line-height: 1.5;
      transition: border-color .25s var(--ease-premium), transform .25s var(--ease-premium), box-shadow .25s var(--ease-premium), color .25s var(--ease-premium);
    }
    .fam-link-card:hover { border-color: var(--line-2); color: var(--ink); transform: translateY(-2px); box-shadow: var(--surface-shadow-hover); }
    .fam-link-card:hover .fam-link-card-arrow { transform: translateX(3px); color: var(--accent-gold); }
    .fam-link-card-arrow { flex-shrink: 0; color: var(--ink-faint); transition: transform .25s var(--ease-premium), color .25s var(--ease-premium); }

    .fam-enquire-inner { max-width: 720px; }
    .fam-enquiry-note { color: var(--ink-dim); margin-top: 0.7rem; line-height: 1.7; }
    .fam-enquire-box { background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); padding: clamp(1.4rem, 4vw, 2.2rem); }
    .fam-doc-link { margin-top: 1.4rem; }
    @media (max-width: 620px) { .fam-hero-inner { flex-direction: column; } .fam-hero-badge { flex-direction: row; gap: 1rem; align-self: flex-start; } }
    @media (prefers-reduced-motion: reduce) { .fam-link-card, .fam-link-card-arrow { transition: none; } .fam-link-card:hover { transform: none; } }
  </style>
</Base>
