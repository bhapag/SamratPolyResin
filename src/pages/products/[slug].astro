// Two distinct WhatsApp CTAs on this page: the pricing block's "Request
// Bulk Quote" button is a quote request, the separate plain "WhatsApp"
// button next to the enquiry form is a product enquiry — each now sends
// its own short, correctly-intended message instead of one shared payload.
const productWaName = product.whatsappName ?? name;
const productWaLink = buildWhatsAppLink('product', productWaName);
const quoteWaLink = buildWhatsAppLink('quote', productWaName);

// "Explore applications" cards — only populated when a product names
// applicationSlugs (currently gp-clear-resin only). Cards for draft entries
// still render (so all named applications appear) but link back to this
// product page instead of a dead /applications/ URL, since their dedicated
// page isn't built yet — never a dead-end "coming soon" state.
const appCards = await Promise.all(
  (product.applicationSlugs ?? []).map(async (s) => {
    const app = applicationGuides.find(a => a.slug === s);
    if (!app) return null;
    let cardImg = null;
    if (app.cardImage) {
      const mod = resolveAppImage(app.cardImage);
      if (mod) cardImg = await getImage({ src: mod, width: 480, format: 'webp' });
    }
    const relatedProducts = (app.relatedProductSlugs ?? [])
      .map(rs => products.find(p => p.slug === rs))
      .filter(Boolean);
    const href = app.draft ? `/products/${product.slug}/` : `/applications/${app.slug}/`;
    return { ...app, cardImg, relatedProducts, href };
  })
).then(list => list.filter(Boolean));

// Where this product's category has its own hub page, the breadcrumb gains a
// real category step (Home / Products / GP Resins / GP Clear Resin). That
// gives every grade a contextual up-link to its family page — previously the
// only route to a hub was the /products/ index — and makes the visible
// hierarchy match the site's actual structure.
const categoryHubUrl = CATEGORY_HUBS[product.category]
  ? `/products/${CATEGORY_HUBS[product.category]}/`
  : null;

// BreadcrumbList — mirrors the visible breadcrumb below exactly, no extra data.
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: buildCanonicalUrl('/') },
    { "@type": "ListItem", position: 2, name: "Products", item: buildCanonicalUrl('/products/') },
    ...(categoryHubUrl
      ? [{ "@type": "ListItem", position: 3, name: product.category, item: buildCanonicalUrl(categoryHubUrl) }]
      : []),
    { "@type": "ListItem", position: categoryHubUrl ? 4 : 3, name, item: buildCanonicalUrl(Astro.url.pathname) },
  ],
};

// Product schema — deliberately omits `offers`/price. Pricing here is
// "Price on Request" (varies by quantity and current raw-material rates),
// and Schema.org Offers without a real price fail Google's structured-data
// validation — better to omit it than publish a placeholder number.
// Surface the spec sheet to search engines as PropertyValues so the Product
// entity carries its real technical attributes (resin type, viscosity, gel
// time, etc.), not just a name + description. Works for grouped or legacy specs.
const schemaSpecEntries = [
  ...(techEntries ?? []),
  ...(detailEntries ?? []),
  ...(legacySpecEntries ?? []),
];
const additionalProperty = schemaSpecEntries.map(([propertyName, value]) => ({
  "@type": "PropertyValue",
  name: propertyName,
  value: String(value),
}));
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  description,
  category,
  sku: product.slug,
  url: buildCanonicalUrl(Astro.url.pathname),
  image: mainImage ? buildCanonicalUrl(mainImage.main.src) : undefined,
  // Both point at the ONE sitewide Organization node by @id, so every product
  // page reinforces the same entity instead of declaring a fresh, unlinked
  // organisation 31 times. The name is kept alongside the @id so the markup
  // still reads correctly on its own.
  brand: { "@type": "Organization", "@id": ORGANIZATION_ID, name: site.name },
  ...(!isGlassFiber ? { manufacturer: { "@type": "Organization", "@id": ORGANIZATION_ID, name: site.name } } : {}),
  ...(additionalProperty.length ? { additionalProperty } : {}),
};

// FAQPage schema — same shape used by the resource articles. Only emitted when
// the product actually supplies FAQs, so no empty schema on other pages.
const faqJsonLd = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<Base
  title={isGpClearResin ? gpClearSeo.title : isGpWhiteResin ? gpWhiteSeo.title : isLaminationResin ? laminationSeo.title : isGpGelcoatResin ? gelcoatSeo.title : isGpYellowResin ? gpYellowSeo.title : isSheetGradeYellowResin ? sheetGradeYellowSeo.title : isRoofLightResin ? roofLightSeo.title : isFireRetardantResin ? fireRetardantSeo.title : isButtonGradeResin ? buttonGradeSeo.title : isUnsaturatedPolyesterResin ? unsaturatedPolyesterSeo.title : isGlassFiber ? glassFiberSeo.title : isFrpPolyesterPigment ? frpPolyesterPigmentSeo.title : isMekpHardener ? mekpHardenerSeo.title : isEpoxyHardener ? epoxyHardenerSeo.title : isEpoxyArtResin ? epoxyArtSeo.title : isUvResin ? uvResinSeo.title : isEpoxyClearCastingResin ? epoxyClearCastingSeo.title : (product.seo?.title ?? name)}
  trackingProductSlug={product.slug}
  trackingProductName={name}
  description={isLaminationResin ? laminationSeo.description : isGpGelcoatResin ? gelcoatSeo.description : isGpYellowResin ? gpYellowSeo.description : isSheetGradeYellowResin ? sheetGradeYellowSeo.description : isRoofLightResin ? roofLightSeo.description : isFireRetardantResin ? fireRetardantSeo.description : isButtonGradeResin ? buttonGradeSeo.description : isUnsaturatedPolyesterResin ? unsaturatedPolyesterSeo.description : isGlassFiber ? glassFiberSeo.description : isFrpPolyesterPigment ? frpPolyesterPigmentSeo.description : isMekpHardener ? mekpHardenerSeo.description : isEpoxyHardener ? epoxyHardenerSeo.description : isEpoxyArtResin ? epoxyArtSeo.description : isUvResin ? uvResinSeo.description : isEpoxyClearCastingResin ? epoxyClearCastingSeo.description : (product.seo?.description ?? `${name} — ${product.tagline} Manufactured by ${site.name}.`)}
  keywords={isGpClearResin ? gpClearSeo.keywords : isGpWhiteResin ? gpWhiteSeo.keywords : isLaminationResin ? laminationSeo.keywords : isGpGelcoatResin ? gelcoatSeo.keywords : isGpYellowResin ? gpYellowSeo.keywords : isSheetGradeYellowResin ? sheetGradeYellowSeo.keywords : isRoofLightResin ? roofLightSeo.keywords : isFireRetardantResin ? fireRetardantSeo.keywords : isButtonGradeResin ? buttonGradeSeo.keywords : isUnsaturatedPolyesterResin ? unsaturatedPolyesterSeo.keywords : isGlassFiber ? glassFiberSeo.keywords : isFrpPolyesterPigment ? frpPolyesterPigmentSeo.keywords : isMekpHardener ? mekpHardenerSeo.keywords : isEpoxyHardener ? epoxyHardenerSeo.keywords : isEpoxyArtResin ? epoxyArtSeo.keywords : isUvResin ? uvResinSeo.keywords : isEpoxyClearCastingResin ? epoxyClearCastingSeo.keywords : product.seo?.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span>{categoryHubUrl && (<><a href={categoryHubUrl}>{product.category}</a><span>/</span></>)}<span class="cur">{name}</span>
  </div>

  <article class="wrap prod" style={mediaVars}>
    <div class="prod-media">
      <div class="prod-media-sticky">
        <div class:list={['prod-img', { noimg: !mainImage }]}>
          {mainImage && (
            <img src={mainImage.main.src} srcset={mainImage.srcset}
                 sizes={`(max-width: 620px) ${mobileWidth}px, ${mediaWidth}px`}
                 width={mainImage.main.attributes.width} height={mainImage.main.attributes.height}
                 alt={product.imageAlt ?? name} id="prodMainImg"
                 loading="eager" fetchpriority="high" decoding="async"
                 transition:name={`product-photo-${product.slug}`} />
          )}
          {!mainImage && identityPanel ? (
            /* A code-native identity panel, used where no truthful product
               photography exists for the grade. It states what the product
               is rather than borrowing another product's pack shot, and it
               invents no packaging, colour or laboratory scene. Readable
               text, not an image of text. */
            <div class="prod-identity">
              <span class="prod-identity-mark" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 5h10M21 5v13.2L9.6 37.4A5 5 0 0 0 13.9 45h20.2a5 5 0 0 0 4.3-7.6L27 18.2V5" />
                  <path d="M14.5 30h19" />
                </svg>
              </span>
              <p class="prod-identity-kicker">{identityPanel.kicker}</p>
              <p class="prod-identity-name">{name}</p>
              <p class="prod-identity-role">{identityPanel.role}</p>
              <p class="prod-identity-note">{identityPanel.note}</p>
            </div>
          ) : isFiberglassEpoxyResin && !mainImage ? (
            <span class="fiberglass-epoxy-placeholder" aria-hidden="true">
              <strong>Fiberglass<br />Epoxy Resin</strong>
              <small>Document-led product route</small>
            </span>
          ) : (
            <span class="img-fallback" aria-hidden="true">{isDmcSmcResin ? 'DMC' : isPetResin ? 'PET' : isBisphenolResin ? 'BIS' : name.split(' ').map(w=>w[0]).join('').slice(0,3)}</span>
          )}
        </div>
        {gallery.length > 1 && (
          <div class="prod-thumbs" role="list">
            {galleryImages.map((g, i) => g && (
              <button type="button" class:list={['prod-thumb', { active: i === 0 }]}
                      data-src={g.main.src} data-srcset={g.srcset}
                      data-ar={Math.min(AR_MAX, Math.max(AR_MIN, g.ar))}
                      style={`--thumb-ar:${Math.min(1.8, Math.max(0.68, g.ar))}`}
                      aria-label={`Show photo ${i + 1} of ${name}`}>
                <img src={g.thumb.src} width={g.thumb.attributes.width} height={g.thumb.attributes.height} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
        {isMarbleResin && (
          <p class="marble-image-note">Illustrative product graphic. Use the <a href={tdsUrl} target="_blank" rel="noopener" download>current Marble Resin TDS</a> for verified supplied-resin data, documented applications and grade selection.</p>
        )}
        {isPolyesterPuttyResin && (
          /* The artwork is the grade's earlier PET Resin poster and carries a
             specification table and a food-contact claim for that earlier
             sheet grade. The page copy, FAQ and schema do not repeat any of
             it, and the sheet-grade documents are not linked — this note is
