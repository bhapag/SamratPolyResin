    .lamination-enquiry-note { color: var(--ink-dim); font-size: 0.92rem; margin-top: 0.65rem; max-width: 58ch; }
    .gelcoat-enquiry-note { color: var(--ink-dim); font-size: 0.92rem; margin-top: 0.65rem; max-width: 58ch; }
    .gp-yellow-enquiry-note { color: var(--ink-dim); font-size: 0.92rem; margin-top: 0.65rem; max-width: 58ch; }
    .button-enquiry-note, .mekp-enquiry-note, .epoxy-casting-enquiry-note { color: var(--ink-dim); font-size: 0.92rem; margin-top: 0.65rem; max-width: 58ch; }

    /* ---------- in-page section navigation ---------- */
    .prod-toc {
      margin: 2rem 0 0; padding: 1.1rem 1.25rem;
      background: var(--bg-3); border: 1px solid var(--line);
      box-shadow: var(--surface-shadow-rest);
    }
    .prod-toc-title {
      font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.75rem;
    }
    .prod-toc-list {
      list-style: none; margin: 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: 0.4rem 0.5rem;
    }
    /* Same chip treatment as the Knowledge Centre and Applications jump
       navigation, so in-page navigation looks like one idea across the site.
       Background is --bg-2 against the panel's --bg-3: --line alone is too
       close to the panel colour and the chips read as one block of text.

       :global() is required, not optional. Astro scopes page styles by
       stamping a data-astro-cid attribute on elements in the TEMPLATE, and
       these <li>/<a> elements are created by the script above at runtime, so
       they never carry it. Without :global() the rules silently do not apply
       and the chips render as plain body text - which is exactly what
       happened on the first attempt. */
    .prod-toc-list :global(li) { display: inline-flex; }
    .prod-toc-list :global(a) {
      display: inline-block; padding: 0.42rem 0.78rem;
      font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.03em;
      line-height: 1.35; color: var(--ink-dim);
      background: var(--bg-2); border: 1px solid var(--line-2);
      transition: border-color .25s var(--ease-premium), color .25s var(--ease-premium);
    }
    .prod-toc-list :global(a:hover),
    .prod-toc-list :global(a:focus-visible) {
      border-color: var(--accent-gold); color: var(--ink);
    }
    /* The site header is sticky, so a jump would otherwise land the heading
       underneath it. */
    .prod-section-anchor { scroll-margin-top: 5.5rem; }

    /* ====================================================================
       PROTOTYPE — premium product presentation
       All rules below are scoped to this template by Astro. Nothing here
       changes copy, facts, URLs, heading order, schema or canonicals.
       ==================================================================== */

    /* 1. Section headings were 60.8px at 1440 — LARGER than the 51.2px h1.
          Brought under the h1 so the ramp reads 51 / 32 / 20 monotonically. */
    /* These sections are siblings of .prod, not descendants, so the rule has
       to target .section-head directly. Astro's scoping attribute keeps it to
       this template — no other page's heading scale is affected. */
    .section-head h2 { font-size: clamp(1.5rem, 2.6vw, 2rem); }
    .section-head { margin-bottom: 2rem; }

    /* 1b. Releasing the body to 1100px would otherwise set prose at ~140
           characters per line. Tables and card grids take the full width;
           running prose is held to a readable measure. Paragraphs already
           inside cards are narrower than this and are unaffected. */
    .prod-body p { max-width: 62ch; }

    /* 1c. `.gp-overview` is the one prose-only panel in the body. At the full
           1100px it became a bordered box with text in its left half and
           ~480px of void on the right. Capped to the prose measure so the
           panel fits its content. Card-grid sections (.gp-buyer-outcomes,
           .upr-grade-guide, .spec-grid) genuinely use the width and keep it. */
    .prod-body .gp-overview { max-width: 46rem; }
    .prod-body .gp-overview p { max-width: none; }

    /* 2. The ledger is the most premium element on the page and the one a
          buyer actually reads. Released to full width it would become one
          very long strip, so the two tables sit side by side instead. */
    @media (min-width: 900px) {
      .specs-ledger {
        display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0 clamp(2rem, 4vw, 3.5rem);
        align-items: start; align-content: start;
        /* The two tables rarely have equal row counts (6 vs 10 here), so the
           shorter column leaves trailing space. A rule between the columns
           makes that read as a two-column document rather than a gap, and a
           tighter bottom padding stops it becoming a dead band. */
        padding-bottom: 1.4rem;
      }
      /* Six allied-product pages (cobalt-octoate, nc-thinner, paint-brushes,
         soap-stone-powder, styrene-monomer, wax-polish) publish only Product
         details — no technical specifications table. In a fixed two-column
         grid that left a 578px empty right half. With one table the panel
         collapses to a single column sized to its content. Degrades to the
         previous behaviour if :has() is unsupported. */
      .specs-ledger:has(> .specs-table-wrap:only-child) {
        grid-template-columns: minmax(0, 1fr);
        max-width: 42rem;
      }
      .specs-ledger > .specs-table-wrap { margin-top: 0; }
      .specs-ledger > .specs-table-wrap + .specs-table-wrap {
        padding-left: clamp(2rem, 4vw, 3.5rem);
        margin-left: calc(-1 * clamp(2rem, 4vw, 3.5rem) / 2);
        border-left: 1px solid var(--ledger-line);
      }
    }

    /* 3. Contents was 18 chips of 112–429px wrapping into ~11 ragged rows —
          a tag cloud, not navigation. Now an even, scannable column set. */
    @media (min-width: 700px) {
      .prod-toc-list { display: block; column-count: 3; column-gap: 2rem; }
      .prod-toc-list :global(li) { display: block; break-inside: avoid; }
    }
    .prod-toc-list :global(a) {
      display: block; background: transparent; border: none;
      border-bottom: 1px solid var(--line);
      padding: 0.5rem 0 0.5rem 0; font-size: 0.76rem;
    }
    .prod-toc-list :global(a:hover),
    .prod-toc-list :global(a:focus-visible) {
      border-bottom-color: var(--accent-gold); color: var(--accent-gold-light);
    }

    /* 4. Two solid-gold CTAs sat within ~100px of each other, so neither won.
          The enquiry form is the single primary (it is also the only one GA4
          records as a key event); the in-panel quote button becomes its
          secondary. Both destinations are unchanged. */
    .prod-quote .prod-quote-cta.btn-solid {
      background: transparent; color: var(--ink);
      border-color: var(--line-2); font-weight: 500;
    }
    .prod-quote .prod-quote-cta.btn-solid:hover {
      border-color: var(--accent-gold); color: var(--accent-gold-light);
      background: transparent; box-shadow: none;
    }

    /* 4b. FAQ questions rendered at 18.7px — only 1.3px below the 20px h2
           above them, so a question read as loud as its section heading.
           Stepped down to restore the gap. FaqAccordion is shared with the
           application and resource templates, so this is scoped here via
           :global() rather than edited in the component. */
    .prod-faq :global(.faq-item h3) { font-size: 1.06rem; }

    /* 5. Masthead breathing room now that the rail is narrower. */
    .prod-quote, .prod-docs { max-width: none; }
    .prod-img { border-radius: 4px; overflow: hidden; }

    /* 6. Once the grid stacks (<=860px) the rail's width constraint is gone,
          so the poster would otherwise fill most of the first screen before
          the product name is reached. The frame now follows the artwork, so
          the cap is a height rather than a forced ratio: landscape posters
          sit well under it, and only tall portrait art is limited. */
    @media (max-width: 860px) {
      .prod-media-sticky { max-width: min(100%, var(--prod-media-w, 420px)); }
      .prod-thumbs { max-width: 420px; }
      .prod-img { max-height: 460px; }
    }
    /* 7. Phone widths. Previously the frame was forced to 5:4 here, which
          letterboxed landscape artwork and pillarboxed portrait artwork at
          the size where screen space is scarcest. Keeping the artwork's own
          ratio and capping the height instead means a landscape poster is
          now shorter than the old box (so the product name moves UP), while
          a portrait asset is limited rather than distorted. `contain` still
          guarantees the complete artwork is visible.

          The cap is deliberately close to the old effective height (355px
          wide at 5:4 was 284px tall), so square and portrait products keep
          the product name near the position buyers already see it at, while
          still gaining drawn size because the artwork no longer has to fit a
          ratio that is not its own. */
    @media (max-width: 620px) {
      .prod-img { max-height: 320px; }
    }

    @media (max-width: 760px) {
      /* The floating WhatsApp button is fixed bottom-right (48px at x331–379
         in a 390px viewport). Full-bleed tap targets would run underneath it,
         so the contents links — which this prototype changed from inline
         chips to full-width rows — stop short of that zone. */
      .prod-toc-list :global(a) { margin-right: 3.4rem; }
    }
  </style>

  <style is:global>
    /* PROTOTYPE — product pages only (gated on .prod, which exists on no
       other template). The sitewide floating button is not modified for the
       rest of the site in this phase. */
    @media (max-width: 860px) {
      body:has(.prod) .wa-float { width: 48px; height: 48px; right: 0.7rem; bottom: 0.7rem; }
      /* The sweep found a tappable element under the fixed button on 22 of 31
         pages at 390px and 16 of 31 at 820px — always deep in the page, over
         FAQ questions and related-product cards. Desktop was clean (0 of 31).
         The button now steps out of the way while the reader scrolls down and
         returns on any upward scroll, so it never sits on a tap target being
         read toward. Progressive enhancement: with no JS it simply stays. */
      body:has(.prod) .wa-float {
        transition: transform .28s var(--ease-premium), opacity .28s var(--ease-premium);
      }
      body:has(.prod) .wa-float[data-tucked='true'] {
        transform: translateY(140%); opacity: 0; pointer-events: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      body:has(.prod) .wa-float { transition: none; }
    }
  </style>

  <script>
    // Product pages only: tuck the floating WhatsApp button away while the
    // reader scrolls down, restore it on any upward scroll. The button lives
    // in Base.astro and carries transition:persist, so the previous handler
    // is removed before a new one is attached on client-side navigation.
    document.addEventListener('astro:page-load', () => {
      const prev = (window as any).__prodFabTuck as (() => void) | undefined;
      if (prev) { window.removeEventListener('scroll', prev); (window as any).__prodFabTuck = undefined; }

      const fab = document.querySelector('.wa-float') as HTMLElement | null;
      if (!fab) return;
      // Leaving a product page must not strand the button hidden.
      delete fab.dataset.tucked;
      if (!document.querySelector('.prod')) return;

      const small = () => window.matchMedia('(max-width: 860px)').matches;
      let last = window.scrollY;
      let ticking = false;

      const apply = () => {
        ticking = false;
        const y = window.scrollY;
        const delta = y - last;
        if (Math.abs(delta) < 6) return;      // ignore jitter
        last = y;
        if (!small() || y < 240) { delete fab.dataset.tucked; return; }
        if (delta > 0) fab.dataset.tucked = 'true';
        else delete fab.dataset.tucked;
      };
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(apply);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      (window as any).__prodFabTuck = onScroll;
    });
  </script>
</Base>
