// Two-table model (Product Details + Technical Specifications) when a product
// supplies the grouped fields; otherwise fall back to the legacy single table
// so the other products render exactly as before.
const detailEntries = product.productDetails ? Object.entries(product.productDetails) : null;
const techEntries = product.techSpecs ? Object.entries(product.techSpecs) : null;
const legacySpecEntries = !detailEntries && !techEntries && specs ? Object.entries(specs) : [];

// Keep the existing Fiberglass Epoxy product graphics visible in the gallery.
// They remain clearly identified on the page as illustrative graphics rather
// than technical evidence for the supplied grade.
const gallery = [image, ...(product.images ?? [])];

// Resolve each gallery photo to optimised, compressed webp: a responsive set
// for the large main viewer, one small encode for the thumbnail strip. The
// thumbnail's `data-src` carries the main-size URL so the click-to-swap
// script (below) can assign it straight to the main <img>'s src.
const galleryImages = await Promise.all(
  gallery.map(async (filename) => {
    const mod = resolveProductImage(filename);
    if (!mod) return null;
    // The frame below is sized from the artwork, so a landscape poster is now
    // drawn wider than the old 360px rail allowed. A single 700px encode
    // would be upscaled at that size on a 2x screen, so emit a real srcset,
    // and never request a width the source cannot supply.
    // Ladder spacing matters more than ladder length. A 390px phone at 2x
    // needs ~710px, so a gap between 700 and 1040 makes the browser jump to
    // 1040 and roughly doubles the hero download for no visible gain. These
    // steps keep a close candidate at every real frame size and DPR.
    const widths = [400, 560, 720, 900, 1120, 1400].filter((w) => w <= mod.width);
    if (!widths.length) widths.push(mod.width);
    const [thumb, ...scaled] = await Promise.all([
      getImage({ src: mod, width: 160, format: 'webp' }),
      ...widths.map((w) => getImage({ src: mod, width: w, format: 'webp' })),
    ]);
    // `src` points at the largest encode so a browser ignoring srcset still
    // gets a sharp image rather than the smallest one.
    const main = scaled[scaled.length - 1];
    const srcset = scaled.map((im, i) => `${im.src} ${widths[i]}w`).join(', ');
    return { main, thumb, srcset, ar: +(mod.width / mod.height).toFixed(4) };
  })
);
const mainImage = galleryImages[0];

// --- Media frame geometry -------------------------------------------------
// The frame follows the artwork instead of forcing every asset into a square.
// The catalogue holds three genuine shape families — landscape posters,
// square product shots and portrait bottle shots — so one shared rule driven
// by each asset's own ratio serves all of them with no per-product CSS.
//
// The clamp exists only to stop an extreme asset producing an absurd frame;
// inside it the ratio is the artwork's own, so `object-fit: contain` has
// nothing to letterbox. A gallery can mix ratios, so every thumbnail carries
// its own ratio and the swap script re-points the variable.
const AR_MIN = 0.72;
const AR_MAX = 1.9;
const heroAr = mainImage ? Math.min(AR_MAX, Math.max(AR_MIN, mainImage.ar)) : 1;
// Landscape artwork earns a wider column: at the old fixed 360px a 1.63-ratio
// poster rendered only 219px tall inside a 360px box. Portrait art needs the
// opposite, or the frame grows far taller than the masthead beside it.
const mediaWidth = heroAr >= 1.15 ? 480 : heroAr <= 0.87 ? 380 : 420;
// On phones the frame is height-capped at 320px, so a square or portrait
// asset is narrower than the column. Declaring the true width in `sizes`
// stops the browser fetching a candidate sized for a box it never draws.
const mobileWidth = Math.round(Math.min(355, 320 * heroAr));
const mediaVars = `--prod-ar:${heroAr};--prod-media-w:${mediaWidth}px;`;

// Where a grade has no truthful product photography, the media frame renders
// a code-native identity panel instead of borrowing another product's artwork
// or showing an empty plate. Keyed off the product's own published role, so
// it states identity rather than inventing a pack shot.
// Kept for any grade that has no truthful artwork. Empty at present: both
// products that used it now carry an image again.
const IDENTITY_PANELS = {};
const identityPanel = !mainImage ? IDENTITY_PANELS[product.slug] : undefined;

// Curated related products when the product names them explicitly (lets a page
// reference cross-category grades intentionally); otherwise auto-fill from the
// same category. filter(Boolean) drops any slug that no longer resolves.
const related = product.relatedSlugs?.length
  ? product.relatedSlugs.map(s => products.find(p => p.slug === s)).filter(Boolean)
  : products.filter(p => p.category === category && p.slug !== product.slug).slice(0, 3);
const relatedHeading = product.relatedSlugs?.length ? 'Related products' : `More in ${category}`;

// Generic "Related Reading" support — any product can list resource slugs
// here to surface a reading-hub section, without needing its own isXxx
// special case + hardcoded block (the pattern every earlier product below
// uses). Existing special-cased products are unaffected; this only renders
// when a product sets the new field and isn't already handled by one of
// those bespoke blocks.
const genericResources = (product.resourceSlugs ?? [])
  .map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft))
  .filter(Boolean);

// Curated reading for GP Clear Resin buyers. These point only to existing,
// published resources and are intentionally limited to this product page.
const gpResourceSlugs = [
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'what-is-gel-coat-resin',
];
const gpResources = isGpClearResin
  ? gpResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const gpWhiteResourceSlugs = [
  'what-is-gp-white-resin',
  'gp-white-resin-vs-gp-clear-resin',
  'gp-white-resin-buyer-guide',
