    .app-card-title-link { color: var(--ink); }
    .app-card-title-link:hover { color: var(--accent-gold-light); }
    /* Stretched-link pattern: this is the one real link that makes the whole
       card clickable. Related-product links below get position+z-index so
       they still receive their own clicks instead of being swallowed by it. */
    .app-card-title-link::after { content: ''; position: absolute; inset: 0; }
    .app-card-desc { color: var(--ink-dim); font-size: 0.86rem; line-height: 1.55; }
    .app-card-benefit { color: var(--ink); font-size: 0.84rem; font-weight: 600; }
