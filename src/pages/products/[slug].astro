  <script>
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll<HTMLButtonElement>('.prod-thumb').forEach((btn) => {
        btn.addEventListener('click', () => {
          const main = document.getElementById('prodMainImg') as HTMLImageElement | null;
          const src = btn.dataset.src;
          if (!main || !src || main.src.endsWith(src)) return;
          main.classList.add('fading');
          window.setTimeout(() => {
            // srcset wins over src, so it has to be replaced too or the
            // browser keeps serving the previous photo's candidates.
            if (btn.dataset.srcset) main.srcset = btn.dataset.srcset;
            main.src = src;
            // A gallery can mix shapes (a square product shot beside a
            // portrait bottle shot). Re-point the frame ratio so the
            // incoming photo is not letterboxed in the outgoing one's box.
            const ar = btn.dataset.ar;
            const frame = main.closest('.prod') as HTMLElement | null;
            if (ar && frame) frame.style.setProperty('--prod-ar', ar);
            main.classList.remove('fading');
          }, 140);
          document.querySelectorAll('.prod-thumb').forEach((b) => b.classList.remove('active'));
          btn.classList.add('active');
        });
      });
    });
  </script>

  <script>
    // Build the product page's section navigation from the headings that are
    // actually on the page. Headings written into this template mostly carry
    // their own id (used by aria-labelledby); the rest get a slug derived
    // from their text, de-duplicated, so every entry has a real target.
    document.addEventListener('astro:page-load', () => {
      const nav = document.getElementById('prodToc');
      const list = nav?.querySelector('.prod-toc-list');
      const info = document.querySelector('.prod-info');
      if (!nav || !list || !info) return;

      list.textContent = '';

      const slug = (text) => text.toLowerCase().trim()
        .replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || 'section';
      const used = new Set(
        Array.from(document.querySelectorAll('[id]')).map((el) => el.id),
      );

      // Every section heading on the page, in document order. Deliberately
      // not scoped to .prod-info and not filtered to headings after the nav:
      // the specification table and product details sit ABOVE this block, and
      // the process, comparison, trust, related-product, resource and FAQ
      // sections sit outside .prod-info entirely. A buyer wants all of them.
      // Only the sitewide chrome is excluded.
      const headings = Array.from(document.querySelectorAll('h2')).filter(
        (h) => !h.closest('.site-header, .site-footer, .prod-toc'),
      );

      for (const h of headings) {
        const label = (h.textContent || '').replace(/\s+/g, ' ').trim();
        if (!label) continue;
        if (!h.id) {
          let candidate = slug(label);
          let n = 2;
          while (used.has(candidate)) candidate = `${slug(label)}-${n++}`;
          h.id = candidate;
        }
        used.add(h.id);
        h.classList.add('prod-section-anchor');

        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = label;
        li.appendChild(a);
        list.appendChild(li);
      }

      // Two or fewer sections is not worth a navigation block.
      nav.hidden = list.children.length < 3;
    });
  </script>

