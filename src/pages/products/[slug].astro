    /* Grid rows stretch every card in the row to equal height by default;
       the flex column + margin-top:auto on the CTA below then pins every
       card's button to the same baseline regardless of copy length. */
    .apps-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.1rem; align-items: stretch; }
    .app-card {
      position: relative; display: flex; flex-direction: column;
      background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
      transition: border-color .3s var(--ease-premium), transform .3s var(--ease-premium), box-shadow .3s var(--ease-premium);
    }
    .app-card:hover { border-color: var(--accent-gold); transform: translateY(-2px); box-shadow: var(--surface-shadow-hover); }
    .app-card-img {
      position: relative; aspect-ratio: 4 / 3; overflow: hidden;
      background: linear-gradient(135deg, #1a1e24, #23282f);
      border-bottom: 1px solid var(--line);
      display: flex; align-items: center; justify-content: center;
