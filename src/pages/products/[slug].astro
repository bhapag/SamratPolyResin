    .prod-img:hover { box-shadow: 0 1px 0 rgba(255, 255, 255, .08) inset, 0 22px 48px rgba(0, 0, 0, .46); }
    .marble-image-note { margin: 0.75rem 0 0; color: var(--ink-faint); font-size: 0.78rem; line-height: 1.5; }
    .marble-image-note a { color: var(--accent-gold-light); text-decoration: underline; text-underline-offset: 0.16em; }
    .fiberglass-epoxy-route { display: flex; flex-wrap: wrap; gap: 0.55rem 0.7rem; margin-top: 1rem; }
    .fiberglass-epoxy-route a { color: var(--accent-gold-light); border-bottom: 1px solid var(--line-2); font-size: 0.8rem; line-height: 1.45; padding-bottom: 0.12rem; }
