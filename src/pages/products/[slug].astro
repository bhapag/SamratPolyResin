    .app-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s var(--ease-premium); }
    .app-card:hover .app-card-img img { transform: scale(1.04); }
    .app-card-img-fallback { font-family: var(--font-display); font-weight: 700; font-size: 1.8rem; color: var(--line-2); }
    .app-card-body { display: flex; flex-direction: column; gap: 0.55rem; padding: 1.2rem 1.3rem; flex: 1; }
