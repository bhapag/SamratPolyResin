    }
    .crumb a:hover { color: var(--accent-gold-light); }
    .crumb .cur { color: var(--ink-dim); }

    .prod { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(1.5rem, 5vw, 3.5rem); padding-block: 2.2rem 3rem; }
    .prod-media-sticky { position: sticky; top: 90px; }
    .prod-img {
      position: relative; aspect-ratio: 1 / 1; border: 1px solid var(--image-frame-border); border-radius: 14px;
      background: linear-gradient(135deg, #1a1e24, #23282f);
      display: grid; place-items: center; overflow: hidden;
      box-shadow: var(--image-frame-shadow);
      transition: box-shadow .4s var(--ease-premium);
    }
    .prod-img:hover { box-shadow: 0 1px 0 rgba(255, 255, 255, .08) inset, 0 22px 48px rgba(0, 0, 0, .46); }
    /* contain, not cover — these are complete marketing posters (text, logo,
       spec tables baked into the artwork), not cropped-to-fill photography;
       the whole poster must stay visible, so no zoom-on-hover here either.
       position:absolute + inset:0 (not width/height:100%) because percentage
       heights don't reliably resolve against an aspect-ratio-derived height
       inside a `place-items:center` grid in every browser — absolute
       positioning against the relative parent sizes unambiguously instead. */
    .prod-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .14s ease; }
    .prod-img img.fading { opacity: 0; }
    .img-fallback { display: none; position: absolute; font-family: var(--font-display); font-weight: 700; font-size: 3.5rem; color: var(--line-2); }
    .prod-img.noimg .img-fallback { display: block; }

    .prod-thumbs { display: flex; gap: 0.7rem; margin-top: 0.9rem; flex-wrap: wrap; }
    .prod-thumb {
      position: relative;
      padding: 0; border: 1px solid var(--line); background: var(--bg-3); cursor: pointer;
      width: 76px; aspect-ratio: 1 / 1; overflow: hidden; transition: border-color .3s var(--ease-premium), transform .3s var(--ease-premium);
