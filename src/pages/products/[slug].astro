---
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { products } from '../../data/products.js';
import { applications as applicationGuides } from '../../data/applications.js';
import { resources } from '../../data/resources.js';
import { site, buildProductQuoteLink, buildCanonicalUrl } from '../../data/site.js';
import factoryGate from '../../assets/about/factory-gate.jpg';
import qcLaboratory from '../../assets/quality/qc-laboratory.jpg';

export function getStaticPaths() {
  return products.map(p => ({ params: { slug: p.slug }, props: { product: p } }));
}

const productImageModules = import.meta.glob('/src/assets/products/*', { eager: true });
const resolveProductImage = (filename) => productImageModules[`/src/assets/products/${filename}`]?.default;

const appImageModules = import.meta.glob('/src/assets/applications/*', { eager: true });
const resolveAppImage = (filename) => appImageModules[`/src/assets/applications/${filename}`]?.default;

const { product } = Astro.props;
const { name, image, description, features, applications, category, specs } = product;
const { tagline, usageNote, industries, whyChoose, faqs, tdsUrl } = product;
const isGpClearResin = product.slug === 'gp-clear-resin';
const isLaminationResin = product.slug === 'lamination-resin';
const isGpGelcoatResin = product.slug === 'gp-gelcoat-resin';
const isGpYellowResin = product.slug === 'gp-yellow-resin';
const isButtonGradeResin = product.slug === 'button-grade-resin';

const gpClearSeo = {
  title: 'GP Clear Resin Manufacturer in India | General Purpose Polyester Resin',
  keywords: [
    'GP Resin',
    'GP Clear Resin',
    'GP Resin manufacturer',
    'GP Resin manufacturer in India',
    'GP Resin supplier',
    'General Purpose Polyester Resin',
    'General Purpose Resin for FRP',
  ],
};
const laminationSeo = {
  title: 'Lamination Resin Manufacturer in India | LR Resin',
  description: 'Lamination Resin (LR Resin) manufacturer in India for door, plywood and FRP lamination. Transparent orthophthalic polyester resin with published TDS, 35 kg PET or 225 kg drum packaging.',
  keywords: [
    'Lamination Resin',
    'LR Resin',
    'Lamination Resin manufacturer',
    'Lamination Resin manufacturer in India',
    'LR Resin supplier',
    'Polyester Lamination Resin',
    'Resin for FRP lamination',
    'Resin for hand lay-up',
    'Resin for FRP fabrication',
  ],
};
const gelcoatSeo = {
  title: 'Gelcoat Resin Manufacturer in India | GP Gelcoat Resin',
  description: 'GP Gelcoat Resin manufacturer in India for FRP moulded products and surface finish applications. White, high-gloss polyester gelcoat with published TDS, 50 kg or 225 kg packaging.',
  keywords: [
    'Gelcoat Resin',
    'GP Gelcoat Resin',
    'Gelcoat Resin manufacturer',
    'Gelcoat Resin manufacturer in India',
    'Gelcoat Resin supplier',
    'Polyester Gelcoat Resin',
    'Resin for FRP surface finish',
    'Resin for moulded FRP products',
    'Gelcoat for FRP products',
  ],
};
const gpYellowSeo = {
  title: 'GP Yellow Resin Manufacturer in India | Yellow GP Resin',
  description: 'GP Yellow Resin manufacturer in India for general FRP lamination, roofing sheets, water tanks, doors and moulded products. Transparent yellow orthophthalic polyester resin with published TDS and 225 kg drum packaging.',
  keywords: [
    'GP Yellow Resin',
    'Yellow GP Resin',
    'GP Resin',
    'GP Resin manufacturer',
    'GP Resin manufacturer in India',
    'GP Resin supplier',
    'General Purpose Polyester Resin',
    'Resin for FRP lamination',
    'Polyester resin for FRP products',
  ],
};
const buttonGradeSeo = {
  title: 'Button Grade Resin Manufacturer in India | Polyester Button Resin',
  description: 'Button Grade Resin manufacturer in India for polyester button and small-mould casting. Transparent unsaturated polyester casting resin with published TDS and 225 kg drum packaging.',
  keywords: [
    'Button Grade Resin',
    'Button Resin',
    'Resin for Button Manufacturing',
    'Polyester Resin for Buttons',
    'Button Grade Polyester Resin',
    'Resin for Polyester Buttons',
    'Button Resin Manufacturer',
    'Button Grade Resin Manufacturer in India',
    'Button Grade Resin Supplier',
    'Unsaturated Polyester Resin for Buttons',
  ],
};
const gpBuyerFaqs = [
  {
    q: 'How does GP Clear Resin differ from GP Yellow Resin?',
    a: 'Both are general-purpose orthophthalic polyester resins for FRP work. GP Clear Resin is clear, with a 350–450 cPs viscosity and gel time under 8 minutes. <a href="/products/gp-yellow-resin/">GP Yellow Resin</a> is transparent yellow, thicker and slower-gelling. Where a colourless resin matters in the finished process, GP Clear Resin is the relevant grade to discuss.',
  },
  {
    q: 'Which details should I share when requesting a GP Clear Resin quote?',
    a: 'Please share the expected quantity, application or manufacturing process, any grade requirement, and delivery location. This helps the sales team understand the requirement before preparing a quote.',
  },
];
const laminationBuyerFaqs = [
  {
    q: 'Which details should I share when requesting a Lamination Resin quote?',
    a: 'Please share the lamination application, substrate or component, expected quantity, production method and delivery location. This helps the sales team understand the requirement before preparing a quote.',
  },
  {
    q: 'Is Lamination Resin suitable for every FRP fabrication requirement?',
    a: 'No. Lamination Resin is published for door lamination, plywood lamination, FRP bonding and clear-finish hand lay-up work. For a general FRP, chemical-resistance, surface-coating or epoxy requirement, review the relevant product data before selecting a resin system.',
  },
];
const gelcoatBuyerFaqs = [
  {
    q: 'Which details should I share when requesting a GP Gelcoat Resin quote?',
    a: 'Please share the moulded component, surface-finish requirement, application method, expected quantity, colour requirement if applicable, and delivery location. This helps the sales team understand the requirement before preparing a quote.',
  },
  {
    q: 'Is GP Gelcoat Resin the structural resin in an FRP part?',
    a: 'No. This product is published as a polyester surface-coating gelcoat for the mould-facing layer. The structural laminate is built separately with the appropriate laminating resin and glass-fibre reinforcement.',
  },
];
const gpYellowBuyerFaqs = [
  {
    q: 'Which details should I share when requesting a GP Yellow Resin quote?',
    a: 'Please share the expected quantity, FRP component or application, production method, whether the resin colour will be hidden in the finished build-up, and delivery location. This helps the sales team understand the requirement before preparing a quote.',
  },
  {
    q: 'When should I consider a different resin grade?',
    a: 'Review <a href="/products/gp-clear-resin/">GP Clear Resin</a> where a colourless resin is relevant, <a href="/products/sheet-grade-yellow-resin/">Sheet Grade Yellow Resin</a> for the published sheet-grade use, <a href="/products/lamination-resin/">Lamination Resin</a> for its published lamination-focused applications, <a href="/products/vinyl-ester-resin/">Vinyl Ester Resin</a> for a stated chemical- or corrosion-resistance requirement, and <a href="/products/gp-gelcoat-resin/">GP Gelcoat Resin</a> for a mould-surface coating role. Review the relevant product data before selecting a system.',
  },
];
const buttonBuyerFaqs = [
  {
    q: 'Which details should I share when requesting a Button Grade Resin quote?',
    a: 'Please share the expected quantity, whether the requirement is for buttons or another small decorative moulding, the clarity or pigment-colour requirement, the casting or moulding method if known, and delivery location. This helps the sales team understand the requirement before preparing a quote.',
  },
  {
    q: 'When should I consider a different resin grade for production?',
    a: 'Button Grade Resin is the published casting grade for buttons and small decorative mouldings. For reinforced FRP production, review <a href="/products/gp-clear-resin/">GP Clear Resin</a> or <a href="/products/unsaturated-polyester-resin/">Unsaturated Polyester Resin</a>; for pre-pigmented FRP sheet and panel production, review <a href="/products/sheet-grade-yellow-resin/">Sheet Grade Yellow Resin</a>. Where a two-part epoxy system is specified, review <a href="/products/epoxy-clear-casting-resin/">Clear Casting Resin</a> and its separate technical data.',
  },
];
const displayedFaqs = isGpClearResin
  ? [...(faqs ?? []), ...gpBuyerFaqs]
  : isLaminationResin
    ? [...(faqs ?? []), ...laminationBuyerFaqs]
    : isGpGelcoatResin
      ? [...(faqs ?? []), ...gelcoatBuyerFaqs]
      : isGpYellowResin
        ? [...(faqs ?? []), ...gpYellowBuyerFaqs]
        : isButtonGradeResin
          ? [...(faqs ?? []), ...buttonBuyerFaqs]
          : faqs;

// Two-table model (Product Details + Technical Specifications) when a product
// supplies the grouped fields; otherwise fall back to the legacy single table
// so the other products render exactly as before.
const detailEntries = product.productDetails ? Object.entries(product.productDetails) : null;
const techEntries = product.techSpecs ? Object.entries(product.techSpecs) : null;
const legacySpecEntries = !detailEntries && !techEntries && specs ? Object.entries(specs) : [];

const gallery = [image, ...(product.images ?? [])];

// Resolve each gallery photo to an optimised, compressed webp — one size for
// the large main viewer, one for the thumbnail strip. The thumbnail's
// `data-src` carries the main-size URL so the click-to-swap script (below)
// can assign it straight to the main <img>'s src.
const galleryImages = await Promise.all(
  gallery.map(async (filename) => {
    const mod = resolveProductImage(filename);
    if (!mod) return null;
    const [main, thumb] = await Promise.all([
      getImage({ src: mod, width: 700, format: 'webp' }),
      getImage({ src: mod, width: 160, format: 'webp' }),
    ]);
    return { main, thumb };
  })
);
const mainImage = galleryImages[0];

// Curated related products when the product names them explicitly (lets a page
// reference cross-category grades intentionally); otherwise auto-fill from the
// same category. filter(Boolean) drops any slug that no longer resolves.
const related = product.relatedSlugs?.length
  ? product.relatedSlugs.map(s => products.find(p => p.slug === s)).filter(Boolean)
  : products.filter(p => p.category === category && p.slug !== product.slug).slice(0, 3);
const relatedHeading = product.relatedSlugs?.length ? 'Related products' : `More in ${category}`;

// Curated reading for GP Clear Resin buyers. These point only to existing,
// published resources and are intentionally limited to this product page.
const gpResourceSlugs = [
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'what-is-gel-coat-resin',
];
const gpResources = isGpClearResin
  ? gpResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const gpClusterResourceSlugs = [
  'gp-clear-resin-vs-gp-yellow-resin',
  'gp-resin-vs-lamination-resin',
  'gp-resin-vs-vinyl-ester-resin',
  'gp-resin-vs-gelcoat-resin',
  'why-gp-resin-turns-yellow',
  'why-polyester-resin-remains-sticky-or-tacky',
  'how-to-reduce-shrinkage-in-gp-resin-applications',
  'gp-resin-viscosity-explained',
];
const gpClusterResources = isGpClearResin
  ? gpClusterResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const laminationResourceSlugs = [
  'what-is-lamination-resin',
  'applications-of-lamination-resin',
  'lamination-resin-for-hand-lay-up',
  'gp-resin-vs-lamination-resin',
  'lamination-resin-vs-vinyl-ester-resin',
  'lamination-resin-vs-gelcoat-resin',
  'common-lamination-defects-in-frp',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
];
const laminationResources = isLaminationResin
  ? laminationResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const gelcoatResourceSlugs = [
  'what-is-gel-coat-resin',
  'gp-resin-vs-gelcoat-resin',
  'lamination-resin-vs-gelcoat-resin',
  'gelcoat-resin-vs-vinyl-ester-resin',
  'gelcoat-resin-vs-epoxy-resin',
  'applications-of-gelcoat-resin-in-frp-manufacturing',
  'how-to-choose-gelcoat-resin-for-frp-products',
  'gelcoat-resin-problems-peeling-cracking-tackiness',
  'gelcoat-resin-storage-and-handling-guide',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'why-polyester-resin-remains-sticky-or-tacky',
  'how-to-store-unsaturated-polyester-resin',
];
const gelcoatResources = isGpGelcoatResin
  ? gelcoatResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const gpYellowResourceSlugs = [
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'gp-yellow-resin-uses-in-frp-manufacturing',
  'gp-clear-resin-vs-gp-yellow-resin',
  'gp-resin-vs-lamination-resin',
  'gp-resin-vs-vinyl-ester-resin',
  'gp-resin-vs-gelcoat-resin',
  'why-gp-resin-turns-yellow',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
];
const gpYellowResources = isGpYellowResin
  ? gpYellowResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const buttonResourceSlugs = [
  'what-is-button-grade-resin',
  'button-resin-for-polyester-button-manufacturing',
  'how-to-choose-resin-for-button-manufacturing',
  'button-grade-resin-vs-gp-resin',
  'button-grade-resin-vs-clear-casting-resin',
  'button-resin-gel-time-and-viscosity-guide',
  'button-resin-storage-and-quote-guide',
  'button-resin-processing-checklist',
];
const buttonResources = isButtonGradeResin
  ? buttonResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const waLink = buildProductQuoteLink(product.whatsappName ?? name);

// "Explore applications" cards — only populated when a product names
// applicationSlugs (currently gp-clear-resin only). Cards for draft entries
// still render (so all named applications appear) but link back to this
// product page instead of a dead /applications/ URL, since their dedicated
// page isn't built yet — never a dead-end "coming soon" state.
const appCards = await Promise.all(
  (product.applicationSlugs ?? []).map(async (s) => {
    const app = applicationGuides.find(a => a.slug === s);
    if (!app) return null;
    let cardImg = null;
    if (app.cardImage) {
      const mod = resolveAppImage(app.cardImage);
      if (mod) cardImg = await getImage({ src: mod, width: 480, format: 'webp' });
    }
    const relatedProducts = (app.relatedProductSlugs ?? [])
      .map(rs => products.find(p => p.slug === rs))
      .filter(Boolean);
    const href = app.draft ? `/products/${product.slug}/` : `/applications/${app.slug}/`;
    return { ...app, cardImg, relatedProducts, href };
  })
).then(list => list.filter(Boolean));

// BreadcrumbList — mirrors the visible breadcrumb below exactly, no extra data.
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: buildCanonicalUrl('/') },
    { "@type": "ListItem", position: 2, name: "Products", item: buildCanonicalUrl('/products/') },
    { "@type": "ListItem", position: 3, name, item: buildCanonicalUrl(Astro.url.pathname) },
  ],
};

// Product schema — deliberately omits `offers`/price. Pricing here is
// "Price on Request" (varies by quantity and current raw-material rates),
// and Schema.org Offers without a real price fail Google's structured-data
// validation — better to omit it than publish a placeholder number.
// Surface the spec sheet to search engines as PropertyValues so the Product
// entity carries its real technical attributes (resin type, viscosity, gel
// time, etc.), not just a name + description. Works for grouped or legacy specs.
const schemaSpecEntries = [
  ...(techEntries ?? []),
  ...(detailEntries ?? []),
  ...(legacySpecEntries ?? []),
];
const additionalProperty = schemaSpecEntries.map(([propertyName, value]) => ({
  "@type": "PropertyValue",
  name: propertyName,
  value: String(value),
}));
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  description,
  category,
  sku: product.slug,
  url: buildCanonicalUrl(Astro.url.pathname),
  image: mainImage ? buildCanonicalUrl(mainImage.main.src) : undefined,
  brand: { "@type": "Organization", name: site.name },
  manufacturer: { "@type": "Organization", name: site.name },
  ...(additionalProperty.length ? { additionalProperty } : {}),
};

// FAQPage schema — same shape used by the resource articles. Only emitted when
// the product actually supplies FAQs, so no empty schema on other pages.
const faqJsonLd = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<Base
  title={isGpClearResin ? gpClearSeo.title : isLaminationResin ? laminationSeo.title : isGpGelcoatResin ? gelcoatSeo.title : isGpYellowResin ? gpYellowSeo.title : isButtonGradeResin ? buttonGradeSeo.title : (product.seo?.title ?? name)}
  description={isLaminationResin ? laminationSeo.description : isGpGelcoatResin ? gelcoatSeo.description : isGpYellowResin ? gpYellowSeo.description : isButtonGradeResin ? buttonGradeSeo.description : (product.seo?.description ?? `${name} — ${product.tagline} Manufactured by ${site.name}.`)}
  keywords={isGpClearResin ? gpClearSeo.keywords : isLaminationResin ? laminationSeo.keywords : isGpGelcoatResin ? gelcoatSeo.keywords : isGpYellowResin ? gpYellowSeo.keywords : isButtonGradeResin ? buttonGradeSeo.keywords : product.seo?.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><span class="cur">{name}</span>
  </div>

  <article class="wrap prod">
    <div class="prod-media">
      <div class="prod-media-sticky">
        <div class:list={['prod-img', { noimg: !mainImage }]}>
          {mainImage && (
            <img src={mainImage.main.src} width={mainImage.main.attributes.width} height={mainImage.main.attributes.height}
                 alt={product.imageAlt ?? name} id="prodMainImg"
                 transition:name={`product-photo-${product.slug}`} />
          )}
          <span class="img-fallback" aria-hidden="true">{name.split(' ').map(w=>w[0]).join('').slice(0,3)}</span>
        </div>
        {gallery.length > 1 && (
          <div class="prod-thumbs" role="list">
            {galleryImages.map((g, i) => g && (
              <button type="button" class:list={['prod-thumb', { active: i === 0 }]} data-src={g.main.src} aria-label={`Show photo ${i + 1} of ${name}`}>
                <img src={g.thumb.src} width={g.thumb.attributes.width} height={g.thumb.attributes.height} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="prod-info">
      <span class="prod-cat">{category}</span>
      <h1 class="prod-name" transition:name={`product-name-${product.slug}`}>{name}</h1>
      {tagline && <p class="prod-subtitle">{tagline}</p>}
      {isGpClearResin && (
        <p class="gp-buyer-intro">
          Samrat Poly Resins supplies this clear general-purpose polyester resin to FRP manufacturers in India for hand lay-up, spray-up, moulding and general lamination work.
        </p>
      )}
      {isLaminationResin && (
        <p class="lamination-buyer-intro">
          Samrat Poly Resins supplies Lamination Resin, also known as LR Resin, to Indian B2B buyers for door-skin, plywood, decorative-panel and FRP bonding work, including the published clear-finish hand lay-up context.
        </p>
      )}
      {isGpGelcoatResin && (
        <p class="gelcoat-buyer-intro">
          Samrat Poly Resins supplies GP Gelcoat Resin to Indian B2B FRP buyers for the visible, mould-facing surface of finished FRP products where a white, high-gloss polyester gelcoat is required.
        </p>
      )}
      {isGpYellowResin && (
        <p class="gp-yellow-buyer-intro">
          Samrat Poly Resins supplies GP Yellow Resin to Indian B2B FRP buyers for general-purpose polyester lamination and moulded-product work where an intentionally transparent-yellow supplied grade is acceptable in the process or finished build-up.
        </p>
      )}
      {isButtonGradeResin && (
        <p class="button-buyer-intro">
          Samrat Poly Resins supplies Button Grade Resin, also known as Button Resin, to Indian button and small-moulding manufacturers looking for a transparent unsaturated polyester casting grade for visible finished parts.
        </p>
      )}
      <div class="prod-quote">
        <p class="prod-quote-heading">Price</p>
        <p class="prod-quote-value">{site.priceLabel}</p>
        <p class="prod-quote-note">Industrial resin pricing varies based on:</p>
        <ul class="prod-quote-list">
          <li>Order Quantity</li>
          <li>Resin Grade</li>
          <li>Current Raw Material Rates</li>
        </ul>
        <a href={waLink} class="btn btn-solid prod-quote-cta" target="_blank" rel="noopener">Request Bulk Quote</a>
      </div>

      {tdsUrl && (
        <div class="prod-cta">
          <a
            href={tdsUrl}
            class="btn btn-solid"
            target="_blank"
            rel="noopener"
            download
            aria-label={`Download Technical Data Sheet PDF for ${name}`}
          >
            Download Technical Data Sheet (PDF)
          </a>
        </div>
      )}

      <div class="prod-cta">
        <a href="#enquire" class="btn btn-solid">Enquire / get quote</a>
        <a href={waLink} class="btn btn-wa" target="_blank" rel="noopener">WhatsApp</a>
      </div>

      <div class="prod-catalogue-note">
        <p class="prod-catalogue-heading">Need our complete product range?</p>
        <a
          href={site.catalogue.url}
          class="prod-catalogue-link"
          target="_blank"
          rel="noopener"
          download
          aria-label={`Download ${site.catalogue.title} (PDF)`}
        >
          📘 Download Product Catalogue (PDF)
        </a>
        <p class="prod-catalogue-desc">{site.catalogue.description}</p>
      </div>

      {detailEntries && (
        <div class="specs-table-wrap">
          <h2 class="spec-h">Product details</h2>
          <table class="specs-table">
            <tbody>
              {detailEntries.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {techEntries && (
        <div class="specs-table-wrap">
          <h2 class="spec-h">Technical specifications</h2>
          <table class="specs-table">
            <tbody>
              {techEntries.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {legacySpecEntries.length > 0 && (
        <div class="specs-table-wrap">
          <h2 class="spec-h">Product details</h2>
          <table class="specs-table">
            <tbody>
              {legacySpecEntries.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <p class="prod-desc">{description}</p>
      {usageNote && <p class="prod-desc prod-usage" set:html={usageNote} />}

      {isGpClearResin && (
        <section class="gp-overview" aria-labelledby="gp-overview-heading">
          <h2 id="gp-overview-heading" class="spec-h">What is GP Clear Resin?</h2>
          <p>
            GP Clear Resin is Samrat Poly Resins’ clear, orthophthalic general-purpose polyester resin for fabricators producing FRP components. It is a liquid resin grade intended to wet out glass-fibre reinforcement in routine composite manufacturing.
          </p>
          <p>
            It is relevant where a buyer needs a clear GP grade for common hand lay-up, spray-up, moulding and general FRP lamination processes. Where resin colour is relevant, compare it with GP Yellow Resin; the clear resin itself does not define the final appearance of a reinforced, pigmented or surface-finished FRP part.
          </p>
        </section>
