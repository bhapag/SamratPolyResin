];
const mekpResources = isMekpHardener
  ? mekpResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const epoxyCastingResourceSlugs = [
  'what-is-epoxy-clear-casting-resin',
  'casting-resin-vs-coating-resin',
  'unsaturated-polyester-resin-vs-epoxy-resin',
  'epoxy-clear-casting-resin-buyer-guide',
];
const epoxyCastingResources = isEpoxyClearCastingResin
  ? epoxyCastingResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];
const epoxyArtResourceSlugs = [
  'what-is-epoxy-art-resin',
  'applications-of-epoxy-art-resin',
  'casting-resin-vs-coating-resin',
  'epoxy-art-resin-vs-polyester-resin',
  'epoxy-art-resin-finish-questions',
  'epoxy-art-resin-storage-and-procurement-guide',
  'epoxy-art-resin-buyer-guide',
];
const epoxyArtResources = isEpoxyArtResin
  ? epoxyArtResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];
const uvResinResourceSlugs = [
  'what-is-uv-resin',
  'applications-of-uv-resin',
  'uv-resin-vs-epoxy-art-resin',
  'uv-resin-vs-epoxy-clear-casting-resin',
  'uv-resin-vs-polyester-resin',
  'uv-resin-buyer-guide',
];
const uvResinResources = isUvResin
  ? uvResinResourceSlugs.map((slug) => resources.find((resource) => resource.slug === slug && !resource.draft)).filter(Boolean)
  : [];

const waLink = buildProductQuoteLink(product.whatsappName ?? name);

// "Explore applications" cards — only populated when a product names
// applicationSlugs (currently gp-clear-resin only). Cards for draft entries
// still render (so all named applications appear) but link back to this
// product page instead of a dead /applications/ URL, since their dedicated
// page isn't built yet — never a dead-end "coming soon" state.
const appCards = await Promise.all(
  (product.applicationSlugs ?? []).map(async (s) => {
    const app = applicationGuides.find(a => a.slug === s);
    if (!app) return null;
    let cardImg = null;
    if (app.cardImage) {
      const mod = resolveAppImage(app.cardImage);
      if (mod) cardImg = await getImage({ src: mod, width: 480, format: 'webp' });
    }
    const relatedProducts = (app.relatedProductSlugs ?? [])
      .map(rs => products.find(p => p.slug === rs))
      .filter(Boolean);
    const href = app.draft ? `/products/${product.slug}/` : `/applications/${app.slug}/`;
    return { ...app, cardImg, relatedProducts, href };
  })
).then(list => list.filter(Boolean));

// BreadcrumbList — mirrors the visible breadcrumb below exactly, no extra data.
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: buildCanonicalUrl('/') },
    { "@type": "ListItem", position: 2, name: "Products", item: buildCanonicalUrl('/products/') },
    { "@type": "ListItem", position: 3, name, item: buildCanonicalUrl(Astro.url.pathname) },
  ],
};

// Product schema — deliberately omits `offers`/price. Pricing here is
// "Price on Request" (varies by quantity and current raw-material rates),
// and Schema.org Offers without a real price fail Google's structured-data
// validation — better to omit it than publish a placeholder number.
// Surface the spec sheet to search engines as PropertyValues so the Product
// entity carries its real technical attributes (resin type, viscosity, gel
// time, etc.), not just a name + description. Works for grouped or legacy specs.
const schemaSpecEntries = [
  ...(techEntries ?? []),
  ...(detailEntries ?? []),
  ...(legacySpecEntries ?? []),
];
const additionalProperty = schemaSpecEntries.map(([propertyName, value]) => ({
  "@type": "PropertyValue",
  name: propertyName,
  value: String(value),
}));
const productJsonLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name,
  description,
  category,
  sku: product.slug,
  url: buildCanonicalUrl(Astro.url.pathname),
  image: mainImage ? buildCanonicalUrl(mainImage.main.src) : undefined,
  brand: { "@type": "Organization", name: site.name },
  ...(!isGlassFiber ? { manufacturer: { "@type": "Organization", name: site.name } } : {}),
  ...(additionalProperty.length ? { additionalProperty } : {}),
};

// FAQPage schema — same shape used by the resource articles. Only emitted when
// the product actually supplies FAQs, so no empty schema on other pages.
const faqJsonLd = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<Base
  title={isGpClearResin ? gpClearSeo.title : isGpWhiteResin ? gpWhiteSeo.title : isLaminationResin ? laminationSeo.title : isGpGelcoatResin ? gelcoatSeo.title : isGpYellowResin ? gpYellowSeo.title : isButtonGradeResin ? buttonGradeSeo.title : isUnsaturatedPolyesterResin ? unsaturatedPolyesterSeo.title : isGlassFiber ? glassFiberSeo.title : isFrpPolyesterPigment ? frpPolyesterPigmentSeo.title : isMekpHardener ? mekpHardenerSeo.title : isEpoxyArtResin ? epoxyArtSeo.title : isUvResin ? uvResinSeo.title : isEpoxyClearCastingResin ? epoxyClearCastingSeo.title : (product.seo?.title ?? name)}
  description={isLaminationResin ? laminationSeo.description : isGpGelcoatResin ? gelcoatSeo.description : isGpYellowResin ? gpYellowSeo.description : isButtonGradeResin ? buttonGradeSeo.description : isUnsaturatedPolyesterResin ? unsaturatedPolyesterSeo.description : isGlassFiber ? glassFiberSeo.description : isFrpPolyesterPigment ? frpPolyesterPigmentSeo.description : isMekpHardener ? mekpHardenerSeo.description : isEpoxyArtResin ? epoxyArtSeo.description : isUvResin ? uvResinSeo.description : isEpoxyClearCastingResin ? epoxyClearCastingSeo.description : (product.seo?.description ?? `${name} — ${product.tagline} Manufactured by ${site.name}.`)}
  keywords={isGpClearResin ? gpClearSeo.keywords : isGpWhiteResin ? gpWhiteSeo.keywords : isLaminationResin ? laminationSeo.keywords : isGpGelcoatResin ? gelcoatSeo.keywords : isGpYellowResin ? gpYellowSeo.keywords : isButtonGradeResin ? buttonGradeSeo.keywords : isUnsaturatedPolyesterResin ? unsaturatedPolyesterSeo.keywords : isGlassFiber ? glassFiberSeo.keywords : isFrpPolyesterPigment ? frpPolyesterPigmentSeo.keywords : isMekpHardener ? mekpHardenerSeo.keywords : isEpoxyArtResin ? epoxyArtSeo.keywords : isUvResin ? uvResinSeo.keywords : isEpoxyClearCastingResin ? epoxyClearCastingSeo.keywords : product.seo?.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><a href="/products/">Products</a><span>/</span><span class="cur">{name}</span>
  </div>

  <article class="wrap prod">
    <div class="prod-media">
      <div class="prod-media-sticky">
        <div class:list={['prod-img', { noimg: !mainImage }]}>
          {mainImage && (
            <img src={mainImage.main.src} width={mainImage.main.attributes.width} height={mainImage.main.attributes.height}
                 alt={product.imageAlt ?? name} id="prodMainImg"
                 transition:name={`product-photo-${product.slug}`} />
          )}
          <span class="img-fallback" aria-hidden="true">{name.split(' ').map(w=>w[0]).join('').slice(0,3)}</span>
        </div>
        {gallery.length > 1 && (
          <div class="prod-thumbs" role="list">
            {galleryImages.map((g, i) => g && (
              <button type="button" class:list={['prod-thumb', { active: i === 0 }]} data-src={g.main.src} aria-label={`Show photo ${i + 1} of ${name}`}>
                <img src={g.thumb.src} width={g.thumb.attributes.width} height={g.thumb.attributes.height} alt="" loading="lazy" />
              </button>
            ))}
          </div>
        )}
      </div>
    </div>

    <div class="prod-info">
      <span class="prod-cat">{category}</span>
      <h1 class="prod-name" transition:name={`product-name-${product.slug}`}>{name}</h1>
      {tagline && <p class="prod-subtitle">{tagline}</p>}
      {isGpClearResin && (
        <p class="gp-buyer-intro">
          Samrat Poly Resins supplies this clear general-purpose polyester resin to FRP manufacturers in India for hand lay-up, spray-up, moulding and general lamination work.
        </p>
      )}
      {isGpWhiteResin && (
        <p class="gp-white-buyer-intro">
          Samrat Poly Resins supplies GP White Resin to Indian FRP manufacturers seeking a water-white general-purpose polyester resin for panels, moulding, hand layup, spray-up, cooling towers and water tanks.
        </p>
      )}
      {isGpQuartzResin && (
        <p class="gp-quartz-buyer-intro">
          Samrat Poly Resins supplies GP Quartz Resin to Indian B2B buyers evaluating polyester resin for artificial quartz stone, engineered stone slabs and composite mineral surfaces. Start with the intended stone product, filler or mineral type, production process and finish requirement.
        </p>
      )}
      {isLaminationResin && (
        <p class="lamination-buyer-intro">
          Samrat Poly Resins supplies Lamination Resin, also known as LR Resin, to Indian B2B buyers for door-skin, plywood, decorative-panel and FRP bonding work, including the published clear-finish hand lay-up context.
        </p>
      )}
      {isGpGelcoatResin && (
        <p class="gelcoat-buyer-intro">
          Samrat Poly Resins supplies GP Gelcoat Resin to Indian B2B FRP buyers for the visible, mould-facing surface of finished FRP products where a white, high-gloss polyester gelcoat is required.
        </p>
      )}
      {isGpYellowResin && (
        <p class="gp-yellow-buyer-intro">
          Samrat Poly Resins supplies GP Yellow Resin to Indian B2B FRP buyers for general-purpose polyester lamination and moulded-product work where an intentionally transparent-yellow supplied grade is acceptable in the process or finished build-up.
        </p>
      )}
      {isButtonGradeResin && (
        <p class="button-buyer-intro">
          Samrat Poly Resins supplies Button Grade Resin, also known as Button Resin, to Indian button and small-moulding manufacturers looking for a transparent unsaturated polyester casting grade for visible finished parts.
        </p>
      )}
      {isUnsaturatedPolyesterResin && (
        <p class="upr-buyer-intro">
          Samrat Poly Resins supplies Unsaturated Polyester Resin (UPR) to Indian B2B buyers as a category gateway for FRP and composite manufacturing. Start with the required product role, then review the specific grade data before selecting a resin.
        </p>
      )}
      {isGlassFiber && (
        <p class="glass-fiber-buyer-intro">
          Samrat Poly Resins supplies E-glass chopped strand mat (CSM) to Indian FRP buyers seeking reinforcement material in CSM 300 or CSM 450. This page helps separate the reinforcement decision from the separate resin and surface-finish decisions.
        </p>
      )}
      {isFrpPolyesterPigment && (
        <p class="pigment-buyer-intro">
          Samrat Poly Resins supplies FRP Polyester Pigment to industrial buyers who need a colour paste for an FRP resin or gelcoat system. Start with the required colour, visible-finish requirement and base system, then review the published pigment data before requesting a quotation.
        </p>
      )}
      {isMekpHardener && (
        <p class="mekp-buyer-intro">
          Samrat Poly Resins supplies MEKP Hardener to industrial buyers evaluating a catalyst / initiator for a published polyester, vinyl ester or gelcoat system. Begin with the actual resin grade and FRP application, then review the current TDS before requesting a quotation or technical discussion.
        </p>
      )}
      {isUvResin && (
        <p class="epoxy-art-buyer-intro">
          Samrat Poly Resins supplies UV Resin, also called UV Curing Resin or UV Clear Resin, to buyers seeking a published UV/LED-curable epoxy-acrylate route for jewellery, encapsulation, doming and speciality coating requirements.
        </p>
      )}
      <div class="prod-quote">
        <p class="prod-quote-heading">Price</p>
        <p class="prod-quote-value">{site.priceLabel}</p>
        <p class="prod-quote-note">{isGlassFiber ? 'Glass Fiber pricing varies based on:' : isFrpPolyesterPigment ? 'Pigment pricing varies based on:' : isMekpHardener ? 'MEKP Hardener pricing varies based on:' : isEpoxyArtResin ? 'Art-resin pricing varies based on:' : isUvResin ? 'UV Resin pricing varies based on:' : isEpoxyClearCastingResin ? 'Casting-resin pricing varies based on:' : 'Industrial resin pricing varies based on:'}</p>
        <ul class="prod-quote-list">
          <li>Order Quantity</li>
          <li>{isGlassFiber ? 'CSM 300 or CSM 450 requirement' : isFrpPolyesterPigment ? 'Required colour or RAL/Pantone reference' : isMekpHardener ? 'Base resin grade and application' : isEpoxyArtResin ? 'Finished surface or artwork application' : isUvResin ? 'Application, industry and clear/finish requirement' : isEpoxyClearCastingResin ? 'Application, casting size and required finish' : 'Resin Grade'}</li>
          <li>{isGlassFiber || isFrpPolyesterPigment ? 'Delivery location' : isMekpHardener ? 'Production process and delivery location' : isEpoxyArtResin ? 'Required finish and delivery location' : isUvResin ? 'UV/LED equipment requirement and delivery location' : isEpoxyClearCastingResin ? 'Delivery location' : 'Current Raw Material Rates'}</li>
        </ul>
        <a href={waLink} class="btn btn-solid prod-quote-cta" target="_blank" rel="noopener">Request Bulk Quote</a>
      </div>

      {tdsUrl && (
        <div class="prod-cta">
          <a
            href={tdsUrl}
            class="btn btn-solid"
            target="_blank"
            rel="noopener"
            download
            aria-label={`Download Technical Data Sheet PDF for ${name}`}
          >
            Download Technical Data Sheet (PDF)
          </a>
        </div>
      )}

      <div class="prod-cta">
        <a href="#enquire" class="btn btn-solid">Enquire / get quote</a>
        <a href={waLink} class="btn btn-wa" target="_blank" rel="noopener">WhatsApp</a>
      </div>

      <div class="prod-catalogue-note">
        <p class="prod-catalogue-heading">Need our complete product range?</p>
        <a
          href={site.catalogue.url}
          class="prod-catalogue-link"
          target="_blank"
          rel="noopener"
          download
          aria-label={`Download ${site.catalogue.title} (PDF)`}
        >
          📘 Download Product Catalogue (PDF)
        </a>
        <p class="prod-catalogue-desc">{site.catalogue.description}</p>
      </div>

      {detailEntries && (
        <div class="specs-table-wrap">
          <h2 class="spec-h">Product details</h2>
          <table class="specs-table">
            <tbody>
              {detailEntries.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {techEntries && (
        <div class="specs-table-wrap">
          <h2 class="spec-h">Technical specifications</h2>
          <table class="specs-table">
            <tbody>
              {techEntries.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {legacySpecEntries.length > 0 && (
        <div class="specs-table-wrap">
          <h2 class="spec-h">Product details</h2>
          <table class="specs-table">
            <tbody>
              {legacySpecEntries.map(([k, v]) => (
                <tr><th>{k}</th><td>{v}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      <p class="prod-desc">{description}</p>
      {usageNote && <p class="prod-desc prod-usage" set:html={usageNote} />}

      {isGpClearResin && (
        <section class="gp-overview" aria-labelledby="gp-overview-heading">
          <h2 id="gp-overview-heading" class="spec-h">What is GP Clear Resin?</h2>
          <p>
            GP Clear Resin is Samrat Poly Resins’ clear, orthophthalic general-purpose polyester resin for fabricators producing FRP components. It is a liquid resin grade intended to wet out glass-fibre reinforcement in routine composite manufacturing.
          </p>
          <p>
            It is relevant where a buyer needs a clear GP grade for common hand lay-up, spray-up, moulding and general FRP lamination processes. Where resin colour is relevant, compare it with GP Yellow Resin; the clear resin itself does not define the final appearance of a reinforced, pigmented or surface-finished FRP part.
          </p>
        </section>
      )}

      {isGpWhiteResin && (
        <section class="gp-white-overview" aria-labelledby="gp-white-overview-heading">
          <h2 id="gp-white-overview-heading" class="spec-h">What is GP White Resin?</h2>
          <p>
            GP White Resin is Samrat Poly Resins' published water-white, general-purpose orthophthalic polyester resin for reinforced FRP manufacture. It is selected as a laminate resin for the published panel, moulding, hand layup, spray-up, cooling-tower and water-tank contexts.
          </p>
          <p>
            Buyers often use “white resin” as a search term. This product's published supplied appearance is water white; it is not a white mould-surface gelcoat and it does not by itself determine the final colour of a pigmented, reinforced or surface-finished FRP part. Review the required supplied appearance and product role before selection.
          </p>
        </section>
      )}
      {isGpQuartzResin && (
        <section class="gp-quartz-overview" aria-labelledby="gp-quartz-overview-heading">
          <h2 id="gp-quartz-overview-heading" class="spec-h">What is GP Quartz Resin?</h2>
          <p>
            GP Quartz Resin is Samrat Poly Resins&rsquo; published orthophthalic unsaturated polyester resin for artificial quartz stone, engineered stone slabs and composite mineral surfaces. It is a selection route for a quartz-filled or mineral-filled composite requirement, not simply another clear or white general-purpose FRP grade.
          </p>
          <p>
            The TDS publishes a clear-to-pale-yellow liquid appearance, 400&ndash;800 cPs viscosity, 7&ndash;10 minute gel time and non-accelerated system. These are grade-specific data points to review with the intended component, filler or mineral type, process and finish requirement; they are not a production approval for every stone formulation.
          </p>
        </section>
      )}

      {isLaminationResin && (
        <section class="lamination-overview" aria-labelledby="lamination-overview-heading">
          <h2 id="lamination-overview-heading" class="spec-h">What is Lamination Resin / LR Resin?</h2>
          <p>
            Lamination Resin, or LR Resin, is the published transparent orthophthalic unsaturated polyester grade for door lamination, plywood lamination and FRP bonding work. It is a liquid resin that cures at room temperature with the published MEKP and cobalt octoate system.
          </p>
          <p>
            For buyers, the selection starts with the component, substrate and working window. The published 400 cPs viscosity and 5-minute gel time should be checked against the actual lay-up, wet-out, air-removal and bonding sequence; they are not a stand-alone approval for every FRP process. General FRP, chemical-resistance and mould-surface requirements should be reviewed against the relevant product data.
          </p>
        </section>
      )}
      {isGpGelcoatResin && (
        <section class="gelcoat-overview" aria-labelledby="gelcoat-overview-heading">
          <h2 id="gelcoat-overview-heading" class="spec-h">What is Gelcoat Resin / GP Gelcoat Resin?</h2>
          <p>
            GP Gelcoat Resin is Samrat Poly Resins’ published white, high-gloss polyester surface-coating gelcoat for the mould-facing side of an FRP part. It is applied to the mould before the reinforced laminate is built behind it.
          </p>
          <p>
            For buyers, Gelcoat Resin is a mould-side surface-finish decision rather than a substitute for a laminating resin. Its published high viscosity, thixotropy and 8.5-minute gel time should be reviewed with the mould condition, application method, required appearance and the rest of the FRP build-up before selecting a product system.
          </p>
        </section>
      )}
      {isGpYellowResin && (
        <section class="gp-yellow-overview" aria-labelledby="gp-yellow-overview-heading">
          <h2 id="gp-yellow-overview-heading" class="spec-h">What is GP Yellow Resin?</h2>
          <p>
            GP Yellow Resin is Samrat Poly Resins’ published transparent-yellow, orthophthalic unsaturated polyester, general-purpose laminating resin. It is intended for use with glass-fibre reinforcement when building the structural laminate in FRP products.
          </p>
          <p>
            For buyers, the starting question is whether the supplied yellow colour suits the process and whether the reinforced laminate, pigment or surface layer determines the final appearance. It is not a mould-surface coating or a specialised grade for every requirement; review the published viscosity, gel time, packaging, MOQ and Technical Data Sheet against the actual production process.
          </p>
        </section>
      )}
      {isButtonGradeResin && (
        <section class="button-overview" aria-labelledby="button-overview-heading">
          <h2 id="button-overview-heading" class="spec-h">What is Button Grade Resin?</h2>
          <p>
            Button Grade Resin is Samrat Poly Resins' published transparent, semi-liquid unsaturated polyester casting grade for buttons and other small decorative mouldings. It is poured or cast into moulds, rather than selected as a glass-fibre reinforcement resin for a structural FRP laminate.
          </p>
          <p>
            For a button manufacturer, the relevant published product details are the clear casting role, fine polishable finish, pigment-compatible colour work, technical data and 225 kg drum packaging. Product selection should still be checked against the intended button design and production method.
          </p>
        </section>
      )}
      {isUnsaturatedPolyesterResin && (
        <section class="upr-overview" aria-labelledby="upr-overview-heading">
          <h2 id="upr-overview-heading" class="spec-h">What is Unsaturated Polyester Resin (UPR)?</h2>
          <p>
            Unsaturated Polyester Resin, commonly called UPR or polyester resin, is the broader resin category used in many FRP and composite applications. This page helps buyers start with that category, then move to the published Samrat product grade that matches the component, process and finished-product role.
          </p>
          <p>
            The technical specifications and TDS on this page describe Samrat Poly Resins&rsquo; standard clear orthophthalic UPR, supplied as <a href="/products/gp-clear-resin/">GP Clear Resin</a>. Specialist products below have their own published data, packaging and suitability information; the standard UPR table should not be treated as their specification.
          </p>
        </section>
      )}
      {isGlassFiber && (
        <section class="glass-fiber-overview" aria-labelledby="glass-fiber-overview-heading">
          <h2 id="glass-fiber-overview-heading" class="spec-h">What is Glass Fiber / Fiberglass Mat?</h2>
          <p>
            Glass Fiber is the reinforcement material in an FRP laminate, while resin is the liquid system that binds it into the finished composite. This published product is E-glass chopped strand mat (CSM): a non-woven mat of 50 mm chopped strands with polyester-compatible sizing. It is not a general-purpose resin, a gelcoat or a ready-made FRP part.
          </p>
          <p>
            The available CSM grades are identified by area weight: CSM 300 is 300 g/m² and CSM 450 is 450 g/m². Neither weight is a universal answer for every component. Use the part drawing, laminate design, reinforcement build-up, resin system and production method to discuss the appropriate requirement before purchase.
          </p>
        </section>
      )}
      {isFrpPolyesterPigment && (
        <section class="pigment-overview" aria-labelledby="pigment-overview-heading">
          <h2 id="pigment-overview-heading" class="spec-h">What is FRP Polyester Pigment / Polyester Pigment Paste?</h2>
          <p>
            FRP Polyester Pigment is a colour concentrate paste for an FRP resin or gelcoat system. It supplies colour to the selected base material; it is not the structural resin that binds reinforcement, the glass-fibre reinforcement itself or the mould-side gelcoat layer that creates the finished surface.
          </p>
          <p>
            The published product data lists compatibility with unsaturated polyester, vinyl ester and gelcoat systems. The catalogue lists white, black, red, blue, green and yellow, while the product TDS also supports standard and custom RAL or Pantone colour matching. Confirm the required colour and the actual base system before ordering.
          </p>
        </section>
      )}
      {isMekpHardener && (
        <section class="mekp-overview" aria-labelledby="mekp-overview-heading">
          <h2 id="mekp-overview-heading" class="spec-h">What is MEKP Hardener / MEKP Catalyst?</h2>
          <p>
            MEKP Hardener is the published catalyst / initiator component used with selected unsaturated polyester resin, vinyl ester resin and gelcoat systems. Buyers may search for a polyester resin hardener, MEKP catalyst or MEKP initiator; on this page, those terms describe the same product role in the selected curing system.
          </p>
          <p>
            It does not replace the base resin, <a href="/products/fibre-glass-mat/">glass-fibre reinforcement</a>, mould-side gelcoat or <a href="/products/frp-polyester-pigment/">FRP Polyester Pigment</a>. The relevant decision is whether the current product data for the base system matches the intended FRP component and manufacturing context.
          </p>
        </section>
      )}
      {isEpoxyClearCastingResin && (
        <section class="gp-overview" aria-labelledby="epoxy-casting-overview-heading">
          <h2 id="epoxy-casting-overview-heading" class="spec-h">What is Epoxy Clear Casting Resin?</h2>
          <p>
            Epoxy Clear Casting Resin is Samrat Poly Resins&rsquo; published two-part epoxy product for transparent cast pieces where optical clarity, a high-gloss finish and the casting role are central to the requirement. Buyers may also search for clear casting resin, crystal clear epoxy resin, transparent epoxy resin or epoxy casting resin.
          </p>
          <p>
            It is not a polyester FRP laminate resin, a mould-side gelcoat or a self-levelling coating selected simply by name. Start with the finished part, casting size, required appearance and whether the requirement is for a contained cast or a surface coat, then review the relevant current product data.
          </p>
        </section>
