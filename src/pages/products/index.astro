---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, CATEGORIES } from '../../data/products.js';

const byCat = CATEGORIES.map(cat => ({ cat, items: products.filter(p => p.category === cat) })).filter(g => g.items.length);
const catId = (cat) => cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---
<Base title="Products" description="Full product range from Samrat Poly Resins — polyester, GP, fire-retardant and coating resins, hardeners and FRP raw materials.">
  <section class="section prod-hero">
    <div class="wrap">
      <p class="eyebrow">Product range</p>
      <h1>What we manufacture</h1>
      <p class="prod-hero-sub">{products.length} resin grades and FRP raw materials, organised by category.</p>
    </div>
  </section>

  <section class="prod-filter-bar">
    <div class="wrap prod-filter-inner">
      <div class="prod-search">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
        <input type="search" id="prodSearch" placeholder="Search products by name…" aria-label="Search products by name" autocomplete="off" />
      </div>
      <button type="button" class="prod-filter-toggle" id="prodFilterToggle" aria-expanded="false" aria-controls="prodChipsPanel">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7" /><line x1="7" y1="12" x2="17" y2="12" /><line x1="10" y1="17" x2="14" y2="17" /></svg>
        <span>Filter</span>
        <span class="prod-filter-toggle-active" id="prodFilterToggleActive">All</span>
        <svg class="prod-filter-chevron" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
      </button>
      <div class="prod-chips" id="prodChipsPanel" role="list" aria-label="Filter by category">
        <button type="button" class="prod-chip prod-chip-all is-active" data-chip-cat="all">All ({products.length})</button>
        {byCat.map(group => (
          <button type="button" class="prod-chip" data-chip-cat={group.cat}>{group.cat} ({group.items.length})</button>
        ))}
      </div>
      <p class="prod-filter-empty" id="prodFilterEmpty" hidden>No products match your search.</p>
    </div>
  </section>

  <section class="section prod-list">
    <div class="wrap">
      {byCat.map(group => (
        <div class="cat-block" id={catId(group.cat)} data-cat-block={group.cat}>
          <h2 class="cat-title"><span>{group.cat}</span><span class="cat-count">{String(group.items.length).padStart(2,'0')}</span></h2>
          <div class="grid">
            {group.items.map(p => <ProductCard product={p} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => {
      const searchInput = document.getElementById('prodSearch') as HTMLInputElement | null;
      const chips = document.querySelectorAll<HTMLButtonElement>('[data-chip-cat]');
      const blocks = document.querySelectorAll<HTMLElement>('[data-cat-block]');
      const emptyMsg = document.getElementById('prodFilterEmpty');
      const filterToggle = document.getElementById('prodFilterToggle');
      const filterToggleActive = document.getElementById('prodFilterToggleActive');
      const chipsPanel = document.getElementById('prodChipsPanel');
      if (!searchInput || !blocks.length || searchInput.dataset.wired === 'true') return;
      searchInput.dataset.wired = 'true';

      // The toggle button only ever renders on mobile (display:none above
      // that breakpoint, exactly like the site's existing nav-toggle
      // hamburger) and the collapsed state only ever hides anything inside
      // that same breakpoint — both driven by CSS media queries, not JS
      // viewport checks, so there's no runtime race between "what width is
      // it" and "did the script run yet." JS just always adds the class;
      // it's inert (zero visual effect) above the mobile breakpoint.
      chipsPanel?.classList.add('is-collapsed');

      filterToggle?.addEventListener('click', () => {
        if (!chipsPanel) return;
        const nowOpen = chipsPanel.classList.toggle('is-collapsed') === false;
        filterToggle.setAttribute('aria-expanded', String(nowOpen));
      });

      let activeCategory = 'all';

      const applyFilter = () => {
        const query = searchInput.value.trim().toLowerCase();
        let anyVisible = false;

        blocks.forEach((block) => {
          const blockCat = block.dataset.catBlock ?? '';
          const catMatches = activeCategory === 'all' || blockCat === activeCategory;
          let blockHasVisibleCard = false;

          block.querySelectorAll<HTMLElement>('[data-product-card]').forEach((card) => {
            const searchText = card.dataset.search ?? '';
            const matches = catMatches && (query === '' || searchText.includes(query));
            card.style.display = matches ? '' : 'none';
            if (matches) blockHasVisibleCard = true;
          });

          block.hidden = !blockHasVisibleCard;
          if (blockHasVisibleCard) anyVisible = true;
        });

        if (emptyMsg) emptyMsg.hidden = anyVisible;
      };

      searchInput.addEventListener('input', applyFilter);

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          activeCategory = chip.dataset.chipCat ?? 'all';
          chips.forEach((c) => c.classList.toggle('is-active', c === chip));
          if (filterToggleActive) filterToggleActive.textContent = activeCategory === 'all' ? 'All' : activeCategory;
          applyFilter();
          // Collapse back after a pick so the flow stays "tap → choose → see
          // results" — harmless no-op on desktop, where the toggle/collapse
          // CSS never applies in the first place.
          chipsPanel?.classList.add('is-collapsed');
          filterToggle?.setAttribute('aria-expanded', 'false');
        });
      });
    });
  </script>

  <style>
    .prod-hero { padding-bottom: 0; }
    .prod-hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin-top: 0.6rem; }
    .prod-hero-sub { color: var(--ink-dim); margin-top: 0.9rem; max-width: 48ch; }

    .prod-filter-bar { padding-block: 1.6rem; position: sticky; top: 68px; z-index: 20; background: var(--bg); border-bottom: 1px solid var(--line); }
    .prod-filter-inner { display: flex; flex-direction: column; gap: 1rem; }
    .prod-search {
      display: flex; align-items: center; gap: 0.6rem;
      border: 1px solid var(--line-2); background: var(--bg-3); padding: 0.7rem 1rem;
      max-width: 420px; color: var(--ink-faint); transition: border-color .25s var(--ease-premium);
    }
    .prod-search:focus-within { border-color: var(--accent-gold); color: var(--accent-gold); }
    .prod-search input {
      flex: 1; background: transparent; border: none; outline: none;
      color: var(--ink); font-family: var(--font-body); font-size: 0.92rem;
    }
    .prod-search input::placeholder { color: var(--ink-faint); }
    .prod-chips { display: flex; flex-wrap: wrap; gap: 0.6rem; }
    .prod-chip {
      font-family: var(--font-mono); font-size: 0.76rem; letter-spacing: 0.03em;
      padding: 0.45rem 0.9rem; border: 1px solid var(--line-2); background: transparent;
      color: var(--ink-dim); cursor: pointer;
      transition: border-color .25s var(--ease-premium), color .25s var(--ease-premium), background .25s var(--ease-premium);
    }
    .prod-chip:hover { border-color: var(--accent-gold); color: var(--accent-gold-light); }
    .prod-chip.is-active { background: var(--accent-gold); border-color: var(--accent-gold); color: #17120c; font-weight: 600; }
    .prod-filter-empty { color: var(--ink-dim); font-size: 0.92rem; margin-top: 0.2rem; }
    /* Mobile-only trigger — hidden by default here exactly like the
       site's existing .nav-toggle hamburger; the mobile media query below
       is the only place that ever shows it, so this is never visible on
       desktop regardless of any JS state. */
    .prod-filter-toggle { display: none; }

    @media (max-width: 620px) {
      .prod-filter-bar { padding-block: 1.1rem; }
      .prod-filter-inner { gap: 0.8rem; }
      .prod-search { max-width: none; }

      /* Compact 2-column grid: every category stays visible and touchable,
         but the block is far shorter than the wrapped single-file chips.
         Same gold identity as desktop — only the geometry changes. */
      .prod-chips { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
      .prod-chip {
        display: flex; align-items: center; justify-content: center;
        min-height: 44px; padding: 0.5rem 0.6rem;
        font-size: 0.7rem; letter-spacing: 0.02em; line-height: 1.35;
        text-align: center;
        background: var(--bg-3);
      }
      .prod-chip.is-active { background: var(--accent-gold); }
      .prod-chip-all { grid-column: 1 / -1; }

      /* Filter toggle — shown only inside this mobile breakpoint. */
      .prod-filter-toggle {
        display: flex; align-items: center; gap: 0.55rem; width: 100%;
        font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.03em;
        padding: 0.75rem 1rem; border: 1px solid var(--line-2); background: var(--bg-3);
        color: var(--ink); cursor: pointer;
        transition: border-color .25s var(--ease-premium), color .25s var(--ease-premium);
      }
      .prod-filter-toggle:hover,
      .prod-filter-toggle[aria-expanded="true"] { border-color: var(--accent-gold); color: var(--accent-gold-light); }
      .prod-filter-toggle-active {
        margin-left: auto; color: var(--accent-gold); font-weight: 600;
        overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 55%;
      }
      .prod-filter-chevron { flex-shrink: 0; transition: transform .25s var(--ease-premium); }
      .prod-filter-toggle[aria-expanded="true"] .prod-filter-chevron { transform: rotate(180deg); }

      /* Collapsed by default on mobile (JS-driven) — the permanently-visible
         category grid that used to occupy the top of the page becomes an
         on-demand panel instead. */
      .prod-chips.is-collapsed { display: none; }
    }

    .cat-block { margin-bottom: 3.2rem; scroll-margin-top: 90px; }
    .cat-block[hidden] { display: none; }
    .cat-title {
      display: flex; align-items: baseline; gap: 1rem;
      font-size: 1.25rem; color: var(--ink-dim); margin-bottom: 1.3rem;
      padding-bottom: 0.7rem; border-bottom: 1px solid var(--line);
    }
    .cat-title span:first-child { color: var(--ink); letter-spacing: 0.05em; }
    .cat-count { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-gold); margin-left: auto; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 1.4rem; }
  </style>
</Base>
