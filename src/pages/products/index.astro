---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products, CATEGORIES } from '../../data/products.js';

const byCat = CATEGORIES.map(cat => ({ cat, items: products.filter(p => p.category === cat) })).filter(g => g.items.length);
const catId = (cat) => cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// GP Resins and Epoxy & Casting each have a dedicated family page (see
// gp-resins.astro / epoxy-resins.astro) that owns the bare "GP resin" /
// "epoxy resin" search intent — link the category heading straight to it
// instead of only the in-page anchor.
const familyPageSlugs = { 'GP Resins': 'gp-resins', 'Epoxy & Casting': 'epoxy-resins' };
---
<Base title="Polyester, Epoxy & FRP Resin Products" description="Explore Samrat Poly Resins’ range of polyester, epoxy, GP, fire-retardant and specialty resins, hardeners and FRP raw materials.">
  <section class="section prod-hero">
    <div class="wrap">
      <p class="eyebrow">Product range</p>
      <h1>What we manufacture</h1>
      <p class="prod-hero-sub">{products.length} resin grades and FRP raw materials, organised by category.</p>
    </div>
  </section>

  <section class="prod-catalogue">
    <div class="wrap prod-layout">
      <div class="prod-toolbar">
        <div class="prod-search">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
          <input type="search" id="prodSearch" placeholder="Search products…" aria-label="Search products by name" autocomplete="off" />
        </div>
        <button type="button" class="prod-rail-toggle" id="prodRailToggle" aria-expanded="false" aria-controls="prodRail">
          <span>Browse Categories</span>
          <svg class="prod-rail-toggle-chevron" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
        </button>
      </div>

      <aside class="prod-rail" id="prodRail">
        <p class="prod-rail-heading">Product categories</p>
        <nav class="prod-rail-list" role="list" aria-label="Filter by category">
          <button type="button" class="prod-rail-item is-active" data-chip-cat="all">
            <span>All Products</span><span class="prod-rail-count">{products.length}</span>
          </button>
          {byCat.map(group => (
            <button type="button" class="prod-rail-item" data-chip-cat={group.cat}>
              <span>{group.cat}</span><span class="prod-rail-count">{group.items.length}</span>
            </button>
          ))}
        </nav>
      </aside>

      <div class="prod-list" id="prodList">
        <p class="prod-filter-empty" id="prodFilterEmpty" hidden>No products match your search.</p>
        {byCat.map(group => (
          <div class="cat-block" id={catId(group.cat)} data-cat-block={group.cat}>
            <h2 class="cat-title">
              {familyPageSlugs[group.cat]
                ? <a href={`/products/${familyPageSlugs[group.cat]}/`}><span>{group.cat}</span></a>
                : <span>{group.cat}</span>}
              <span class="cat-count">{String(group.items.length).padStart(2,'0')}</span>
            </h2>
            <div class="grid">
              {group.items.map(p => <ProductCard product={p} />)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => {
      const searchInput = document.getElementById('prodSearch') as HTMLInputElement | null;
      const chips = document.querySelectorAll<HTMLButtonElement>('[data-chip-cat]');
      const blocks = document.querySelectorAll<HTMLElement>('[data-cat-block]');
      const emptyMsg = document.getElementById('prodFilterEmpty');
      const railToggle = document.getElementById('prodRailToggle');
      const rail = document.getElementById('prodRail');
      if (!searchInput || !blocks.length || searchInput.dataset.wired === 'true') return;
      searchInput.dataset.wired = 'true';

      // The toggle only ever renders below the desktop breakpoint (CSS
      // media query, not a JS viewport check) and the rail is hidden by
      // default there via CSS alone — this just opens/closes it.
      railToggle?.addEventListener('click', () => {
        if (!rail) return;
        const nowOpen = rail.classList.toggle('is-open');
        railToggle.setAttribute('aria-expanded', String(nowOpen));
      });

      let activeCategory = 'all';

      const applyFilter = () => {
        const query = searchInput.value.trim().toLowerCase();
        let anyVisible = false;

        blocks.forEach((block) => {
          const blockCat = block.dataset.catBlock ?? '';
          const catMatches = activeCategory === 'all' || blockCat === activeCategory;
          let blockHasVisibleCard = false;

          block.querySelectorAll<HTMLElement>('[data-product-card]').forEach((card) => {
            const searchText = card.dataset.search ?? '';
            const matches = catMatches && (query === '' || searchText.includes(query));
            card.style.display = matches ? '' : 'none';
            if (matches) blockHasVisibleCard = true;
          });

          block.hidden = !blockHasVisibleCard;
          if (blockHasVisibleCard) anyVisible = true;
        });

        if (emptyMsg) emptyMsg.hidden = anyVisible;
      };

      searchInput.addEventListener('input', applyFilter);

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          activeCategory = chip.dataset.chipCat ?? 'all';
          chips.forEach((c) => c.classList.toggle('is-active', c === chip));
          applyFilter();
          // Collapse the mobile dropdown after a pick so the flow stays
          // "tap → choose → see results" — harmless no-op on desktop,
          // where the rail is always visible regardless of this class.
          rail?.classList.remove('is-open');
          railToggle?.setAttribute('aria-expanded', 'false');
        });
      });
    });
  </script>

  <style>
    .prod-hero { padding-bottom: 0; }
    .prod-hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin-top: 0.6rem; }
    .prod-hero-sub { color: var(--ink-dim); margin-top: 0.9rem; max-width: 48ch; }

    /* Compact catalogue section: replaces the old sticky filter bar +
       large .section spacing with one shallow block, so the category
       list and first product row sit close beneath the hero. */
    .prod-catalogue { padding: 1.75rem 0 4.5rem; }

    .prod-layout { display: block; }

    .prod-toolbar { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.1rem; }
    .prod-search {
      display: flex; align-items: center; gap: 0.5rem;
      width: 100%; max-width: 420px; min-width: 0; height: 42px;
      border: 1px solid var(--line-2); background: var(--bg-3); padding-inline: 0.85rem;
      color: var(--ink-faint); transition: border-color .25s var(--ease-premium);
    }
    .prod-search:focus-within { border-color: var(--accent-gold); color: var(--accent-gold); }
    .prod-search input {
      flex: 1; height: 100%; background: transparent; border: none; outline: none;
      min-width: 0;
      color: var(--ink); font-family: var(--font-body); font-size: 0.85rem;
    }
    .prod-search input::placeholder { color: var(--ink-faint); }

    /* Mobile/tablet category dropdown trigger — hidden by default here
       exactly like the site's existing .nav-toggle hamburger; only the
       breakpoint below ever shows it. */
    .prod-rail-toggle {
      display: none; align-items: center; gap: 0.55rem; flex-shrink: 0;
      font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.03em;
      padding: 0 1rem; height: 42px; border: 1px solid var(--line-2); background: var(--bg-3);
      color: var(--ink); cursor: pointer;
      transition: border-color .25s var(--ease-premium), color .25s var(--ease-premium);
    }
    .prod-rail-toggle:hover,
    .prod-rail-toggle[aria-expanded="true"] { border-color: var(--accent-gold); color: var(--accent-gold-light); }
    .prod-rail-toggle-chevron { transition: transform .25s var(--ease-premium); }
    .prod-rail-toggle[aria-expanded="true"] .prod-rail-toggle-chevron { transform: rotate(180deg); }

    /* Category rail — hidden by default (mobile/tablet); the desktop
       media query below turns it into the left-hand sidebar. */
    .prod-rail { display: none; border: 1px solid var(--line); background: var(--bg-2); margin-bottom: 1.5rem; }
    .prod-rail.is-open { display: block; }
    .prod-rail-heading {
      font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-faint); padding: 0.9rem 1rem 0.6rem;
    }
    .prod-rail-list { display: flex; flex-direction: column; }
    .prod-rail-item {
      display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
      width: 100%; text-align: left; background: transparent; border: none; border-top: 1px solid var(--line);
      min-height: 38px; padding: 0.6rem 1rem;
      font-family: var(--font-body); font-size: 0.85rem; color: var(--ink-dim); cursor: pointer;
      transition: background .2s var(--ease-premium), color .2s var(--ease-premium);
    }
    .prod-rail-list .prod-rail-item:first-child { border-top: none; }
    .prod-rail-item:hover { background: rgba(var(--gold-rgb), 0.08); color: var(--ink); }
    .prod-rail-item.is-active { background: var(--accent-gold); color: #17120c; font-weight: 600; }
    .prod-rail-item.is-active .prod-rail-count { color: #17120c; }
    .prod-rail-count { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent-gold); flex-shrink: 0; }

    .prod-filter-empty { color: var(--ink-dim); font-size: 0.85rem; margin-bottom: 1rem; }

    @media (min-width: 901px) {
      /* Desktop: fixed-width sticky rail on the left, search + product
         list filling the rest of the row — no toggle, no horizontal
         scrolling, every category visible at once. */
      .prod-layout {
        display: grid; grid-template-columns: 220px 1fr; column-gap: 2rem; align-items: start;
      }
      .prod-toolbar { grid-column: 2; grid-row: 1; margin-bottom: 1.6rem; }
      .prod-rail {
        grid-column: 1; grid-row: 1 / span 2; display: block; margin-bottom: 0;
        position: sticky; top: 88px;
      }
      .prod-rail-toggle { display: none; }
      .prod-list { grid-column: 2; grid-row: 2; }
    }

    @media (max-width: 620px) {
      .prod-catalogue { padding: 1.4rem 0 3.5rem; }
      .prod-toolbar { flex-direction: column; align-items: stretch; }
      .prod-search { max-width: none; }
      .prod-search input { font-size: 1rem; }
      .prod-rail-toggle { display: flex; justify-content: space-between; width: 100%; }
    }
    @media (min-width: 621px) and (max-width: 900px) {
      .prod-rail-toggle { display: flex; }
    }

    .cat-block { margin-bottom: 3.2rem; scroll-margin-top: 90px; }
    .cat-block[hidden] { display: none; }
    .cat-title {
      display: flex; align-items: baseline; gap: 1rem;
      font-size: 1.25rem; color: var(--ink-dim); margin-bottom: 1.3rem;
      padding-bottom: 0.7rem; border-bottom: 1px solid var(--line);
    }
    .cat-title span:first-child,
    .cat-title a:first-child { color: var(--ink); letter-spacing: 0.05em; }
    .cat-title a:first-child { transition: color .2s var(--ease-premium); }
    .cat-title a:first-child:hover { color: var(--accent-gold-light); }
    .cat-count { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-gold); margin-left: auto; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.4rem; }
  </style>
</Base>
