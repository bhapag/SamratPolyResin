---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { products } from '../../data/products.js';
import { applications } from '../../data/applications.js';
import { resources } from '../../data/resources.js';
import { site, buildCanonicalUrl } from '../../data/site.js';

// "Industrial & Specialty Resins" is an existing category in products.js with
// 6 products and 4 dedicated vinyl ester application pages, but no hub. It is
// the family a buyer reaches when a general-purpose grade is NOT the answer —
// a stated chemical-service requirement, a closed-mould compound, a cultured-
// marble line or a documented epoxy route.
//
// Deliberately framed around "when GP is not enough" rather than "premium
// grades": the catalogue publishes no performance ranking between families,
// and inventing one would be a claim the product data does not support.
//
// Bisphenol Resin is described here exactly as its own verified product
// document classifies it, and no property, chemistry or application is
// inferred from the name.
const grades = products.filter((p) => p.category === 'Industrial & Specialty Resins');

const relatedApplicationSlugs = [
  'vinyl-ester-resin-for-chemical-storage-tanks',
  'vinyl-ester-resin-for-pipelines-ducts-scrubbers',
  'vinyl-ester-resin-for-filament-winding',
  'vinyl-ester-resin-for-pultrusion',
];
const relatedApplications = relatedApplicationSlugs
  .map((slug) => applications.find((a) => a.slug === slug))
  .filter(Boolean);

const relatedResourceSlugs = [
  'what-is-vinyl-ester-resin',
  'vinyl-ester-resin-technical-specifications',
  'what-is-dmc-smc-resin',
  'dmc-vs-smc',
  'what-is-marble-resin',
  'marble-resin-vs-pet-resin',
  'what-is-pet-modified-polyester-resin',
  'what-is-fiberglass-epoxy-resin',
  'bisphenol-resin-vs-upr-and-gp-resin',
];
const relatedResources = relatedResourceSlugs
  .map((slug) => resources.find((r) => r.slug === slug && !r.draft))
  .filter(Boolean);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: buildCanonicalUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Products', item: buildCanonicalUrl('/products/') },
    { '@type': 'ListItem', position: 3, name: 'Industrial & Specialty Resins', item: buildCanonicalUrl('/products/industrial-specialty-resins/') },
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Industrial & Specialty Resins',
  url: buildCanonicalUrl('/products/industrial-specialty-resins/'),
  description: `The ${grades.length} Samrat Poly Resins grades reviewed when a general-purpose polyester resin is not the right answer.`,
  isPartOf: { '@id': `${site.url}/#organization` },
  hasPart: grades.map((p) => ({
    '@type': 'Product',
    name: p.name,
    url: buildCanonicalUrl(`/products/${p.slug}/`),
  })),
};
---
<Base
  title="Industrial & Specialty Resins — Vinyl Ester, DMC/SMC, Marble & More"
  description={`${grades.length} Samrat Poly Resins grades for the jobs a general-purpose resin does not cover: vinyl ester for stated chemical service, DMC/SMC compounds, cultured-marble and PET-modified grades, a documented fibreglass epoxy route and bisphenol resin. Published specifications with TDS.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />

  <section class="section fam-hero">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <a href="/products/">Products</a> <span aria-hidden="true">/</span>
        <span aria-current="page">Industrial &amp; Specialty Resins</span>
      </nav>
      <div class="fam-hero-inner">
        <div>
          <p class="eyebrow">Product family</p>
          <h1>Industrial &amp; Specialty Resins</h1>
          <p class="fam-hero-sub">
            These {grades.length} grades exist for the jobs a general-purpose polyester resin is not the right
            answer to — a stated chemical- or corrosion-service requirement, a closed-mould compound,
            a cultured-marble or engineered-stone line, a sheet-lamination grade, or a documented
            epoxy route for fibreglass fabric. Each is a distinct published product with its own
            technical data sheet.
          </p>
          <p class="fam-hero-note">
            None of these is published as "better" than a GP grade — they are formulated for different
            requirements. Choose from the requirement your drawing or customer specification actually
            states, and confirm suitability against the grade's own TDS rather than the family name.
          </p>
        </div>
        <div class="fam-hero-badge">
          <span class="fam-hero-badge-num">{grades.length}</span>
          <span class="fam-hero-badge-label">Published<br/>Products</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section fam-grades">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{grades.length} products</p>
        <h2>Industrial &amp; specialty grades</h2>
      </div>
      <div class="grid">
        {grades.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  {relatedApplications.length > 0 && (
    <section class="section fam-links">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Applications</p>
          <h2>Documented chemical-service applications</h2>
        </div>
        <div class="fam-card-grid">
          {relatedApplications.map((a) => (
            <a href={`/applications/${a.slug}/`} class="fam-link-card">
              <span>{a.title}</span>
              <span class="fam-link-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedResources.length > 0 && (
    <section class="section fam-links">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Resources</p>
          <h2>Understanding these grades</h2>
        </div>
        <div class="fam-card-grid">
          {relatedResources.map((r) => (
            <a href={`/resources/${r.slug}/`} class="fam-link-card">
              <span>{r.title}</span>
              <span class="fam-link-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section fam-enquire">
    <div class="wrap fam-enquire-inner">
      <div class="section-head">
        <p class="eyebrow">Enquiry</p>
        <h2>Ask about a specialty grade</h2>
        <p class="fam-enquiry-note">
          These grades are chosen against a stated requirement, so the more of it you can share the
          better: the component, the service condition or standard you have been given, the process,
          expected quantity and delivery location. <a href="/how-to-order/">How ordering works →</a>
        </p>
      </div>
      <div class="fam-enquire-box">
        <EnquiryForm pageContext="industrial-specialty-resins-family" messagePlaceholder="Component, stated requirement or standard, process, quantity, delivery location" />
      </div>
      <a href={site.catalogue.url} class="doc-link fam-doc-link" target="_blank" rel="noopener" download
         aria-label={`Download ${site.catalogue.title} (PDF)`}>
        <span class="doc-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V4.5A1.5 1.5 0 0 1 5.5 3H18a1 1 0 0 1 1 1v15.2"/><path d="M6.5 3v18"/><path d="M6.5 21H19a1 1 0 0 0 1-1v-.5a1 1 0 0 0-1-1H6.8"/></svg>
        </span>
        <span class="doc-link-body"><span class="doc-link-kind">Catalogue</span><span class="doc-link-title">Full product range &amp; specs (PDF)</span></span>
        <span class="doc-link-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <style>
    .fam-hero { padding-bottom: 0; }
    .fam-hero-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
    .fam-hero h1 { font-size: clamp(2rem, 5.5vw, 3.2rem); margin-top: 0.6rem; }
    .fam-hero-sub { color: var(--ink-dim); margin-top: 1rem; max-width: 68ch; line-height: 1.7; }
    .fam-hero-note {
      color: var(--ink-faint); margin-top: 0.9rem; max-width: 64ch; line-height: 1.65;
      font-size: 0.88rem; border-left: 2px solid var(--line-2); padding-left: 0.9rem;
    }
    .fam-hero-badge {
      flex-shrink: 0; display: flex; flex-direction: column; align-items: center; text-align: center;
      padding: 1.4rem 1.8rem; border: 1px solid var(--line-2); background: var(--bg-3);
      box-shadow: var(--surface-shadow-rest);
    }
    .fam-hero-badge-num { font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; color: var(--accent-gold-light); line-height: 1; }
    .fam-hero-badge-label {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-faint); margin-top: 0.6rem; line-height: 1.5;
    }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.4rem; }

    .fam-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.9rem; }
    .fam-link-card {
      display: flex; align-items: center; justify-content: space-between; gap: 0.9rem;
      padding: 1rem 1.2rem; background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
      color: var(--ink-dim); font-size: 0.92rem; line-height: 1.5;
      transition: border-color .25s var(--ease-premium), transform .25s var(--ease-premium), box-shadow .25s var(--ease-premium), color .25s var(--ease-premium);
    }
    .fam-link-card:hover { border-color: var(--line-2); color: var(--ink); transform: translateY(-2px); box-shadow: var(--surface-shadow-hover); }
    .fam-link-card:hover .fam-link-card-arrow { transform: translateX(3px); color: var(--accent-gold); }
    .fam-link-card-arrow { flex-shrink: 0; color: var(--ink-faint); transition: transform .25s var(--ease-premium), color .25s var(--ease-premium); }

    .fam-enquire-inner { max-width: 720px; }
    .fam-enquiry-note { color: var(--ink-dim); margin-top: 0.7rem; line-height: 1.7; }
    .fam-enquire-box { background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); padding: clamp(1.4rem, 4vw, 2.2rem); }
    .fam-doc-link { margin-top: 1.4rem; }
    @media (max-width: 620px) { .fam-hero-inner { flex-direction: column; } .fam-hero-badge { flex-direction: row; gap: 1rem; align-self: flex-start; } }
    @media (prefers-reduced-motion: reduce) { .fam-link-card, .fam-link-card-arrow { transition: none; } .fam-link-card:hover { transform: none; } }
  </style>
</Base>
