---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import EnquiryForm from '../../components/EnquiryForm.astro';
import { products } from '../../data/products.js';
import { applications } from '../../data/applications.js';
import { resources } from '../../data/resources.js';
import { site } from '../../data/site.js';

// "Epoxy & Casting" is an existing category in products.js (4 products) that
// had no dedicated commercial page — same gap as GP Resins (see that file's
// comment). This page owns the bare "epoxy resin" / "epoxy resin
// manufacturer India" intent without inventing any new product or fact.
const grades = products.filter((p) => p.category === 'Epoxy & Casting');

const relatedApplicationSlugs = [
  'epoxy-clear-casting-resin-for-river-tables',
  'epoxy-clear-casting-resin-for-jewellery-casting',
  'epoxy-clear-casting-resin-casting-process',
];
const relatedApplications = relatedApplicationSlugs
  .map((slug) => applications.find((a) => a.slug === slug))
  .filter(Boolean);

const relatedResourceSlugs = [
  'what-is-epoxy-clear-casting-resin',
  'what-is-epoxy-art-resin',
  'what-is-uv-resin',
  'what-is-epoxy-hardener',
  'casting-resin-vs-coating-resin',
  'epoxy-hardener-compatibility-guide',
];
const relatedResources = relatedResourceSlugs
  .map((slug) => resources.find((r) => r.slug === slug && !r.draft))
  .filter(Boolean);
---
<Base
  title="Epoxy Resin Manufacturer in India"
  description="Samrat Poly Resins manufactures epoxy resin systems — clear casting, art resin and UV-cure resin — for casting, art and industrial applications across India."
>
  <section class="section fam-hero">
    <div class="wrap fam-hero-inner">
      <div>
        <p class="eyebrow">Product family</p>
        <h1>Epoxy Resin — Casting, Art &amp; Curing Systems</h1>
        <p class="fam-hero-sub">
          Samrat Poly Resins manufactures {grades.length} epoxy products — clear casting resin, self-levelling
          art resin, UV-cure resin and epoxy hardener — for casting, decorative and industrial
          applications. Each is a distinct, published product with its own technical data sheet; this
          page is the starting point for choosing the right one.
        </p>
      </div>
      <div class="fam-hero-badge">
        <span class="fam-hero-badge-num">{grades.length}</span>
        <span class="fam-hero-badge-label">Published<br/>Products</span>
      </div>
    </div>
  </section>

  <section class="section fam-grades">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">{grades.length} products</p>
        <h2>Epoxy Resin products</h2>
      </div>
      <div class="grid">
        {grades.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  {relatedApplications.length > 0 && (
    <section class="section fam-links">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Applications</p>
          <h2>Where Epoxy Resin is used</h2>
        </div>
        <div class="fam-card-grid">
          {relatedApplications.map((a) => (
            <a href={`/applications/${a.slug}/`} class="fam-link-card">
              <span>{a.title}</span>
              <span class="fam-link-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedResources.length > 0 && (
    <section class="section fam-links">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Resources</p>
          <h2>Understanding Epoxy Resin</h2>
        </div>
        <div class="fam-card-grid">
          {relatedResources.map((r) => (
            <a href={`/resources/${r.slug}/`} class="fam-link-card">
              <span>{r.title}</span>
              <span class="fam-link-card-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section fam-enquire">
    <div class="wrap fam-enquire-inner">
      <div class="section-head">
        <p class="eyebrow">Enquiry</p>
        <h2>Ask about an Epoxy Resin product</h2>
        <p class="fam-enquiry-note">Share the product (if known), intended application, expected quantity and delivery location so we can point you to the right product or prepare a quote.</p>
      </div>
      <div class="fam-enquire-box">
        <EnquiryForm pageContext="epoxy-resins-family" messagePlaceholder="Product (if known), application, quantity, delivery location" />
      </div>
      <a href={site.catalogue.url} class="doc-link fam-doc-link" target="_blank" rel="noopener" download
         aria-label={`Download ${site.catalogue.title} (PDF)`}>
        <span class="doc-link-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V4.5A1.5 1.5 0 0 1 5.5 3H18a1 1 0 0 1 1 1v15.2"/><path d="M6.5 3v18"/><path d="M6.5 21H19a1 1 0 0 0 1-1v-.5a1 1 0 0 0-1-1H6.8"/></svg>
        </span>
        <span class="doc-link-body"><span class="doc-link-kind">Catalogue</span><span class="doc-link-title">All Epoxy products &amp; specs (PDF)</span></span>
        <span class="doc-link-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <style>
    .fam-hero { padding-bottom: 0; }
    .fam-hero-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
    .fam-hero h1 { font-size: clamp(2rem, 5.5vw, 3.2rem); margin-top: 0.6rem; }
    .fam-hero-sub { color: var(--ink-dim); margin-top: 1rem; max-width: 68ch; line-height: 1.7; }
    .fam-hero-badge {
      flex-shrink: 0; display: flex; flex-direction: column; align-items: center; text-align: center;
      padding: 1.4rem 1.8rem; border: 1px solid var(--line-2); background: var(--bg-3);
      box-shadow: var(--surface-shadow-rest);
    }
    .fam-hero-badge-num { font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; color: var(--accent-gold-light); line-height: 1; }
    .fam-hero-badge-label {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-faint); margin-top: 0.6rem; line-height: 1.5;
    }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.4rem; }

    .fam-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.9rem; }
    .fam-link-card {
      display: flex; align-items: center; justify-content: space-between; gap: 0.9rem;
      padding: 1rem 1.2rem; background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
      color: var(--ink-dim); font-size: 0.92rem; line-height: 1.5;
      transition: border-color .25s var(--ease-premium), transform .25s var(--ease-premium), box-shadow .25s var(--ease-premium), color .25s var(--ease-premium);
    }
    .fam-link-card:hover { border-color: var(--line-2); color: var(--ink); transform: translateY(-2px); box-shadow: var(--surface-shadow-hover); }
    .fam-link-card:hover .fam-link-card-arrow { transform: translateX(3px); color: var(--accent-gold); }
    .fam-link-card-arrow { flex-shrink: 0; color: var(--ink-faint); transition: transform .25s var(--ease-premium), color .25s var(--ease-premium); }

    .fam-enquire-inner { max-width: 720px; }
    .fam-enquiry-note { color: var(--ink-dim); margin-top: 0.7rem; }
    .fam-enquire-box { background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); padding: clamp(1.4rem, 4vw, 2.2rem); }
    .fam-doc-link { margin-top: 1.4rem; }
    @media (max-width: 620px) { .fam-hero-inner { flex-direction: column; } .fam-hero-badge { flex-direction: row; gap: 1rem; align-self: flex-start; } }
  </style>
</Base>
