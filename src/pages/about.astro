---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { site, buildCanonicalUrl, ORGANIZATION_ID } from '../data/site.js';
import { products, CATEGORIES } from '../data/products.js';
import factoryGate from '../assets/about/factory-gate.jpg';
import productionInfrastructure from '../assets/facility/production-infrastructure.jpg';
import qcLaboratory from '../assets/quality/qc-laboratory.jpg';

const facilityPhotos = [
  { src: factoryGate, alt: `${site.name} factory gate, ${site.address.line2}`, caption: 'Factory Gate' },
  { src: productionInfrastructure, alt: 'Stainless-steel resin processing reactors at the Samrat Poly Resins manufacturing facility', caption: 'Production Reactors' },
  { src: qcLaboratory, alt: 'Quality inspection laboratory at Samrat Poly Resins', caption: 'Quality Inspection Laboratory' },
];

const years = new Date().getFullYear() - Number(site.established);

// This page is the canonical brand/company page for the business — deliberately
// NOT a second "brand" page alongside it, which would split the entity.
//
// It was previously titled "About us" with an H1 of "Engineered for quality.
// Built for consistency." — a slogan that never states who the company is.
// Search Console (1 Aug – 6 Sept 2026) shows this page at average position
// 23.8 for branded queries, which is where a company's own About page should
// never be. The H1 now carries the brand name; the slogan moves below it,
// where it still reads as intended.
const brandPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${site.name}`,
  url: buildCanonicalUrl('/about/'),
  description: `${site.name} — resin manufacturer at ${site.address.line2}, ${site.address.state}, established ${site.established}.`,
  mainEntity: { '@id': ORGANIZATION_ID },
  primaryImageOfPage: { '@type': 'ImageObject', url: buildCanonicalUrl(site.ogImage) },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: buildCanonicalUrl('/') },
    { '@type': 'ListItem', position: 2, name: `About ${site.name}`, item: buildCanonicalUrl('/about/') },
  ],
};
---
<Base
  title="Samrat Poly Resins — Resin Manufacturer, Ludhiana"
  description={`${site.name} is a resin manufacturer at ${site.address.line2}, ${site.address.state}, established ${site.established}. GP polyester, gelcoat, fire-retardant and specialty polyester resins; epoxy systems and FRP materials supplied. Proprietor ${site.proprietor}. GSTIN ${site.gst}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(brandPageJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <section class="section about-hero">
    <div class="wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <span aria-current="page">About {site.name}</span>
      </nav>
      <p class="eyebrow">The company</p>
      <h1>{site.name}</h1>
      <p class="about-tagline">
        Engineered for <span class="hl" data-text="quality">quality</span>.
        Built for <span class="hl" data-text="consistency">consistency</span>.
      </p>
      <p class="about-lead">
        {site.name} is a resin manufacturer based at {site.address.line2},{' '}
        {site.address.state}, established in {site.established} and run by
        proprietor {site.proprietor}. We make GP polyester, gelcoat,
        fire-retardant and specialty polyester resins, supply epoxy systems,
        hardeners and FRP materials alongside them — {products.length} published
        products in total — and serve FRP and composite manufacturers across
        {' '}{site.statesServed.filter((s) => !s.startsWith('Export')).length} Indian states.
        The company holds an ISO 9001:2015 certificate of registration for the
        manufacture and supply of polyester resins and allied products.
      </p>
    </div>
  </section>

  <section class="section about-body">
    <div class="wrap about-grid">
      <div class="about-copy">
        <figure class="about-photo">
          <Image src={facilityPhotos[0].src} alt={facilityPhotos[0].alt} widths={[400, 800, 1448]} sizes="(max-width: 860px) 100vw, 480px" loading="lazy" />
          <figcaption>Our facility — {site.address.line2}, {site.address.state}</figcaption>
        </figure>
        <p>
          Our resins are produced on modern processing equipment, using raw
          materials sourced from established vendors. Each batch is
          manufactured to a defined specification and checked for consistent
          viscosity, gel time and cure behaviour before it is approved.
        </p>
        <p>
          Every batch is inspected against our quality parameters ahead of
          dispatch, confirming it matches both the specification and prior
          production runs. That consistency, backed by reliable production
          capacity, lets fabricators plan their own manufacturing schedules
          with confidence.
        </p>
        <a href="/products/" class="btn btn-solid">View our products</a>
      </div>

      <ul class="about-facts">
        <li><span>Proprietor</span>{site.proprietor}</li>
        <li><span>Business</span>Manufacturer</li>
        <li><span>Location</span>{site.address.line2}, {site.address.state}</li>
        <li><span>GSTIN</span>{site.gst}</li>
        <li><span>Established</span>{site.established} ({years}+ yrs)</li>
        <li><span>Product Range</span>{products.length}+ resin grades</li>
        <li><span>Certification</span><a href="/certificates/iso-9001-2015-certificate-current.jpg" target="_blank" rel="noopener">ISO 9001:2015 certificate of registration</a> ({site.certification.issuer}, first registered June 2019, ref. {site.certification.reference}; scope: {site.certification.scope.toLowerCase()})</li>
      </ul>
    </div>
  </section>

  <section class="section about-facility">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Inside the facility</p>
        <h2>Where the resin is made</h2>
      </div>
      <div class="about-facility-grid">
        {facilityPhotos.slice(1).map((photo) => (
          <figure class="about-facility-photo">
            <Image src={photo.src} alt={photo.alt} widths={[400, 700, 1000]} sizes="(max-width: 760px) 100vw, 460px" loading="lazy" />
            <figcaption>{photo.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section about-cats">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Categories</p>
        <h2>Our product portfolio</h2>
      </div>
      <div class="cat-grid">
        {CATEGORIES.map(cat => (
          <a href={`/products/#${cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`} class="cat-tile">
            <span class="cat-tile-name">{cat}</span>
            <span class="cat-tile-count">{products.filter(p => p.category === cat).length} grades</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .about-hero { padding-bottom: 0; }
    .about-hero h1 { font-size: clamp(2.1rem, 5.5vw, 3.4rem); margin-top: 0.6rem; }
    /* The slogan that used to be the H1. It still reads as the headline
       statement, but the H1 above it now names the company — which is what a
       canonical brand page has to do. */
    .about-tagline {
      font-family: var(--font-display);
      font-size: clamp(1.15rem, 2.6vw, 1.6rem);
      line-height: 1.35; margin-top: 0.7rem; color: var(--ink);
      max-width: 26ch;
    }
    .about-lead { color: var(--ink-dim); margin-top: 1.3rem; max-width: 62ch; font-size: 1.02rem; line-height: 1.72; }

    .about-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(1.5rem, 5vw, 4rem); }
    .about-copy p { color: var(--ink-dim); margin-bottom: 1.1rem; }
    .about-copy .btn { margin-top: 0.8rem; }

    .about-photo {
      border: 1px solid var(--image-frame-border); border-radius: 14px; overflow: hidden;
      margin-bottom: 1.6rem; box-shadow: var(--image-frame-shadow);
      transition: box-shadow .4s var(--ease-premium);
    }
    .about-photo:hover { box-shadow: 0 1px 0 rgba(255, 255, 255, .08) inset, 0 22px 48px rgba(0, 0, 0, .46); }
    .about-photo img { width: 100%; height: auto; display: block; transition: transform .5s var(--ease-premium); }
    .about-photo:hover img { transform: scale(1.035); }
    .about-photo figcaption {
      padding: 0.7rem 0.9rem; border-top: 1px solid var(--line); background: var(--bg-3);
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--ink-faint);
    }

    .about-facts { list-style: none; display: flex; flex-direction: column; gap: 1.1rem; align-self: start; }
    .about-facts li { border-left: 2px solid var(--accent-gold); padding-left: 0.9rem; font-size: 0.95rem; line-height: 1.5; }
    .about-facts span { display: block; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); margin-bottom: 0.25rem; }
    .about-facts a {
      color: var(--accent-gold-light); text-decoration: underline; text-underline-offset: 2px;
      transition: color .25s var(--ease-premium);
    }
    .about-facts a:hover { color: var(--accent-gold); }
    @media (max-width: 760px) { .about-grid { grid-template-columns: 1fr; } }

    .about-facility { padding-top: 0; }
    .about-facility-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.4rem; }
    .about-facility-photo {
      border: 1px solid var(--image-frame-border); overflow: hidden; box-shadow: var(--image-frame-shadow);
      transition: box-shadow .4s var(--ease-premium);
    }
    .about-facility-photo:hover { box-shadow: 0 1px 0 rgba(255, 255, 255, .08) inset, 0 22px 48px rgba(0, 0, 0, .46); }
    .about-facility-photo :global(img) {
      width: 100%; height: clamp(220px, 28vw, 320px); object-fit: cover; display: block;
      transition: transform .5s var(--ease-premium);
    }
    .about-facility-photo:hover :global(img) { transform: scale(1.035); }
    .about-facility-photo figcaption {
      padding: 0.7rem 0.9rem; border-top: 1px solid var(--line); background: var(--bg-3);
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--ink-faint);
    }
    @media (max-width: 620px) { .about-facility-grid { grid-template-columns: 1fr; } }

    .about-cats { position: relative; background: linear-gradient(180deg, transparent, var(--bg-2) 64px); }
    .about-cats::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--line-2) 20%, var(--line-2) 80%, transparent);
    }
    .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); grid-auto-rows: 1fr; gap: 1rem; }
    .cat-tile {
      display: flex; flex-direction: column; justify-content: center; gap: 0.4rem; padding: 1.3rem 1.4rem; height: 100%;
      background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
      transition: border-color .3s var(--ease-premium), transform .3s var(--ease-premium), box-shadow .3s var(--ease-premium);
    }
    .cat-tile:hover {
      border-color: var(--line-2); transform: translateY(-3px) scale(1.012);
      box-shadow: var(--surface-shadow-hover);
    }
    .cat-tile-name { font-family: var(--font-display); text-transform: uppercase; font-size: 1rem; letter-spacing: 0.03em; }
    .cat-tile-count { font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent-gold-light); }
  </style>
</Base>
