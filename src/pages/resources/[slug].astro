---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import DataTable from '../../components/DataTable.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ResourceIcon from '../../components/ResourceIcon.astro';
import TechIcon from '../../components/TechIcon.astro';
import Callout from '../../components/Callout.astro';
import ProductCTA from '../../components/ProductCTA.astro';
import { resources, getReadingTime } from '../../data/resources.js';
import { products } from '../../data/products.js';
import { resourceProductLinks } from '../../data/resourceProductLinks.js';
import { site, buildCanonicalUrl } from '../../data/site.js';

export function getStaticPaths() {
  return resources.filter((r) => !r.draft).map((r) => ({ params: { slug: r.slug }, props: { resource: r } }));
}

// Real photography used inline in article bodies (see `photo` on a section)
// lives alongside the other real site photos in src/assets/ — resolved here,
// by filename, the same way ProductCard.astro resolves product photos.
const sharedPhotoModules = {
  ...import.meta.glob('/src/assets/facility/*', { eager: true }),
  ...import.meta.glob('/src/assets/quality/*', { eager: true }),
  ...import.meta.glob('/src/assets/about/*', { eager: true }),
};
const resolveSharedPhoto = (filename) => {
  const entry = Object.entries(sharedPhotoModules).find(([path]) => path.endsWith(`/${filename}`));
  return entry?.[1]?.default;
};

const { resource } = Astro.props;
const { title, description, icon, category, publishDate, sections, quickFacts, comparisonTable, faqs, relatedSlugs, recommendedLinks = [] } = resource;

const linkedProductSlug = resourceProductLinks[resource.slug];
const linkedProduct = linkedProductSlug ? products.find((p) => p.slug === linkedProductSlug) : null;

const toId = (heading) => heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const formattedDate = new Date(publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const gpAuthoritySlugs = new Set([
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'gp-clear-resin-vs-gp-yellow-resin',
  'gp-resin-vs-lamination-resin',
  'gp-resin-vs-vinyl-ester-resin',
  'gp-resin-vs-gelcoat-resin',
  'why-gp-resin-turns-yellow',
  'why-polyester-resin-remains-sticky-or-tacky',
  'how-to-reduce-shrinkage-in-gp-resin-applications',
  'gp-resin-viscosity-explained',
  'gp-yellow-resin-uses-in-frp-manufacturing',
]);
const isGpAuthorityResource = gpAuthoritySlugs.has(resource.slug);
const isGpYellowUsesResource = resource.slug === 'gp-yellow-resin-uses-in-frp-manufacturing';
const gpWhiteAuthoritySlugs = new Set([
  'what-is-gp-white-resin',
  'applications-of-gp-white-resin',
  'gp-white-resin-vs-gp-clear-resin',
  'gp-white-resin-vs-gelcoat-resin',
  'gp-white-resin-buyer-guide',
]);
const isGpWhiteAuthorityResource = gpWhiteAuthoritySlugs.has(resource.slug);
const gpQuartzAuthoritySlugs = new Set([
  'what-is-gp-quartz-resin',
  'gp-quartz-resin-uses-engineered-stone-mineral-composites',
  'gp-quartz-resin-vs-gp-clear-resin',
  'gp-quartz-resin-vs-marble-resin',
  'gp-quartz-resin-viscosity-gel-time-storage-guide',
  'gp-quartz-resin-buyer-guide',
]);
const isGpQuartzAuthorityResource = gpQuartzAuthoritySlugs.has(resource.slug);
const laminationAuthoritySlugs = new Set([
  'gp-resin-vs-lamination-resin',
  'what-is-lamination-resin',
  'applications-of-lamination-resin',
  'lamination-resin-for-hand-lay-up',
  'lamination-resin-vs-vinyl-ester-resin',
  'lamination-resin-vs-gelcoat-resin',
  'common-lamination-defects-in-frp',
]);
const isLaminationAuthorityResource = laminationAuthoritySlugs.has(resource.slug);
const gelcoatAuthoritySlugs = new Set([
  'what-is-gel-coat-resin',
  'gp-resin-vs-gelcoat-resin',
  'lamination-resin-vs-gelcoat-resin',
  'gelcoat-resin-vs-vinyl-ester-resin',
  'gelcoat-resin-vs-epoxy-resin',
  'applications-of-gelcoat-resin-in-frp-manufacturing',
  'how-to-choose-gelcoat-resin-for-frp-products',
  'gelcoat-resin-problems-peeling-cracking-tackiness',
  'gelcoat-resin-storage-and-handling-guide',
]);
const isGelcoatAuthorityResource = gelcoatAuthoritySlugs.has(resource.slug);
const buttonAuthoritySlugs = new Set([
  'what-is-button-grade-resin',
  'button-resin-for-polyester-button-manufacturing',
  'how-to-choose-resin-for-button-manufacturing',
  'button-grade-resin-vs-gp-resin',
  'button-grade-resin-vs-clear-casting-resin',
  'button-resin-gel-time-and-viscosity-guide',
  'button-resin-storage-and-quote-guide',
  'button-resin-processing-checklist',
]);
const isButtonAuthorityResource = buttonAuthoritySlugs.has(resource.slug);
const uprAuthoritySlugs = new Set([
  'what-is-unsaturated-polyester-resin',
  'types-of-unsaturated-polyester-resin',
  'unsaturated-polyester-resin-vs-vinyl-ester-resin',
  'unsaturated-polyester-resin-vs-epoxy-resin',
  'polyester-resin-procurement-checklist',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'how-to-store-unsaturated-polyester-resin',
]);
const isUprAuthorityResource = uprAuthoritySlugs.has(resource.slug);
const glassFiberAuthoritySlugs = new Set([
  'what-is-glass-fiber-chopped-strand-mat',
  'csm-300-vs-csm-450-glass-fiber',
  'glass-fiber-and-polyester-resin-compatibility',
  'glass-fiber-for-frp-manufacturing',
  'glass-fiber-storage-and-procurement-guide',
]);
const isGlassFiberAuthorityResource = glassFiberAuthoritySlugs.has(resource.slug);
const pigmentAuthoritySlugs = new Set([
  'what-is-frp-polyester-pigment',
  'applications-of-frp-polyester-pigment',
  'polyester-pigment-paste-vs-gelcoat',
  'pigment-paste-vs-pre-pigmented-polyester-resin',
  'frp-pigment-compatibility-with-resin-systems',
  'frp-colour-variation-buyer-checklist',
  'frp-pigment-storage-and-procurement-guide',
]);
const isPigmentAuthorityResource = pigmentAuthoritySlugs.has(resource.slug);
const epoxyArtAuthoritySlugs = new Set([
  'what-is-epoxy-art-resin',
  'applications-of-epoxy-art-resin',
  'casting-resin-vs-coating-resin',
  'epoxy-art-resin-vs-polyester-resin',
  'epoxy-art-resin-finish-questions',
  'epoxy-art-resin-storage-and-procurement-guide',
  'epoxy-art-resin-buyer-guide',
]);
const isEpoxyArtAuthorityResource = epoxyArtAuthoritySlugs.has(resource.slug);
const epoxyHardenerAuthoritySlugs = new Set([
  'what-is-epoxy-hardener',
  'epoxy-resin-vs-epoxy-hardener',
  'epoxy-hardener-compatibility-guide',
  'epoxy-hardener-vs-mekp-hardener',
  'epoxy-hardener-vs-uv-resin-curing',
  'epoxy-hardener-for-clear-casting-and-art-resin',
  'epoxy-hardener-procurement-guide',
]);
const isEpoxyHardenerAuthorityResource = epoxyHardenerAuthoritySlugs.has(resource.slug);
const fiberglassEpoxyAuthoritySlugs = new Set([
  'what-is-fiberglass-epoxy-resin',
  'fiberglass-epoxy-resin-system-and-hardener',
  'fiberglass-epoxy-resin-vs-clear-casting-and-art-resin',
  'fiberglass-epoxy-resin-vs-polyester-lamination-upr-gp',
  'fiberglass-epoxy-resin-vs-vinyl-ester-resin',
  'fiberglass-epoxy-resin-applications',
  'fiberglass-epoxy-resin-technical-specifications-and-document-check',
  'fiberglass-epoxy-resin-data-vs-finished-composite-performance',
  'fiberglass-epoxy-resin-procurement-checklist',
]);
const isFiberglassEpoxyAuthorityResource = fiberglassEpoxyAuthoritySlugs.has(resource.slug);
const uvResinAuthoritySlugs = new Set([
  'what-is-uv-resin',
  'applications-of-uv-resin',
  'uv-resin-vs-epoxy-art-resin',
  'uv-resin-vs-epoxy-clear-casting-resin',
  'uv-resin-vs-polyester-resin',
  'uv-resin-buyer-guide',
]);
const isUvResinAuthorityResource = uvResinAuthoritySlugs.has(resource.slug);
const sheetGradeAuthoritySlugs = new Set([
  'what-is-sheet-grade-yellow-resin',
  'applications-of-sheet-grade-yellow-resin',
  'sheet-grade-yellow-resin-vs-gp-yellow-resin',
  'sheet-grade-yellow-resin-vs-roof-light-resin',
  'how-to-choose-resin-for-frp-sheet-and-panel-manufacturing',
  'frp-sheet-resin-procurement-guide',
]);
const isSheetGradeAuthorityResource = sheetGradeAuthoritySlugs.has(resource.slug);
const roofLightAuthoritySlugs = new Set([
  'what-is-roof-light-sheet-grade-resin',
  'roof-light-resin-applications-frp-roofing-sheets',
  'roof-light-resin-vs-gp-clear-resin',
  'frp-roofing-sheet-resin-selection-guide',
  'roof-light-resin-procurement-guide',
]);
const isRoofLightAuthorityResource = roofLightAuthoritySlugs.has(resource.slug);
const isoFireRetardantAuthoritySlugs = new Set([
  'what-is-iso-fire-retardant-resin',
  'iso-fire-retardant-resin-vs-fire-retardant-resin',
  'iso-fire-retardant-resin-applications',
  'iso-fire-retardant-resin-vs-upr',
  'iso-fire-retardant-resin-vs-vinyl-ester-resin',
  'iso-fire-retardant-resin-fire-requirements',
  'iso-fire-retardant-resin-procurement-checklist',
]);
const isIsoFireRetardantAuthorityResource = isoFireRetardantAuthoritySlugs.has(resource.slug);
const petResinAuthoritySlugs = new Set([
  'what-is-pet-modified-polyester-resin',
  'pet-resin-liquid-grade-vs-thermoplastic-pet',
  'pet-resin-applications-sheet-lamination-and-panels',
  'pet-resin-vs-gp-resin',
  'pet-resin-vs-lamination-resin',
]);
const isPetResinAuthorityResource = petResinAuthoritySlugs.has(resource.slug);
const marbleResinAuthoritySlugs = new Set([
  'what-is-marble-resin',
  'marble-resin-raw-resin-vs-finished-marble-composite',
  'marble-resin-applications-cultured-marble-artificial-stone',
  'gp-quartz-resin-vs-marble-resin',
  'marble-resin-vs-pet-resin',
  'marble-resin-vs-gp-resin',
  'marble-resin-vs-epoxy-clear-casting-resin',
  'marble-resin-technical-specifications-and-rfq',
]);
const isMarbleResinAuthorityResource = marbleResinAuthoritySlugs.has(resource.slug);
const vinylEsterAuthoritySlugs = new Set([
  'what-is-vinyl-ester-resin',
  'vinyl-ester-resin-vs-isophthalic-resin',
  'vinyl-ester-resin-vs-epoxy-resin',
  'vinyl-ester-resin-for-chemical-service-frp',
  'vinyl-ester-resin-technical-specifications',
  'vinyl-ester-resin-procurement-checklist',
]);
const isVinylEsterAuthorityResource = vinylEsterAuthoritySlugs.has(resource.slug);
const bisphenolAuthoritySlugs = new Set([
  'what-is-bisphenol-resin',
  'bisphenol-resin-applications',
  'bisphenol-resin-vs-upr-and-gp-resin',
  'bisphenol-resin-vs-epoxy-resin',
  'bisphenol-resin-data-vs-finished-component-performance',
  'bisphenol-resin-procurement-checklist',
]);
const isBisphenolAuthorityResource = bisphenolAuthoritySlugs.has(resource.slug);
const dmcSmcAuthoritySlugs = new Set([
  'what-is-dmc-smc-resin',
  'dmc-vs-smc',
  'smc-resin-vs-sheet-grade-resin',
  'dmc-smc-resin-vs-gp-resin',
  'dmc-smc-resin-applications',
  'dmc-smc-resin-technical-specifications',
  'dmc-smc-resin-procurement-checklist',
]);
const isDmcSmcAuthorityResource = dmcSmcAuthoritySlugs.has(resource.slug);
const talkToTeamLink = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(isDmcSmcAuthorityResource
  ? "Hi, I'd like to discuss a DMC/SMC Resin requirement with Samrat Poly Resins. My DMC or SMC context, finished component, specification, quantity, delivery location and documentation requirement are:"
  : isMarbleResinAuthorityResource
  ? "Hi, I'd like to discuss a Marble Resin requirement with Samrat Poly Resins. My finished marble or stone product, TDS or catalogue reference, appearance or technical requirement, quantity, delivery location and documentation requirement are:"
  : isPetResinAuthorityResource
  ? "Hi, I'd like to discuss Samrat PET Resin. My required material form, intended sheet or laminate application, documentation requirement, quantity and delivery location are:"
  : isVinylEsterAuthorityResource
  ? "Hi, I'd like to discuss a Vinyl Ester Resin requirement with Samrat Poly Resins. My finished FRP component, service medium and concentration where relevant, operating temperature where relevant, technical-document requirement, quantity and delivery location are:"
  : isBisphenolAuthorityResource
  ? "Hi, I'd like to discuss a Bisphenol Resin requirement with Samrat Poly Resins. My intended application, stated technical requirement, service conditions where relevant, quantity, delivery location and documentation requirement are:"
  : isIsoFireRetardantAuthorityResource
  ? "Hi, I'd like to discuss an ISO Fire Retardant Resin requirement with Samrat Poly Resins. The ISO designation refers to isophthalic chemistry. My FRP component, required documentation or fire requirement, quantity and delivery location are:"
  : isGlassFiberAuthorityResource
  ? "Hi, I'd like to discuss a Glass Fiber / CSM reinforcement requirement with Samrat Poly Resins."
  : isPigmentAuthorityResource
  ? "Hi, I'd like to discuss an FRP Polyester Pigment requirement with Samrat Poly Resins."
  : isUvResinAuthorityResource
  ? "Hi, I'd like to discuss a UV Resin requirement with Samrat Poly Resins."
  : isSheetGradeAuthorityResource
  ? "Hi, I'd like to discuss a Sheet Grade Yellow Resin requirement for an FRP sheet or panel with Samrat Poly Resins."
  : isRoofLightAuthorityResource
  ? "Hi, I'd like to discuss a Roof Light Sheet Grade Resin requirement for an FRP roofing or roof-light sheet with Samrat Poly Resins."
  : isEpoxyArtAuthorityResource
  ? "Hi, I'd like to discuss an Epoxy Art Resin requirement with Samrat Poly Resins."
  : isFiberglassEpoxyAuthorityResource
  ? "Hi, I'd like to discuss a Fiberglass Epoxy Resin requirement with Samrat Poly Resins. My finished composite application, resin-only or complete-system requirement, document reference, reinforcement form if known, quantity, delivery location and documentation requirement are:"
  : isEpoxyHardenerAuthorityResource
  ? "Hi, I'd like to discuss a compatible Epoxy Hardener and epoxy resin-system requirement with Samrat Poly Resins. My exact resin product, intended application, quantity and delivery location are:"
  : isButtonAuthorityResource
  ? "Hi, I'd like to discuss a Button Grade Resin application with Samrat Poly Resins."
  : isGpQuartzAuthorityResource
  ? "Hi, I'd like to discuss a GP Quartz Resin requirement with Samrat Poly Resins."
  : isGpWhiteAuthorityResource
  ? "Hi, I'd like to discuss a GP White Resin requirement with Samrat Poly Resins."
  : isUprAuthorityResource
  ? "Hi, I'd like help selecting the right Unsaturated Polyester Resin grade from Samrat Poly Resins."
  : isGelcoatAuthorityResource
  ? "Hi, I'd like to discuss a Gelcoat Resin application with Samrat Poly Resins."
  : isLaminationAuthorityResource
  ? "Hi, I'd like to discuss a Lamination Resin application with Samrat Poly Resins."
  : isGpYellowUsesResource
  ? "Hi, I'd like to discuss a GP Yellow Resin application with Samrat Poly Resins."
  : isGpAuthorityResource
    ? "Hi, I'd like to discuss a GP Resin application with Samrat Poly Resins."
    : "Hi, I'd like help selecting the right polyester resin for my requirement.")}`;
const readingTime = getReadingTime(resource);

const published = resources.filter((r) => !r.draft);

const relatedArticles = (relatedSlugs ?? [])
  .map((slug) => published.find((r) => r.slug === slug))
  .filter(Boolean);

const currentIndex = published.findIndex((r) => r.slug === resource.slug);
const prevArticle = currentIndex > 0 ? published[currentIndex - 1] : null;
const nextArticle = currentIndex >= 0 && currentIndex < published.length - 1 ? published[currentIndex + 1] : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishDate,
  dateModified: publishDate,
  author: { "@type": "Organization", name: site.name },
  publisher: { "@type": "Organization", name: site.name },
  mainEntityOfPage: canonicalUrl,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: buildCanonicalUrl('/') },
    { "@type": "ListItem", position: 2, name: "Resources", item: buildCanonicalUrl('/resources/') },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
  ],
};

const faqJsonLd = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<Base
  title={resource.seo?.title ?? title}
  description={description}
  ogType="article"
  ogTitle={resource.seo?.ogTitle}
  ogDescription={resource.seo?.ogDescription}
  keywords={resource.seo?.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <ReadingProgress />

  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span class="cur">{title}</span>
  </div>

  <article class="wrap article">
    <header class="article-head">
      <span class="article-icon" aria-hidden="true"><ResourceIcon name={icon} /></span>
      <p class="article-category">{category}</p>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
      <div class="article-meta">
        <span>Published {formattedDate}</span>
        <span class="article-meta-sep" aria-hidden="true">•</span>
        <span>{readingTime}</span>
      </div>
    </header>

    <div class="article-body">
      <aside class="article-toc">
        {quickFacts && <QuickFacts facts={quickFacts} />}
        <TableOfContents sections={sections} />
      </aside>

      <div class="article-content">
        {linkedProduct && <ProductCTA product={linkedProduct} />}
        {sections.map((s) => {
          const isRich = typeof s !== 'string';
          const heading = isRich ? s.heading : s;
          const table = isRich && s.table ? resource[s.table] : null;
          const photoModule = isRich && s.photo ? resolveSharedPhoto(s.photo.src) : null;
          return (
            <section class="article-section" id={toId(heading)}>
              <h2>{heading}</h2>
              {!isRich && <p class="article-placeholder">Detailed technical content for this section will be added here.</p>}
              {isRich && s.body && s.body.map((para) => <p>{para}</p>)}
              {photoModule && (
                <figure class="article-photo">
                  <Image src={photoModule} alt={s.photo.alt} widths={[400, 800, 1200]} sizes="(max-width: 900px) 100vw, 700px" loading="lazy" />
                  {s.photo.caption && <figcaption>{s.photo.caption}</figcaption>}
                </figure>
              )}
              {table && <DataTable headers={table.headers} rows={table.rows} note={table.note} />}
              {isRich && s.visuals && s.visuals.map((visual) => (
                visual.type === 'steps' ? (
                  <div class="process-block">
                    <ol class="process-list">
                      {visual.items.map((item, i) => (
                        <li class="process-step">
                          <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
                          <span class="process-label">{item.label}</span>
                        </li>
                      ))}
                    </ol>
                    {visual.branchItems && (
                      <div class="process-branch">
                        <p class="process-branch-label">{visual.branchLabel}</p>
                        <div class="process-branch-chips">
                          {visual.branchItems.map((b) => <span class="process-chip">{b}</span>)}
                        </div>
                      </div>
                    )}
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : visual.type === 'icongrid' ? (
                  <div class="diagram-block">
                    <div class="diagram-icongrid">
                      {visual.items.map((item) => (
                        <div class="diagram-icon-card">
                          <span class="diagram-icon" aria-hidden="true"><TechIcon name={item.icon} /></span>
                          <span class="diagram-icon-label">{item.label}</span>
                        </div>
                      ))}
                    </div>
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : null
              ))}
              {isRich && s.subsections && s.subsections.map((sub) => (
                <div class="article-subsection">
                  <h3>{sub.heading}</h3>
                  <p>{sub.body}</p>
                </div>
              ))}
              {isRich && s.visualsAfter && s.visualsAfter.map((visual) => (
                visual.type === 'steps' ? (
                  <div class="process-block">
                    <ol class="process-list">
                      {visual.items.map((item, i) => (
                        <li class="process-step">
                          <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
                          <span class="process-label">{item.label}</span>
                        </li>
                      ))}
                    </ol>
                    {visual.branchItems && (
                      <div class="process-branch">
                        <p class="process-branch-label">{visual.branchLabel}</p>
                        <div class="process-branch-chips">
                          {visual.branchItems.map((b) => <span class="process-chip">{b}</span>)}
                        </div>
                      </div>
                    )}
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : visual.type === 'icongrid' ? (
                  <div class="diagram-block">
                    <div class="diagram-icongrid">
                      {visual.items.map((item) => (
                        <div class="diagram-icon-card">
                          <span class="diagram-icon" aria-hidden="true"><TechIcon name={item.icon} /></span>
                          <span class="diagram-icon-label">{item.label}</span>
                        </div>
                      ))}
                    </div>
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : null
              ))}
              {isRich && s.callouts && s.callouts.map((c) => (
                <Callout label={c.label} variant={c.variant}>
                  {c.text && <p>{c.text}</p>}
                  {c.items && <ul>{c.items.map((item) => <li>{item}</li>)}</ul>}
                </Callout>
              ))}
            </section>
          );
        })}
      </div>
    </div>

    {comparisonTable && (
      <section class="article-compare">
        <h2>{comparisonTable.title}</h2>
        <DataTable headers={comparisonTable.headers} rows={comparisonTable.rows} note={comparisonTable.note} />
      </section>
    )}

    {faqs && (
      <section class="article-faq">
        <h2>Frequently Asked Questions</h2>
        <FaqAccordion faqs={faqs} />
      </section>
    )}

    {relatedArticles.length > 0 && (
      <section class="article-related">
        <h2>Related Articles</h2>
        <div class="article-related-grid">
          {relatedArticles.map((r) => (
