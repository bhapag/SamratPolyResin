---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import QuickFacts from '../../components/QuickFacts.astro';
import DataTable from '../../components/DataTable.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import ResourceIcon from '../../components/ResourceIcon.astro';
import TechIcon from '../../components/TechIcon.astro';
import Callout from '../../components/Callout.astro';
import { resources, getReadingTime } from '../../data/resources.js';
import { site, buildCanonicalUrl } from '../../data/site.js';

export function getStaticPaths() {
  return resources.filter((r) => !r.draft).map((r) => ({ params: { slug: r.slug }, props: { resource: r } }));
}

// Real photography used inline in article bodies (see `photo` on a section)
// lives alongside the other real site photos in src/assets/ — resolved here,
// by filename, the same way ProductCard.astro resolves product photos.
const sharedPhotoModules = {
  ...import.meta.glob('/src/assets/facility/*', { eager: true }),
  ...import.meta.glob('/src/assets/quality/*', { eager: true }),
  ...import.meta.glob('/src/assets/about/*', { eager: true }),
};
const resolveSharedPhoto = (filename) => {
  const entry = Object.entries(sharedPhotoModules).find(([path]) => path.endsWith(`/${filename}`));
  return entry?.[1]?.default;
};

const { resource } = Astro.props;
const { title, description, icon, category, publishDate, sections, quickFacts, comparisonTable, faqs, relatedSlugs, recommendedLinks = [] } = resource;

const toId = (heading) => heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const formattedDate = new Date(publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);
const gpAuthoritySlugs = new Set([
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'gp-clear-resin-vs-gp-yellow-resin',
  'gp-resin-vs-lamination-resin',
  'gp-resin-vs-vinyl-ester-resin',
  'gp-resin-vs-gelcoat-resin',
  'why-gp-resin-turns-yellow',
  'why-polyester-resin-remains-sticky-or-tacky',
  'how-to-reduce-shrinkage-in-gp-resin-applications',
  'gp-resin-viscosity-explained',
  'gp-yellow-resin-uses-in-frp-manufacturing',
]);
const isGpAuthorityResource = gpAuthoritySlugs.has(resource.slug);
const isGpYellowUsesResource = resource.slug === 'gp-yellow-resin-uses-in-frp-manufacturing';
const gpWhiteAuthoritySlugs = new Set([
  'what-is-gp-white-resin',
  'applications-of-gp-white-resin',
  'gp-white-resin-vs-gp-clear-resin',
  'gp-white-resin-vs-gelcoat-resin',
  'gp-white-resin-buyer-guide',
]);
const isGpWhiteAuthorityResource = gpWhiteAuthoritySlugs.has(resource.slug);
const laminationAuthoritySlugs = new Set([
  'gp-resin-vs-lamination-resin',
  'what-is-lamination-resin',
  'applications-of-lamination-resin',
  'lamination-resin-for-hand-lay-up',
  'lamination-resin-vs-vinyl-ester-resin',
  'lamination-resin-vs-gelcoat-resin',
  'common-lamination-defects-in-frp',
]);
const isLaminationAuthorityResource = laminationAuthoritySlugs.has(resource.slug);
const gelcoatAuthoritySlugs = new Set([
  'what-is-gel-coat-resin',
  'gp-resin-vs-gelcoat-resin',
  'lamination-resin-vs-gelcoat-resin',
  'gelcoat-resin-vs-vinyl-ester-resin',
  'gelcoat-resin-vs-epoxy-resin',
  'applications-of-gelcoat-resin-in-frp-manufacturing',
  'how-to-choose-gelcoat-resin-for-frp-products',
  'gelcoat-resin-problems-peeling-cracking-tackiness',
  'gelcoat-resin-storage-and-handling-guide',
]);
const isGelcoatAuthorityResource = gelcoatAuthoritySlugs.has(resource.slug);
const buttonAuthoritySlugs = new Set([
  'what-is-button-grade-resin',
  'button-resin-for-polyester-button-manufacturing',
  'how-to-choose-resin-for-button-manufacturing',
  'button-grade-resin-vs-gp-resin',
  'button-grade-resin-vs-clear-casting-resin',
  'button-resin-gel-time-and-viscosity-guide',
  'button-resin-storage-and-quote-guide',
  'button-resin-processing-checklist',
]);
const isButtonAuthorityResource = buttonAuthoritySlugs.has(resource.slug);
const uprAuthoritySlugs = new Set([
  'what-is-unsaturated-polyester-resin',
  'types-of-unsaturated-polyester-resin',
  'unsaturated-polyester-resin-vs-vinyl-ester-resin',
  'unsaturated-polyester-resin-vs-epoxy-resin',
  'polyester-resin-procurement-checklist',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'how-to-store-unsaturated-polyester-resin',
]);
const isUprAuthorityResource = uprAuthoritySlugs.has(resource.slug);
const talkToTeamLink = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(isButtonAuthorityResource
  ? "Hi, I'd like to discuss a Button Grade Resin application with Samrat Poly Resins."
  : isGpWhiteAuthorityResource
  ? "Hi, I'd like to discuss a GP White Resin requirement with Samrat Poly Resins."
  : isUprAuthorityResource
  ? "Hi, I'd like help selecting the right Unsaturated Polyester Resin grade from Samrat Poly Resins."
  : isGelcoatAuthorityResource
  ? "Hi, I'd like to discuss a Gelcoat Resin application with Samrat Poly Resins."
  : isLaminationAuthorityResource
  ? "Hi, I'd like to discuss a Lamination Resin application with Samrat Poly Resins."
  : isGpYellowUsesResource
  ? "Hi, I'd like to discuss a GP Yellow Resin application with Samrat Poly Resins."
  : isGpAuthorityResource
    ? "Hi, I'd like to discuss a GP Resin application with Samrat Poly Resins."
    : "Hi, I'd like help selecting the right polyester resin for my requirement.")}`;
const readingTime = getReadingTime(resource);

const published = resources.filter((r) => !r.draft);

const relatedArticles = (relatedSlugs ?? [])
  .map((slug) => published.find((r) => r.slug === slug))
  .filter(Boolean);

const currentIndex = published.findIndex((r) => r.slug === resource.slug);
const prevArticle = currentIndex > 0 ? published[currentIndex - 1] : null;
const nextArticle = currentIndex >= 0 && currentIndex < published.length - 1 ? published[currentIndex + 1] : null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  datePublished: publishDate,
  dateModified: publishDate,
  author: { "@type": "Organization", name: site.name },
  publisher: { "@type": "Organization", name: site.name },
  mainEntityOfPage: canonicalUrl,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: buildCanonicalUrl('/') },
    { "@type": "ListItem", position: 2, name: "Resources", item: buildCanonicalUrl('/resources/') },
    { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
  ],
};

const faqJsonLd = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<Base
  title={resource.seo?.title ?? title}
  description={description}
  ogType="article"
  ogTitle={resource.seo?.ogTitle}
  ogDescription={resource.seo?.ogDescription}
  keywords={resource.seo?.keywords}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <ReadingProgress />

  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><a href="/resources/">Resources</a><span>/</span><span class="cur">{title}</span>
  </div>

  <article class="wrap article">
    <header class="article-head">
      <span class="article-icon" aria-hidden="true"><ResourceIcon name={icon} /></span>
      <p class="article-category">{category}</p>
      <h1>{title}</h1>
      <p class="article-lead">{description}</p>
      <div class="article-meta">
        <span>Published {formattedDate}</span>
        <span class="article-meta-sep" aria-hidden="true">•</span>
        <span>{readingTime}</span>
      </div>
    </header>

    <div class="article-body">
      <aside class="article-toc">
        {quickFacts && <QuickFacts facts={quickFacts} />}
        <TableOfContents sections={sections} />
      </aside>

      <div class="article-content">
        {sections.map((s) => {
          const isRich = typeof s !== 'string';
          const heading = isRich ? s.heading : s;
          const table = isRich && s.table ? resource[s.table] : null;
          const photoModule = isRich && s.photo ? resolveSharedPhoto(s.photo.src) : null;
          return (
            <section class="article-section" id={toId(heading)}>
              <h2>{heading}</h2>
              {!isRich && <p class="article-placeholder">Detailed technical content for this section will be added here.</p>}
              {isRich && s.body && s.body.map((para) => <p>{para}</p>)}
              {photoModule && (
                <figure class="article-photo">
                  <Image src={photoModule} alt={s.photo.alt} widths={[400, 800, 1200]} sizes="(max-width: 900px) 100vw, 700px" loading="lazy" />
                  {s.photo.caption && <figcaption>{s.photo.caption}</figcaption>}
                </figure>
              )}
              {table && <DataTable headers={table.headers} rows={table.rows} note={table.note} />}
              {isRich && s.visuals && s.visuals.map((visual) => (
                visual.type === 'steps' ? (
                  <div class="process-block">
                    <ol class="process-list">
                      {visual.items.map((item, i) => (
                        <li class="process-step">
                          <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
                          <span class="process-label">{item.label}</span>
                        </li>
                      ))}
                    </ol>
                    {visual.branchItems && (
                      <div class="process-branch">
                        <p class="process-branch-label">{visual.branchLabel}</p>
                        <div class="process-branch-chips">
                          {visual.branchItems.map((b) => <span class="process-chip">{b}</span>)}
                        </div>
                      </div>
                    )}
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : visual.type === 'icongrid' ? (
                  <div class="diagram-block">
                    <div class="diagram-icongrid">
                      {visual.items.map((item) => (
                        <div class="diagram-icon-card">
                          <span class="diagram-icon" aria-hidden="true"><TechIcon name={item.icon} /></span>
                          <span class="diagram-icon-label">{item.label}</span>
                        </div>
                      ))}
                    </div>
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : null
              ))}
              {isRich && s.subsections && s.subsections.map((sub) => (
                <div class="article-subsection">
                  <h3>{sub.heading}</h3>
                  <p>{sub.body}</p>
                </div>
              ))}
              {isRich && s.visualsAfter && s.visualsAfter.map((visual) => (
                visual.type === 'steps' ? (
                  <div class="process-block">
                    <ol class="process-list">
                      {visual.items.map((item, i) => (
                        <li class="process-step">
                          <span class="process-num">{String(i + 1).padStart(2, '0')}</span>
                          <span class="process-label">{item.label}</span>
                        </li>
                      ))}
                    </ol>
                    {visual.branchItems && (
                      <div class="process-branch">
                        <p class="process-branch-label">{visual.branchLabel}</p>
                        <div class="process-branch-chips">
                          {visual.branchItems.map((b) => <span class="process-chip">{b}</span>)}
                        </div>
                      </div>
                    )}
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : visual.type === 'icongrid' ? (
                  <div class="diagram-block">
                    <div class="diagram-icongrid">
                      {visual.items.map((item) => (
                        <div class="diagram-icon-card">
                          <span class="diagram-icon" aria-hidden="true"><TechIcon name={item.icon} /></span>
                          <span class="diagram-icon-label">{item.label}</span>
                        </div>
                      ))}
                    </div>
                    {visual.caption && <p class="diagram-caption">{visual.caption}</p>}
                  </div>
                ) : null
              ))}
              {isRich && s.callouts && s.callouts.map((c) => (
                <Callout label={c.label} variant={c.variant}>
                  {c.text && <p>{c.text}</p>}
                  {c.items && <ul>{c.items.map((item) => <li>{item}</li>)}</ul>}
                </Callout>
              ))}
            </section>
          );
        })}
      </div>
    </div>

    {comparisonTable && (
      <section class="article-compare">
        <h2>{comparisonTable.title}</h2>
        <DataTable headers={comparisonTable.headers} rows={comparisonTable.rows} note={comparisonTable.note} />
      </section>
    )}

    {faqs && (
      <section class="article-faq">
        <h2>Frequently Asked Questions</h2>
        <FaqAccordion faqs={faqs} />
      </section>
    )}

    {relatedArticles.length > 0 && (
      <section class="article-related">
        <h2>Related Articles</h2>
        <div class="article-related-grid">
          {relatedArticles.map((r) => (
            <a href={`/resources/${r.slug}/`} class="article-related-card">
              <span class="article-related-cat">{r.category}</span>
              <span class="article-related-title">{r.title}</span>
              <span class="article-related-desc">{r.description}</span>
              <span class="article-related-foot">
                <span class="article-related-time">{getReadingTime(r)}</span>
                <span class="article-related-arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    {recommendedLinks.length > 0 && (
      <section class="article-recommended-links">
        <h2>Relevant products and guides</h2>
        <div class="article-recommended-grid">
          {recommendedLinks.map((link) => (
            <a href={link.href} class="article-recommended-card">
              <span class="article-recommended-label">{link.label}</span>
              <span class="article-recommended-description">{link.description}</span>
              <span class="article-recommended-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {(prevArticle || nextArticle) && (
      <nav class="article-prevnext" aria-label="Article navigation">
        {prevArticle ? (
          <a href={`/resources/${prevArticle.slug}/`} class="prevnext-link prevnext-prev">
            <span class="prevnext-dir">← Previous Article</span>
            <span class="prevnext-title">{prevArticle.title}</span>
          </a>
        ) : <span />}
        {nextArticle && (
          <a href={`/resources/${nextArticle.slug}/`} class="prevnext-link prevnext-next">
            <span class="prevnext-dir">Next Article →</span>
            <span class="prevnext-title">{nextArticle.title}</span>
          </a>
        )}
      </nav>
    )}

    <section class="article-cta">
      <h2>{isButtonAuthorityResource ? 'Discuss your Button Grade Resin application with Samrat Poly Resins' : isGpWhiteAuthorityResource ? 'Discuss your GP White Resin requirement with Samrat Poly Resins' : isUprAuthorityResource ? 'Discuss your Unsaturated Polyester Resin requirement with Samrat Poly Resins' : isGelcoatAuthorityResource ? 'Discuss your Gelcoat Resin application with Samrat Poly Resins' : isLaminationAuthorityResource ? 'Discuss your Lamination Resin application with Samrat Poly Resins' : isGpYellowUsesResource ? 'Discuss your GP Yellow Resin application with Samrat Poly Resins' : isGpAuthorityResource ? 'Discuss your GP Resin application with Samrat Poly Resins' : 'Need help selecting the right polyester resin?'}</h2>
      <p>{isButtonAuthorityResource ? 'Share the intended button or small decorative moulding, clarity or pigment-colour requirement, casting method if known, quantity and delivery location so the requirement can be understood before a quote discussion.' : isGpWhiteAuthorityResource ? 'Share the FRP component, whether water-white supplied appearance or a visible surface finish is required, manufacturing process, quantity and delivery location so the relevant published product role can be discussed before a quote discussion.' : isUprAuthorityResource ? 'Share the component, process, required product role or finish, any stated specification, quantity and delivery location so the relevant published resin grade can be discussed before a quote discussion.' : isGelcoatAuthorityResource ? 'Share the moulded component, surface-finish requirement, application method, quantity and delivery location so the requirement can be understood before a quote discussion.' : isLaminationAuthorityResource ? 'Share the component, substrate or reinforcement, process, quantity and delivery location so the requirement can be understood before a quote discussion.' : isGpYellowUsesResource ? 'Share the FRP component, production method, quantity, finished-build-up context and delivery location so the requirement can be understood before a quote discussion.' : isGpAuthorityResource ? 'Share the application, process, quantity and delivery location so the requirement can be understood before a quote discussion.' : 'Our technical team can help you choose the most suitable resin for your manufacturing requirements.'}</p>
      <div class="article-cta-buttons">
        <a href="/contact/" class="btn btn-solid">{isButtonAuthorityResource ? 'Discuss Button Grade Resin' : isGpWhiteAuthorityResource ? 'Discuss GP White Resin' : isUprAuthorityResource ? 'Discuss UPR requirement' : isGelcoatAuthorityResource ? 'Discuss Gelcoat Resin application' : isLaminationAuthorityResource ? 'Discuss Lamination Resin application' : isGpYellowUsesResource ? 'Discuss GP Yellow Resin application' : isGpAuthorityResource ? 'Discuss GP Resin application' : 'Request a Quote'}</a>
        <a href={talkToTeamLink} class="btn btn-wa" target="_blank" rel="noopener">{isButtonAuthorityResource || isGpWhiteAuthorityResource || isUprAuthorityResource || isGelcoatAuthorityResource || isLaminationAuthorityResource || isGpAuthorityResource ? 'WhatsApp Samrat Poly Resins' : 'Contact Technical Team'}</a>
        {isGpWhiteAuthorityResource && <a href="/products/gp-white-resin/" class="btn">View GP White Resin</a>}
        {isGpWhiteAuthorityResource && <a href="/tds/gp-white-resin-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download GP White Resin TDS</a>}
        {isGpWhiteAuthorityResource && <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>}
        {isUprAuthorityResource && <a href="/products/unsaturated-polyester-resin/" class="btn">View UPR product hub</a>}
        {isUprAuthorityResource && <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>}
        {isButtonAuthorityResource && <a href="/tds/button-grade-resin-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download Button Grade Resin TDS</a>}
        {isButtonAuthorityResource && <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>}
        {isGpYellowUsesResource && <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>}
      </div>
    </section>
  </article>

  <style>
    .crumb {
      display: flex; gap: 0.6rem; align-items: center; padding-top: 1.5rem;
      font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-faint); letter-spacing: 0.04em;
    }
    .crumb a { transition: color .25s var(--ease-premium); }
    .crumb a:hover { color: var(--accent-gold-light); }
    .crumb .cur { color: var(--ink-dim); }

    .article { padding-block: 2.6rem 4rem; max-width: 900px; }
    .article-head { padding-bottom: 2.6rem; border-bottom: 1px solid var(--line); }
    .article-icon {
      display: flex; align-items: center; justify-content: center;
      width: 48px; height: 48px; color: var(--accent-gold); margin-bottom: 1.4rem;
    }
    .article-icon :global(svg) { width: 28px; height: 28px; }
    .article-category {
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--accent-gold); font-weight: 500;
    }
    .article-head h1 { font-size: clamp(2rem, 5vw, 3rem); margin-top: 0.9rem; text-transform: none; letter-spacing: 0; }
    .article-lead { color: var(--ink-dim); margin-top: 1.3rem; font-size: 1.05rem; max-width: 56ch; line-height: 1.7; }
    .article-meta {
      display: flex; align-items: center; gap: 0.6rem; margin-top: 1.6rem;
      font-family: var(--font-mono); font-size: 0.76rem; color: var(--ink-faint); letter-spacing: 0.03em;
    }
    .article-meta-sep { color: var(--line-2); }

    .article-body { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(2rem, 5vw, 3.5rem); margin-top: 3rem; align-items: start; }
    .article-toc { position: sticky; top: 90px; }

    .article-section { margin-bottom: 3.2rem; scroll-margin-top: 90px; }
    .article-section h2 { font-size: clamp(1.35rem, 3vw, 1.8rem); margin-bottom: 1.1rem; }
    .article-section p { color: var(--ink-dim); margin-bottom: 1.2rem; max-width: 70ch; line-height: 1.75; }
    .article-placeholder { color: var(--ink-faint); font-style: italic; font-size: 0.94rem; }

    .article-photo {
      border: 1px solid var(--image-frame-border); border-radius: 14px; overflow: hidden;
      margin-block: 1.6rem; box-shadow: var(--image-frame-shadow);
      transition: box-shadow .4s var(--ease-premium);
    }
    .article-photo:hover { box-shadow: 0 1px 0 rgba(255, 255, 255, .08) inset, 0 22px 48px rgba(0, 0, 0, .46); }
    .article-photo img { width: 100%; height: auto; display: block; transition: transform .5s var(--ease-premium); }
    .article-photo:hover img { transform: scale(1.035); }
    .article-photo figcaption {
      padding: 0.7rem 0.9rem; border-top: 1px solid var(--line); background: var(--bg-3);
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--ink-faint);
    }

    .article-subsection { margin-top: 1.6rem; }
    .article-subsection h3 { font-size: 1.05rem; margin-bottom: 0.5rem; text-transform: none; letter-spacing: 0; color: var(--ink); }
    .article-subsection p { color: var(--ink-dim); margin-bottom: 0; max-width: 70ch; }

    .process-block, .diagram-block {
      background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); border-radius: 14px;
      padding: clamp(1.4rem, 4vw, 2rem); margin-block: 1.6rem;
    }
    .process-list { list-style: none; display: flex; flex-wrap: nowrap; align-items: stretch; gap: 1.4rem; }
    .process-step {
      position: relative; flex: 1 1 0; min-width: 0;
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.45rem;
      padding: 1.1rem 0.7rem; background: var(--bg); border: 1px solid var(--line); border-top: 2px solid var(--accent-gold);
    }
    .process-step:not(:last-child)::after {
      content: '→'; position: absolute; right: -1.3rem; top: 50%; transform: translateY(-50%);
      color: var(--accent-gold); font-size: 1.1rem; line-height: 1;
    }
    .process-num { font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.08em; color: var(--accent-gold-light); }
    .process-label { font-size: 0.9rem; color: var(--ink); font-weight: 600; }
    /* Wrapping and the direction swap always happen together at the same
       breakpoint, so an arrow never points at empty space where an item wrapped away. */
    @media (max-width: 700px) {
      .process-list { flex-direction: column; flex-wrap: wrap; }
      .process-step { flex: 1 1 auto; }
      .process-step:not(:last-child)::after {
        content: '↓'; right: auto; left: 50%; top: auto; bottom: -1.1rem; transform: translateX(-50%);
