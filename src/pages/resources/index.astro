    /* min(280px, 100%) instead of a bare 280px — at extreme narrow widths
       (~320px, once nested .kc-focus padding is subtracted) a plain
       minmax(280px, 1fr) track forces itself 1px wider than the available
       row, overflowing the page by that 1px; capping the minimum at the
       container's own width removes the forced overshoot. */
    /* Tuned for the compact rows this index now uses (see ResourceCard).
       The old 280px/1.4rem track was sized for tall panels; at ~72px a row
       the same gap left the list looking like scattered chips rather than a
       directory. */

    /* ---------- hub jump navigation ---------- */
    .kc-jump { padding-block: clamp(1.5rem, 4vw, 2.4rem) 0; }
    .kc-jump-title { font-size: clamp(1.1rem, 2.4vw, 1.4rem); }
    .kc-jump-note { color: var(--ink-dim); font-size: 0.86rem; margin-top: 0.5rem; }
    .kc-jump-list {
      list-style: none; margin: 1.1rem 0 0; padding: 0;
      display: flex; flex-wrap: wrap; gap: 0.5rem;
    }
    .kc-jump-list a {
      display: inline-block; padding: 0.44rem 0.8rem;
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.03em;
      color: var(--ink-dim); background: var(--bg-3);
      border: 1px solid var(--line);
      transition: border-color .3s var(--ease-premium), color .3s var(--ease-premium);
    }
    .kc-jump-list a:hover, .kc-jump-list a:focus-visible {
      border-color: var(--line-2); color: var(--ink);
    }
    /* The header is sticky, so an anchor jump would otherwise land the
       heading underneath it. */
    .kc-focus { scroll-margin-top: 5.5rem; }
    .kc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(320px, 100%), 1fr)); gap: 0.6rem; }
    .kc-focus { padding: clamp(1.4rem, 4vw, 2.2rem); background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); }
    .kc-focus-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.4rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .kc-focus h2, .kc-other h2 { font-size: clamp(1.45rem, 3vw, 2rem); margin-top: 0.55rem; }
    .kc-focus p:not(.eyebrow) { color: var(--ink-dim); margin-top: 0.75rem; max-width: 65ch; }
    .kc-focus-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .kc-subgroups { display: grid; gap: 1.4rem; }
    .kc-subgroup h3 { font-size: 1rem; text-transform: none; letter-spacing: 0; margin-bottom: 1rem; color: var(--ink); }
    .kc-epoxy-application-links { padding-top: 0.4rem; }
