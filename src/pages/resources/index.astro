---
import Base from '../../layouts/Base.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { resources } from '../../data/resources.js';
import { site } from '../../data/site.js';

const published = resources.filter((r) => !r.draft);
const gpAuthoritySlugs = new Set([
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'gp-clear-resin-vs-gp-yellow-resin',
  'gp-resin-vs-vinyl-ester-resin',
  'gp-resin-vs-gelcoat-resin',
  'why-gp-resin-turns-yellow',
  'why-polyester-resin-remains-sticky-or-tacky',
  'how-to-reduce-shrinkage-in-gp-resin-applications',
  'gp-resin-viscosity-explained',
  'gp-yellow-resin-uses-in-frp-manufacturing',
]);
const gpYellowAuthoritySlugs = new Set([
  'gp-yellow-resin-uses-in-frp-manufacturing',
  'gp-clear-resin-vs-gp-yellow-resin',
  'why-gp-resin-turns-yellow',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
]);
const gpYellowAuthorityResources = published.filter((resource) => gpYellowAuthoritySlugs.has(resource.slug));
const gpAuthorityResources = published.filter((resource) => gpAuthoritySlugs.has(resource.slug) && !gpYellowAuthoritySlugs.has(resource.slug));
const laminationAuthoritySlugs = new Set([
  'gp-resin-vs-lamination-resin',
  'what-is-lamination-resin',
  'applications-of-lamination-resin',
  'lamination-resin-for-hand-lay-up',
  'lamination-resin-vs-vinyl-ester-resin',
  'lamination-resin-vs-gelcoat-resin',
  'common-lamination-defects-in-frp',
]);
const laminationAuthorityResources = published.filter((resource) => laminationAuthoritySlugs.has(resource.slug));
const gelcoatAuthoritySlugs = new Set([
  'what-is-gel-coat-resin',
  'gp-resin-vs-gelcoat-resin',
  'lamination-resin-vs-gelcoat-resin',
  'gelcoat-resin-vs-vinyl-ester-resin',
  'gelcoat-resin-vs-epoxy-resin',
  'applications-of-gelcoat-resin-in-frp-manufacturing',
  'how-to-choose-gelcoat-resin-for-frp-products',
  'gelcoat-resin-problems-peeling-cracking-tackiness',
  'gelcoat-resin-storage-and-handling-guide',
]);
const gelcoatAuthorityResources = published.filter((resource) => gelcoatAuthoritySlugs.has(resource.slug));
const buttonAuthoritySlugs = new Set([
  'what-is-button-grade-resin',
  'button-resin-for-polyester-button-manufacturing',
  'how-to-choose-resin-for-button-manufacturing',
  'button-grade-resin-vs-gp-resin',
  'button-grade-resin-vs-clear-casting-resin',
  'button-resin-gel-time-and-viscosity-guide',
  'button-resin-storage-and-quote-guide',
  'button-resin-processing-checklist',
]);
const buttonAuthorityResources = published.filter((resource) => buttonAuthoritySlugs.has(resource.slug));
const otherResources = published.filter((resource) => !gpAuthoritySlugs.has(resource.slug) && !laminationAuthoritySlugs.has(resource.slug) && !gelcoatAuthoritySlugs.has(resource.slug) && !buttonAuthoritySlugs.has(resource.slug));
---
<Base
  title="Knowledge Centre"
  description="Technical articles, application guides and educational resources on polyester resin manufacturing, industrial applications and best practices."
>
  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><span class="cur">Resources</span>
  </div>

  <section class="section kc-hero">
    <div class="wrap">
      <p class="eyebrow">Technical Resources</p>
      <h1>Knowledge Centre</h1>
      <p class="kc-hero-sub">Technical articles, application guides and educational resources on polyester resin manufacturing, industrial applications and best practices.</p>
    </div>
  </section>

  <section class="section kc-downloads">
    <div class="wrap">
      <div class="kc-downloads-card">
        <span class="kc-downloads-icon" aria-hidden="true">📘</span>
        <div class="kc-downloads-body">
          <h2 class="kc-downloads-title">{site.catalogue.title}</h2>
          <p class="kc-downloads-desc">{site.catalogue.description}</p>
          <p class="kc-downloads-meta">PDF · {site.catalogue.sizeLabel}</p>
        </div>
        <a
          href={site.catalogue.url}
          class="btn btn-solid"
          target="_blank"
          rel="noopener"
          download
          aria-label={`Download ${site.catalogue.title} (PDF)`}
        >
          Download Catalogue
        </a>
      </div>
    </div>
  </section>

  <section class="section kc-list">
    <div class="wrap">
      {gpYellowAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="gp-yellow-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gp-yellow-resin-hub-heading">GP Yellow Resin Knowledge Hub</h2>
              <p>Explore published GP Yellow Resin uses, grade comparison, colour guidance, gel-time, storage and selection resources before discussing an FRP requirement with Samrat Poly Resins, a Punjab-based manufacturer established in 2017.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-yellow-resin/" class="btn btn-solid">View GP Yellow Resin</a>
              <a href="/contact/" class="btn">Discuss your GP Yellow Resin application</a>
            </div>
          </div>
          <div class="kc-grid">
            {gpYellowAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {buttonAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="button-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="button-resin-hub-heading">Button Grade Resin Knowledge Hub</h2>
              <p>Explore Button Grade Resin selection, button-manufacturing context, product-role comparisons, published processing data, storage and quote-preparation guides before discussing a casting requirement with Samrat Poly Resins.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/button-grade-resin/" class="btn btn-solid">View Button Grade Resin</a>
              <a href="/tds/button-grade-resin-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download Button Grade Resin TDS</a>
              <a href="/contact/" class="btn">Discuss your Button Grade Resin requirement</a>
            </div>
          </div>
          <div class="kc-grid">
            {buttonAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {gpAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="gp-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gp-resin-hub-heading">GP Resin Knowledge Hub</h2>
              <p>Explore GP Resin selection, application, comparison and troubleshooting guides for both clear and transparent-yellow general-purpose grades before discussing a requirement with Samrat Poly Resins.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-clear-resin/" class="btn btn-solid">View GP Clear Resin</a>
              <a href="/products/gp-yellow-resin/" class="btn">View GP Yellow Resin</a>
              <a href="/contact/" class="btn">Discuss an application</a>
            </div>
          </div>
          <div class="kc-grid">
            {gpAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {laminationAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="lamination-resin-guides-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="lamination-resin-guides-heading">Lamination Resin Knowledge Hub</h2>
              <p>Explore LR Resin selection, applications, process guidance, comparisons and troubleshooting before discussing a lamination requirement with Samrat Poly Resins.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/lamination-resin/" class="btn btn-solid">View Lamination Resin</a>
              <a href="/contact/" class="btn">Discuss your Lamination Resin application</a>
            </div>
          </div>
          <div class="kc-grid">
            {laminationAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {gelcoatAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="gelcoat-resin-guides-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gelcoat-resin-guides-heading">Gelcoat Resin Knowledge Hub</h2>
              <p>Explore Gelcoat Resin roles, FRP applications, comparisons, selection guidance, troubleshooting and storage context before discussing a surface-finish requirement with Samrat Poly Resins, a Punjab-based manufacturer established in 2017.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-gelcoat-resin/" class="btn btn-solid">View GP Gelcoat Resin</a>
              <a href="/contact/" class="btn">Discuss a Gelcoat application</a>
            </div>
          </div>
          <div class="kc-grid">
            {gelcoatAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {otherResources.length > 0 && (
        <section class="kc-other" aria-labelledby="all-resources-heading">
          <div class="kc-other-head">
            <p class="eyebrow">More technical resources</p>
            <h2 id="all-resources-heading">All other guides</h2>
          </div>
          <div class="kc-grid">
            {otherResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}
    </div>
  </section>

  <style>
    .crumb {
      display: flex; gap: 0.6rem; align-items: center; padding-top: 1.5rem;
      font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-faint); letter-spacing: 0.04em;
    }
    .crumb a:hover { color: var(--accent-gold-light); }
    .crumb .cur { color: var(--ink-dim); }

    .kc-hero { padding-bottom: 0; }
    .kc-hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin-top: 0.6rem; }
    .kc-hero-sub { color: var(--ink-dim); margin-top: 0.9rem; max-width: 60ch; }

    .kc-downloads { padding-bottom: 0; }
    .kc-downloads-card {
      display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap;
      padding: 1.4rem 1.6rem; background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
    }
    .kc-downloads-icon { font-size: 2rem; flex-shrink: 0; line-height: 1; }
    .kc-downloads-body { flex: 1; min-width: 200px; }
    .kc-downloads-title { font-size: 1.05rem; color: var(--ink); text-transform: none; letter-spacing: 0; }
    .kc-downloads-desc { color: var(--ink-dim); font-size: 0.9rem; margin-top: 0.4rem; max-width: 60ch; }
    .kc-downloads-meta {
      font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-faint);
      margin-top: 0.6rem; letter-spacing: 0.04em; text-transform: uppercase;
    }

    .kc-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.4rem; }
    .kc-focus { padding: clamp(1.4rem, 4vw, 2.2rem); background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); }
    .kc-focus-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.4rem; flex-wrap: wrap; margin-bottom: 1.8rem; }
    .kc-focus h2, .kc-other h2 { font-size: clamp(1.45rem, 3vw, 2rem); margin-top: 0.55rem; }
    .kc-focus p:not(.eyebrow) { color: var(--ink-dim); margin-top: 0.75rem; max-width: 65ch; }
    .kc-focus-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .kc-other { margin-top: clamp(3rem, 7vw, 5rem); }
    .kc-other-head { margin-bottom: 1.5rem; }
  </style>
</Base>
