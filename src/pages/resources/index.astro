---
import Base from '../../layouts/Base.astro';
import ResourceCard from '../../components/ResourceCard.astro';
import { resources } from '../../data/resources.js';
import { site } from '../../data/site.js';

const published = resources.filter((r) => !r.draft);
const gpAuthoritySlugs = new Set([
  'what-is-gp-polyester-resin',
  'applications-of-gp-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'gp-clear-resin-vs-gp-yellow-resin',
  'gp-resin-vs-vinyl-ester-resin',
  'gp-resin-vs-gelcoat-resin',
  'why-gp-resin-turns-yellow',
  'why-polyester-resin-remains-sticky-or-tacky',
  'how-to-reduce-shrinkage-in-gp-resin-applications',
  'gp-resin-viscosity-explained',
  'gp-yellow-resin-uses-in-frp-manufacturing',
]);
const gpYellowAuthoritySlugs = new Set([
  'gp-yellow-resin-uses-in-frp-manufacturing',
  'gp-clear-resin-vs-gp-yellow-resin',
  'why-gp-resin-turns-yellow',
  'understanding-gel-time-in-polyester-resin',
  'how-to-store-unsaturated-polyester-resin',
  'how-to-select-polyester-resin-for-frp-manufacturing',
]);
const gpYellowAuthorityResources = published.filter((resource) => gpYellowAuthoritySlugs.has(resource.slug));
const gpAuthorityResources = published.filter((resource) => gpAuthoritySlugs.has(resource.slug) && !gpYellowAuthoritySlugs.has(resource.slug));
const gpWhiteAuthoritySlugs = new Set([
  'what-is-gp-white-resin',
  'applications-of-gp-white-resin',
  'gp-white-resin-vs-gp-clear-resin',
  'gp-white-resin-vs-gelcoat-resin',
  'gp-white-resin-buyer-guide',
]);
const gpWhiteAuthorityResources = published.filter((resource) => gpWhiteAuthoritySlugs.has(resource.slug));
const gpQuartzAuthoritySlugs = new Set([
  'what-is-gp-quartz-resin',
  'gp-quartz-resin-uses-engineered-stone-mineral-composites',
  'gp-quartz-resin-vs-gp-clear-resin',
  'gp-quartz-resin-vs-marble-resin',
  'gp-quartz-resin-viscosity-gel-time-storage-guide',
  'gp-quartz-resin-buyer-guide',
]);
const gpQuartzAuthorityResources = published.filter((resource) => gpQuartzAuthoritySlugs.has(resource.slug));
const gpQuartzFoundationResources = published.filter((resource) => [
  'what-is-gp-quartz-resin',
  'gp-quartz-resin-uses-engineered-stone-mineral-composites',
].includes(resource.slug));
const gpQuartzComparisonResources = published.filter((resource) => [
  'gp-quartz-resin-vs-gp-clear-resin',
  'gp-quartz-resin-vs-marble-resin',
].includes(resource.slug));
const gpQuartzTechnicalResources = published.filter((resource) => [
  'gp-quartz-resin-viscosity-gel-time-storage-guide',
  'gp-quartz-resin-buyer-guide',
].includes(resource.slug));
const laminationAuthoritySlugs = new Set([
  'gp-resin-vs-lamination-resin',
  'what-is-lamination-resin',
  'applications-of-lamination-resin',
  'lamination-resin-for-hand-lay-up',
  'lamination-resin-vs-vinyl-ester-resin',
  'lamination-resin-vs-gelcoat-resin',
  'common-lamination-defects-in-frp',
]);
const laminationAuthorityResources = published.filter((resource) => laminationAuthoritySlugs.has(resource.slug));
const gelcoatAuthoritySlugs = new Set([
  'what-is-gel-coat-resin',
  'gp-resin-vs-gelcoat-resin',
  'lamination-resin-vs-gelcoat-resin',
  'gelcoat-resin-vs-vinyl-ester-resin',
  'gelcoat-resin-vs-epoxy-resin',
  'applications-of-gelcoat-resin-in-frp-manufacturing',
  'how-to-choose-gelcoat-resin-for-frp-products',
  'gelcoat-resin-problems-peeling-cracking-tackiness',
  'gelcoat-resin-storage-and-handling-guide',
]);
const gelcoatAuthorityResources = published.filter((resource) => gelcoatAuthoritySlugs.has(resource.slug));
const buttonAuthoritySlugs = new Set([
  'what-is-button-grade-resin',
  'button-resin-for-polyester-button-manufacturing',
  'how-to-choose-resin-for-button-manufacturing',
  'button-grade-resin-vs-gp-resin',
  'button-grade-resin-vs-clear-casting-resin',
  'button-resin-gel-time-and-viscosity-guide',
  'button-resin-storage-and-quote-guide',
  'button-resin-processing-checklist',
]);
const buttonAuthorityResources = published.filter((resource) => buttonAuthoritySlugs.has(resource.slug));
const uprAuthoritySlugs = new Set([
  'what-is-unsaturated-polyester-resin',
  'types-of-unsaturated-polyester-resin',
  'unsaturated-polyester-resin-vs-vinyl-ester-resin',
  'unsaturated-polyester-resin-vs-epoxy-resin',
  'polyester-resin-procurement-checklist',
  'how-to-select-polyester-resin-for-frp-manufacturing',
  'how-to-store-unsaturated-polyester-resin',
]);
const uprAuthorityResources = published.filter((resource) => uprAuthoritySlugs.has(resource.slug));
const glassFiberAuthoritySlugs = new Set([
  'what-is-glass-fiber-chopped-strand-mat',
  'csm-300-vs-csm-450-glass-fiber',
  'glass-fiber-and-polyester-resin-compatibility',
  'glass-fiber-for-frp-manufacturing',
  'glass-fiber-storage-and-procurement-guide',
]);
const glassFiberAuthorityResources = published.filter((resource) => glassFiberAuthoritySlugs.has(resource.slug));
const glassFiberFoundationResources = published.filter((resource) => [
  'what-is-glass-fiber-chopped-strand-mat',
  'csm-300-vs-csm-450-glass-fiber',
].includes(resource.slug));
const glassFiberSystemResources = published.filter((resource) => [
  'glass-fiber-and-polyester-resin-compatibility',
  'glass-fiber-for-frp-manufacturing',
].includes(resource.slug));
const glassFiberProcurementResources = published.filter((resource) => [
  'glass-fiber-storage-and-procurement-guide',
].includes(resource.slug));
const pigmentAuthoritySlugs = new Set([
  'what-is-frp-polyester-pigment',
  'applications-of-frp-polyester-pigment',
  'polyester-pigment-paste-vs-gelcoat',
  'pigment-paste-vs-pre-pigmented-polyester-resin',
  'frp-pigment-compatibility-with-resin-systems',
  'frp-colour-variation-buyer-checklist',
  'frp-pigment-storage-and-procurement-guide',
]);
const pigmentAuthorityResources = published.filter((resource) => pigmentAuthoritySlugs.has(resource.slug));
const pigmentFoundationResources = published.filter((resource) => [
  'what-is-frp-polyester-pigment',
  'applications-of-frp-polyester-pigment',
].includes(resource.slug));
const pigmentSystemResources = published.filter((resource) => [
  'polyester-pigment-paste-vs-gelcoat',
  'pigment-paste-vs-pre-pigmented-polyester-resin',
  'frp-pigment-compatibility-with-resin-systems',
].includes(resource.slug));
const pigmentBuyerResources = published.filter((resource) => [
  'frp-colour-variation-buyer-checklist',
  'frp-pigment-storage-and-procurement-guide',
].includes(resource.slug));
const gpAuthorityResourcesWithoutUpr = gpAuthorityResources.filter((resource) => !uprAuthoritySlugs.has(resource.slug));
const otherResources = published.filter((resource) => !gpAuthoritySlugs.has(resource.slug) && !gpWhiteAuthoritySlugs.has(resource.slug) && !gpQuartzAuthoritySlugs.has(resource.slug) && !laminationAuthoritySlugs.has(resource.slug) && !gelcoatAuthoritySlugs.has(resource.slug) && !buttonAuthoritySlugs.has(resource.slug) && !uprAuthoritySlugs.has(resource.slug) && !glassFiberAuthoritySlugs.has(resource.slug) && !pigmentAuthoritySlugs.has(resource.slug));
---
<Base
  title="Knowledge Centre"
  description="Technical articles, application guides and educational resources on polyester resin manufacturing, industrial applications and best practices."
>
  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><span class="cur">Resources</span>
  </div>

  <section class="section kc-hero">
    <div class="wrap">
      <p class="eyebrow">Technical Resources</p>
      <h1>Knowledge Centre</h1>
      <p class="kc-hero-sub">Technical articles, application guides and educational resources on polyester resin manufacturing, industrial applications and best practices.</p>
    </div>
  </section>

  <section class="section kc-downloads">
    <div class="wrap">
      <div class="kc-downloads-card">
        <span class="kc-downloads-icon" aria-hidden="true">📘</span>
        <div class="kc-downloads-body">
          <h2 class="kc-downloads-title">{site.catalogue.title}</h2>
          <p class="kc-downloads-desc">{site.catalogue.description}</p>
          <p class="kc-downloads-meta">PDF · {site.catalogue.sizeLabel}</p>
        </div>
        <a
          href={site.catalogue.url}
          class="btn btn-solid"
          target="_blank"
          rel="noopener"
          download
          aria-label={`Download ${site.catalogue.title} (PDF)`}
        >
          Download Catalogue
        </a>
      </div>
    </div>
  </section>

  <section class="section kc-list">
    <div class="wrap">
      {uprAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="upr-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Parent category knowledge hub</p>
              <h2 id="upr-resin-hub-heading">Unsaturated Polyester Resin Knowledge Hub</h2>
              <p>Use this parent-category route to understand UPR, compare published resin systems, choose a product role, review the relevant product data and prepare an enquiry for GP, Lamination, Gelcoat, Button, Fire Retardant or Vinyl Ester requirements.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/unsaturated-polyester-resin/" class="btn btn-solid">View Unsaturated Polyester Resin</a>
              <a href="/contact/" class="btn">Discuss your UPR requirement</a>
              <a href="/about/" class="btn">About Samrat Poly Resins</a>
            </div>
          </div>
          <div class="kc-grid">
            {uprAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {gpWhiteAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="gp-white-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gp-white-resin-hub-heading">GP White Resin Knowledge Hub</h2>
              <p>Explore the published water-white GP grade, supported FRP applications, GP White comparisons, and the linked selection, gel-time, viscosity, storage and quotation guidance before reviewing the GP White Resin TDS.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-white-resin/" class="btn btn-solid">View GP White Resin</a>
              <a href="/tds/gp-white-resin-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download GP White Resin TDS</a>
              <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>
              <a href="/contact/" class="btn">Discuss your GP White Resin requirement</a>
            </div>
          </div>
          <div class="kc-grid">
            {gpWhiteAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {gpQuartzAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="gp-quartz-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gp-quartz-resin-hub-heading">GP Quartz Resin Knowledge Hub</h2>
              <p>Explore the published GP Quartz Resin role for artificial quartz stone, engineered stone slabs and composite mineral surfaces; then compare the relevant product role, review the technical data and prepare a focused quotation discussion.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-quartz-resin/" class="btn btn-solid">View GP Quartz Resin</a>
              <a href="/tds/gp-quartz-resin-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download GP Quartz Resin TDS</a>
              <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>
              <a href="/about/" class="btn">About Samrat Poly Resins</a>
              <a href="/contact/" class="btn">Discuss a quartz-resin requirement</a>
            </div>
          </div>
          <div class="kc-subgroups">
            <section class="kc-subgroup" aria-labelledby="gp-quartz-foundation-heading">
              <h3 id="gp-quartz-foundation-heading">Start with the product role and published uses</h3>
              <div class="kc-grid">
                {gpQuartzFoundationResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
            <section class="kc-subgroup" aria-labelledby="gp-quartz-comparisons-heading">
              <h3 id="gp-quartz-comparisons-heading">Compare the relevant resin roles</h3>
              <div class="kc-grid">
                {gpQuartzComparisonResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
            <section class="kc-subgroup" aria-labelledby="gp-quartz-data-heading">
              <h3 id="gp-quartz-data-heading">Review technical data and prepare a quote</h3>
              <div class="kc-grid">
                {gpQuartzTechnicalResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
          </div>
        </section>
      )}

      {glassFiberAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="glass-fiber-guides-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Reinforcement knowledge hub</p>
              <h2 id="glass-fiber-guides-heading">Glass Fiber / CSM Knowledge Hub</h2>
              <p>Start with the published E-Glass Chopped Strand Mat range and CSM 300/450 comparison, then review the FRP material-system context before using the TDS and preparing a focused Glass Fiber enquiry.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/fibre-glass-mat/" class="btn btn-solid">View Glass Fiber Mat</a>
              <a href="/tds/fibre-glass-mat-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download Glass Fiber TDS</a>
              <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>
              <a href="/contact/" class="btn">Discuss your reinforcement requirement with Samrat</a>
            </div>
          </div>
          <div class="kc-subgroups">
            <section class="kc-subgroup" aria-labelledby="glass-fiber-foundation-heading">
              <h3 id="glass-fiber-foundation-heading">1. Understand the material and compare mat weight</h3>
              <div class="kc-grid">
                {glassFiberFoundationResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
            <section class="kc-subgroup" aria-labelledby="glass-fiber-system-heading">
              <h3 id="glass-fiber-system-heading">2. Define the FRP component and material-system role</h3>
              <div class="kc-grid">
                {glassFiberSystemResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
            <section class="kc-subgroup" aria-labelledby="glass-fiber-procurement-heading">
              <h3 id="glass-fiber-procurement-heading">3. Review storage and prepare the procurement discussion</h3>
              <div class="kc-grid">
                {glassFiberProcurementResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
          </div>
        </section>
      )}

      {pigmentAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="frp-pigment-guides-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Colour-system knowledge hub</p>
              <h2 id="frp-pigment-guides-heading">FRP Polyester Pigment Knowledge Hub</h2>
              <p>Start with the published polyester pigment-paste role, then distinguish pigment, resin and gelcoat decisions, review compatibility against the actual system, document appearance questions and prepare a focused quotation discussion.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/frp-polyester-pigment/" class="btn btn-solid">View FRP Polyester Pigment</a>
              <a href="/tds/frp-polyester-pigment-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download Pigment TDS</a>
              <a href={site.catalogue.url} class="btn" target="_blank" rel="noopener" download>Download Product Catalogue</a>
              <a href="/about/" class="btn">About Samrat Poly Resins</a>
              <a href="/contact/" class="btn">Discuss an FRP pigment requirement</a>
            </div>
          </div>
          <div class="kc-subgroups">
            <section class="kc-subgroup" aria-labelledby="frp-pigment-foundation-heading">
              <h3 id="frp-pigment-foundation-heading">1. Define the pigment-paste role and application context</h3>
              <div class="kc-grid">
                {pigmentFoundationResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
            <section class="kc-subgroup" aria-labelledby="frp-pigment-system-heading">
              <h3 id="frp-pigment-system-heading">2. Compare product roles and check the actual system</h3>
              <div class="kc-grid">
                {pigmentSystemResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
            <section class="kc-subgroup" aria-labelledby="frp-pigment-buyer-heading">
              <h3 id="frp-pigment-buyer-heading">3. Document colour questions and prepare procurement details</h3>
              <div class="kc-grid">
                {pigmentBuyerResources.map((resource) => <ResourceCard resource={resource} />)}
              </div>
            </section>
          </div>
        </section>
      )}

      {gpYellowAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="gp-yellow-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gp-yellow-resin-hub-heading">GP Yellow Resin Knowledge Hub</h2>
              <p>Explore published GP Yellow Resin uses, grade comparison, colour guidance, gel-time, storage and selection resources before discussing an FRP requirement with Samrat Poly Resins, a Punjab-based manufacturer established in 2017.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-yellow-resin/" class="btn btn-solid">View GP Yellow Resin</a>
              <a href="/contact/" class="btn">Discuss your GP Yellow Resin application</a>
            </div>
          </div>
          <div class="kc-grid">
            {gpYellowAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {buttonAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="button-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="button-resin-hub-heading">Button Grade Resin Knowledge Hub</h2>
              <p>Explore Button Grade Resin selection, button-manufacturing context, product-role comparisons, published processing data, storage and quote-preparation guides before discussing a casting requirement with Samrat Poly Resins.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/button-grade-resin/" class="btn btn-solid">View Button Grade Resin</a>
              <a href="/tds/button-grade-resin-tds.pdf" class="btn" target="_blank" rel="noopener" download>Download Button Grade Resin TDS</a>
              <a href="/contact/" class="btn">Discuss your Button Grade Resin requirement</a>
            </div>
          </div>
          <div class="kc-grid">
            {buttonAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {gpAuthorityResourcesWithoutUpr.length > 0 && (
        <section class="kc-focus" aria-labelledby="gp-resin-hub-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gp-resin-hub-heading">GP Resin Knowledge Hub</h2>
              <p>Explore GP Resin selection, application, comparison and troubleshooting guides for both clear and transparent-yellow general-purpose grades before discussing a requirement with Samrat Poly Resins.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-clear-resin/" class="btn btn-solid">View GP Clear Resin</a>
              <a href="/products/gp-yellow-resin/" class="btn">View GP Yellow Resin</a>
              <a href="/contact/" class="btn">Discuss an application</a>
            </div>
          </div>
          <div class="kc-grid">
            {gpAuthorityResourcesWithoutUpr.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {laminationAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="lamination-resin-guides-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="lamination-resin-guides-heading">Lamination Resin Knowledge Hub</h2>
              <p>Explore LR Resin selection, applications, process guidance, comparisons and troubleshooting before discussing a lamination requirement with Samrat Poly Resins.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/lamination-resin/" class="btn btn-solid">View Lamination Resin</a>
              <a href="/contact/" class="btn">Discuss your Lamination Resin application</a>
            </div>
          </div>
          <div class="kc-grid">
            {laminationAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {gelcoatAuthorityResources.length > 0 && (
        <section class="kc-focus" aria-labelledby="gelcoat-resin-guides-heading">
          <div class="kc-focus-head">
            <div>
              <p class="eyebrow">Product knowledge hub</p>
              <h2 id="gelcoat-resin-guides-heading">Gelcoat Resin Knowledge Hub</h2>
              <p>Explore Gelcoat Resin roles, FRP applications, comparisons, selection guidance, troubleshooting and storage context before discussing a surface-finish requirement with Samrat Poly Resins, a Punjab-based manufacturer established in 2017.</p>
            </div>
            <div class="kc-focus-actions">
              <a href="/products/gp-gelcoat-resin/" class="btn btn-solid">View GP Gelcoat Resin</a>
              <a href="/contact/" class="btn">Discuss a Gelcoat application</a>
            </div>
          </div>
          <div class="kc-grid">
            {gelcoatAuthorityResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}

      {otherResources.length > 0 && (
        <section class="kc-other" aria-labelledby="all-resources-heading">
          <div class="kc-other-head">
            <p class="eyebrow">More technical resources</p>
            <h2 id="all-resources-heading">All other guides</h2>
          </div>
          <div class="kc-grid">
            {otherResources.map((resource) => <ResourceCard resource={resource} />)}
          </div>
        </section>
      )}
    </div>
  </section>

  <style>
    .crumb {
      display: flex; gap: 0.6rem; align-items: center; padding-top: 1.5rem;
      font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-faint); letter-spacing: 0.04em;
    }
    .crumb a:hover { color: var(--accent-gold-light); }
    .crumb .cur { color: var(--ink-dim); }

    .kc-hero { padding-bottom: 0; }
    .kc-hero h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin-top: 0.6rem; }
    .kc-hero-sub { color: var(--ink-dim); margin-top: 0.9rem; max-width: 60ch; }

    .kc-downloads { padding-bottom: 0; }
    .kc-downloads-card {
      display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap;
      padding: 1.4rem 1.6rem; background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
    }
    .kc-downloads-icon { font-size: 2rem; flex-shrink: 0; line-height: 1; }
    .kc-downloads-body { flex: 1; min-width: 200px; }
    .kc-downloads-title { font-size: 1.05rem; color: var(--ink); text-transform: none; letter-spacing: 0; }
    .kc-downloads-desc { color: var(--ink-dim); font-size: 0.9rem; margin-top: 0.4rem; max-width: 60ch; }
    .kc-downloads-meta {
