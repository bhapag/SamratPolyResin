  { id: 'polyester-putty-resin-hub-heading', label: 'Polyester Putty Resin (putty base)' },
  { id: 'vinyl-ester-resin-hub-heading', label: 'Vinyl Ester Resin' },
  { id: 'bisphenol-resin-hub-heading', label: 'Bisphenol Resin' },
  { id: 'fiberglass-epoxy-resin-hub-heading', label: 'Fiberglass Epoxy Resin' },
  { id: 'epoxy-casting-resin-hub-heading', label: 'Epoxy Clear Casting Resin' },
  { id: 'epoxy-art-resin-hub-heading', label: 'Epoxy Art Resin' },
  { id: 'epoxy-hardener-hub-heading', label: 'Epoxy Hardener' },
  { id: 'mekp-hardener-hub-heading', label: 'MEKP Hardener' },
  { id: 'glass-fiber-guides-heading', label: 'Glass Fiber / CSM' },
  { id: 'frp-pigment-guides-heading', label: 'FRP Polyester Pigment' },
];
