const otherResources = published.filter((resource) => !gpAuthoritySlugs.has(resource.slug) && !gpWhiteAuthoritySlugs.has(resource.slug) && !gpQuartzAuthoritySlugs.has(resource.slug) && !marbleResinAuthoritySlugs.has(resource.slug) && !laminationAuthoritySlugs.has(resource.slug) && !gelcoatAuthoritySlugs.has(resource.slug) && !buttonAuthoritySlugs.has(resource.slug) && !uprAuthoritySlugs.has(resource.slug) && !glassFiberAuthoritySlugs.has(resource.slug) && !pigmentAuthoritySlugs.has(resource.slug) && !mekpAuthoritySlugs.has(resource.slug) && !epoxyHardenerAuthoritySlugs.has(resource.slug) && !fiberglassEpoxyAuthoritySlugs.has(resource.slug) && !epoxyCastingAuthoritySlugs.has(resource.slug) && !epoxyArtAuthoritySlugs.has(resource.slug) && !sheetGradeAuthoritySlugs.has(resource.slug) && !roofLightAuthoritySlugs.has(resource.slug) && !dmcSmcAuthoritySlugs.has(resource.slug) && !petResinAuthoritySlugs.has(resource.slug) && !fireRetardantAuthoritySlugs.has(resource.slug) && !isoFireRetardantAuthoritySlugs.has(resource.slug) && !vinylEsterAuthoritySlugs.has(resource.slug) && !bisphenolAuthoritySlugs.has(resource.slug) && !isoPolyesterAuthoritySlugs.has(resource.slug) && !isoGelcoatAuthoritySlugs.has(resource.slug) && !uvStabilizedAuthoritySlugs.has(resource.slug) && !polyesterPuttyAuthoritySlugs.has(resource.slug));
// Jump navigation for the 24 knowledge hubs below. The Knowledge Centre lists
// every live article on one page; even with the compact rows introduced
// alongside this, that page is 37,539px on a 390px viewport, so a reader
// arriving for one resin family had to scroll past every other family to
// reach it.
//
// Each entry points at the <h2 id> its hub section is already labelled by, so
// this is navigation over existing anchors - no new ids, no markup moved, no
// link removed. `tests/knowledge-centre.spec.ts` asserts every id here
// resolves to a real heading and that no hub section is missing from the
// list, so the two cannot drift apart silently.
const KNOWLEDGE_HUBS = [
  { id: 'upr-resin-hub-heading', label: 'Unsaturated Polyester Resin' },
  { id: 'gp-resin-hub-heading', label: 'GP Resin' },
  { id: 'gp-white-resin-hub-heading', label: 'GP White Resin' },
  { id: 'gp-yellow-resin-hub-heading', label: 'GP Yellow Resin' },
