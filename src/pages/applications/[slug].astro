---
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { applications } from '../../data/applications.js';
import { products } from '../../data/products.js';
import { site, buildProductQuoteLink, buildCanonicalUrl } from '../../data/site.js';

export function getStaticPaths() {
  return applications.filter((a) => !a.draft).map((a) => ({ params: { slug: a.slug }, props: { application: a } }));
}

const appImageModules = import.meta.glob('/src/assets/applications/*', { eager: true });
const resolveAppImage = (filename) => appImageModules[`/src/assets/applications/${filename}`]?.default;

const { application } = Astro.props;
const {
  title, cardImage, cardImageAlt, cardDescription, seo, intro, whatTheyManufacture, whySuitable,
  requiredCharacteristics, manufacturingProcess, advantages, commonProducts,
  faqs, relatedProductSlugs, ctaHeading, ctaText,
  relatedLinksHeading, recommendedLinks,
  ogImage, ogImageAlt, ogImageWidth, ogImageHeight,
} = application;

// Same fixed-aspect-ratio treatment on every application page, whether or
// not this particular entry has a photo yet — one consistent hero container
// (see .app-hero-img below) so the layout never depends on image dimensions.
const heroImgSrc = cardImage ? resolveAppImage(cardImage) : null;
const heroImg = heroImgSrc ? await getImage({ src: heroImgSrc, width: 1000, format: 'webp' }) : null;

// Reverse lookup rather than a hardcoded slug, so the breadcrumb and CTA stay
// correct even if another product later lists this same application.
const parentProduct = products.find((p) => p.applicationSlugs?.includes(application.slug));

const relatedProducts = (relatedProductSlugs ?? [])
  .map((s) => products.find((p) => p.slug === s))
  .filter(Boolean);

const waLink = buildProductQuoteLink(parentProduct?.whatsappName ?? parentProduct?.name ?? site.name);
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname);

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: buildCanonicalUrl('/') },
    ...(parentProduct
      ? [{ "@type": "ListItem", position: 2, name: parentProduct.name, item: buildCanonicalUrl(`/products/${parentProduct.slug}/`) }]
      : []),
    { "@type": "ListItem", position: parentProduct ? 3 : 2, name: title, item: canonicalUrl },
  ],
};

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: seo?.description ?? cardDescription,
  ...(heroImg ? { image: buildCanonicalUrl(heroImg.src) } : {}),
  author: { "@type": "Organization", name: site.name },
  publisher: { "@type": "Organization", name: site.name },
  mainEntityOfPage: canonicalUrl,
};

const faqJsonLd = faqs && faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
} : null;
---
<Base
  title={seo?.title ?? title}
  description={seo?.description ?? cardDescription}
  keywords={seo?.keywords}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}

  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span>
    {parentProduct && (<><a href={`/products/${parentProduct.slug}/`}>{parentProduct.name}</a><span>/</span></>)}
    <span class="cur">{title}</span>
  </div>

  <!-- Full-bleed cinematic hero (real application photo, not a boxed thumbnail)
       — deliberately different from the Resources article template's
       text-first Ledger opening, so an Application page reads as "the plant"
       (a real manufactured thing, in use) rather than a technical document. -->
  <header class:list={['app-hero', { noimg: !heroImg }]}>
    {heroImg && (
      <div class="app-hero-media" aria-hidden="true">
        <img src={heroImg.src} width={heroImg.attributes.width} height={heroImg.attributes.height} alt="" />
      </div>
    )}
    <div class="app-hero-scrim" aria-hidden="true"></div>
    {!heroImg && <span class="app-hero-fallback" aria-hidden="true">{title.split(' ').map(w => w[0]).join('').slice(0, 3)}</span>}
    <div class="wrap app-hero-inner">
      <p class="app-eyebrow">Application guide</p>
      <h1>{title}</h1>
      <p class="app-lead">{intro}</p>
      {parentProduct && <a href={`/products/${parentProduct.slug}/`} class="app-hero-tag">{parentProduct.name}<span aria-hidden="true"> →</span></a>}
    </div>
  </header>

  <article class="wrap app-article">
    <div class="app-content">
      <section class="app-section">
        <h2>What this industry manufactures</h2>
        <p>{whatTheyManufacture}</p>
      </section>

      <section class="app-section">
        <h2>Why {parentProduct?.name ?? 'this resin'} is suitable</h2>
        <p set:html={whySuitable} />
      </section>

      <section class="app-section">
        <h2>Required resin characteristics</h2>
        <ol class="app-specs">{requiredCharacteristics.map((c, i) => (
          <li><span class="app-specs-num">{String(i + 1).padStart(2, '0')}</span><span>{c}</span></li>
        ))}</ol>
      </section>

      <section class="app-section">
        <h2>Manufacturing process</h2>
        <p set:html={manufacturingProcess} />
      </section>

      <section class="app-section">
        <h2>Advantages</h2>
        <ul class="app-list">{advantages.map((a) => <li>{a}</li>)}</ul>
      </section>

      <section class="app-section">
        <h2>Common products produced</h2>
        <ul class="app-list">{commonProducts.map((p) => <li>{p}</li>)}</ul>
      </section>
    </div>

    {faqs && faqs.length > 0 && (
      <section class="app-faq">
        <h2>Frequently asked questions</h2>
        <FaqAccordion faqs={faqs} />
      </section>
    )}

    {relatedProducts.length > 0 && (
      <section class="app-related">
        <h2 class="rel-h">Related products</h2>
        <div class="rel-grid">
          {relatedProducts.map((p) => (
            <a href={`/products/${p.slug}/`} class="rel-card">
              <span class="rel-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 L20 6.5 L20 15.5 L12 20 L4 15.5 L4 6.5 Z" /><path d="M12 11 L12 20" /><path d="M4 6.5 L12 11 L20 6.5" /></svg>
              </span>
              <span class="rel-name">{p.name}</span>
              <span class="rel-price">{site.priceLabel}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    {recommendedLinks && recommendedLinks.length > 0 && (
      <section class="app-related-reading">
        <h2>{relatedLinksHeading ?? 'Related technical resources'}</h2>
        <div class="app-reading-grid">
          {recommendedLinks.map((link) => (
            <a href={link.href} class="app-reading-card">
              <strong>{link.label}</strong>
              <span>{link.description}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="app-cta">
      <h2>{ctaHeading}</h2>
      <p>{ctaText}</p>
      <div class="app-cta-buttons">
        <a href={waLink} class="btn btn-wa" target="_blank" rel="noopener">Request Bulk Quote</a>
        {parentProduct?.tdsUrl && (
          <a href={parentProduct.tdsUrl} class="btn btn-solid" target="_blank" rel="noopener" download
             aria-label={`Download Technical Data Sheet PDF for ${parentProduct.name}`}>
            Download TDS (PDF)
          </a>
        )}
        {parentProduct && <a href={`/products/${parentProduct.slug}/`} class="btn">View {parentProduct.name}</a>}
      </div>
    </section>
  </article>

  <style>
    .crumb {
      display: flex; gap: 0.6rem; align-items: center; padding-top: 1.5rem;
      font-family: var(--font-mono); font-size: 0.74rem; color: var(--ink-faint); letter-spacing: 0.04em;
    }
    .crumb a { transition: color .25s var(--ease-premium); }
    .crumb a:hover { color: var(--accent-gold-light); }
    .crumb .cur { color: var(--ink-dim); }

    .app-article { padding-block: 3rem 4rem; max-width: 800px; }

    /* Full-bleed cinematic hero — same register as the homepage hero (real
       facility/application photography, dimmed, text overlaid) so an
       Application page announces itself as "the plant" before a single
       word of technical copy loads. noimg falls back to a dark gradient
       panel with the title's initials instead of a broken/empty frame. */
    .app-hero { position: relative; overflow: hidden; min-height: clamp(320px, 46vw, 460px); display: flex; align-items: flex-end; }
    .app-hero.noimg { background: linear-gradient(135deg, #171b21, #23282f); }
    .app-hero-media { position: absolute; inset: 0; z-index: 0; }
    .app-hero-media img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(.3) contrast(1.06) brightness(.8); }
    .app-hero-scrim {
      position: absolute; inset: 0; z-index: 1;
      background: linear-gradient(180deg, rgba(9, 11, 18, .35) 0%, rgba(9, 11, 18, .8) 68%, var(--bg) 100%);
    }
    .app-hero.noimg .app-hero-scrim { background: none; }
    .app-hero-fallback {
      position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-weight: 700; font-size: clamp(3rem, 10vw, 6rem); color: var(--line-2);
    }
    .app-hero-inner { position: relative; z-index: 2; padding-block: 2.2rem clamp(2rem, 5vw, 3rem); }
    .app-eyebrow {
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--accent-gold); font-weight: 500;
    }
    .app-hero-inner h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin-top: 0.9rem; text-transform: none; letter-spacing: 0; max-width: 18ch; }
    .app-lead { color: var(--ink-dim); margin-top: 1.1rem; font-size: 1.02rem; max-width: 58ch; line-height: 1.7; }
    .app-hero-tag {
      display: inline-flex; align-items: center; margin-top: 1.3rem;
      font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em; color: var(--ink);
      border: 1px solid var(--line-2); padding: 0.55rem 0.95rem; background: rgba(0, 0, 0, .25);
      transition: border-color .25s var(--ease-premium), color .25s var(--ease-premium);
    }
    .app-hero-tag:hover { border-color: var(--accent-gold); color: var(--accent-gold-light); }

    .app-section { margin-top: 2.6rem; }
    .app-section h2 { font-size: clamp(1.3rem, 3vw, 1.6rem); margin-bottom: 1rem; }
    .app-section p { color: var(--ink-dim); max-width: 72ch; line-height: 1.75; }
    .app-section p a { color: var(--accent-gold-light); text-decoration: underline; text-underline-offset: 2px; transition: color .25s var(--ease-premium); }
    .app-section p a:hover { color: var(--accent-gold); }

    .app-list { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; }
    .app-list li {
      position: relative; padding-left: 1.7rem; color: var(--ink); font-size: 0.95rem; font-weight: 600;
      line-height: 1.6; max-width: 68ch;
      transition: color .25s var(--ease-premium), transform .25s var(--ease-premium);
    }
    .app-list li:hover { color: #ffffff; transform: translateX(3px); }
    .app-list li::before {
      content: '✓'; position: absolute; left: 0; top: 50%; transform: translateY(-50%);
      display: flex; align-items: center; justify-content: center;
      width: 18px; height: 18px; border-radius: 50%;
      background: transparent; border: 1.5px solid var(--line-2);
      color: var(--accent-gold-light); font-size: 0.6rem; font-weight: 700; line-height: 1;
    }

    /* "Required resin characteristics" — a numbered spec list rather than
       another checkmark bullet list, so this section reads as engineering
       requirements, not just more prose bullets. */
    .app-specs { list-style: none; display: flex; flex-direction: column; }
    .app-specs li {
      display: flex; align-items: baseline; gap: 1rem;
      padding: 0.9rem 0; border-top: 1px solid var(--line);
      color: var(--ink); font-size: 0.95rem; line-height: 1.6; max-width: 68ch;
    }
    .app-specs li:last-child { border-bottom: 1px solid var(--line); }
    .app-specs-num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-gold-light); flex-shrink: 0; }

    .app-faq, .app-related, .app-related-reading { margin-top: 3.2rem; }
    .app-faq h2, .app-related h2, .app-related-reading h2 { font-size: clamp(1.3rem, 3vw, 1.6rem); margin-bottom: 1.2rem; }

    .rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.9rem; }
    .rel-card {
      display: flex; flex-direction: column; gap: 0.4rem; padding: 1rem 1.1rem;
      background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
      transition: border-color .3s var(--ease-premium), transform .3s var(--ease-premium), box-shadow .3s var(--ease-premium);
    }
    .rel-card:hover { border-color: var(--line-2); transform: translateY(-2px); box-shadow: var(--surface-shadow-hover); }
    .rel-card:hover .rel-card-icon { color: var(--accent-gold-light); }
    .rel-card-icon { color: var(--ink-faint); transition: color .3s var(--ease-premium); }
    .rel-name { font-family: var(--font-display); text-transform: uppercase; font-size: 0.95rem; }
    .rel-price { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent-gold-light); }
    .app-reading-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 0.9rem; }
    .app-reading-card { display: flex; flex-direction: column; gap: 0.45rem; padding: 1rem 1.1rem; background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); transition: border-color .3s var(--ease-premium), transform .3s var(--ease-premium), box-shadow .3s var(--ease-premium); }
    .app-reading-card:hover { border-color: var(--line-2); transform: translateY(-2px); box-shadow: var(--surface-shadow-hover); }
    .app-reading-card strong { font-family: var(--font-display); text-transform: uppercase; font-size: 0.95rem; }
    .app-reading-card span { color: var(--ink-dim); font-size: 0.86rem; line-height: 1.5; }

    .app-cta {
      margin-top: 3.4rem; padding: clamp(1.8rem, 5vw, 2.6rem);
      background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest);
    }
    .app-cta h2 { font-size: clamp(1.4rem, 3.5vw, 1.9rem); }
    .app-cta p { color: var(--ink-dim); margin-top: 0.8rem; max-width: 55ch; }
    .app-cta-buttons { display: flex; gap: 0.9rem; margin-top: 1.4rem; flex-wrap: wrap; }
  </style>
</Base>
