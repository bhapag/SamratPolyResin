---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { products, CATEGORIES, CATEGORY_HUBS } from '../data/products.js';
import { site, buildCanonicalUrl } from '../data/site.js';
import DocLink from '../components/DocLink.astro';

// A crawlable HTML entry point for the TDS and SDS library.
//
// WHY THIS PAGE EXISTS — measured, not assumed. GA4 recorded 68
// `file_download` events from 16 users in 28 days (2026-08-12 → 2026-09-08),
// and Search Console shows four of these PDFs already earning impressions on
// their own at positions 4–20.5. So the documents are in demand and Google is
// already indexing them — but until now they had no HTML page listing them.
// Every PDF here is one a visitor could already reach from its product page;
// nothing new is published and no new claim is made.
//
// SOURCING RULE: every row is derived from `products.js` (`tdsUrl`/`sdsUrl`,
// `name`, `category`, `slug`) plus the real byte size of the file on disk.
// There is deliberately NO revision date, effective date, version number or
// supersession column: no such field exists anywhere in this repo, and the
// only honest way to publish one would be to read it out of each PDF and
// store it explicitly. Inventing it would be false document metadata.
//
// Products with no published TDS/SDS simply do not appear. There are no
// placeholder rows and no "document coming soon" entries.

const DOC_ROOT = path.resolve('public');

// Real file size, read from disk at build time. If a file is ever missing the
// build fails loudly here rather than shipping a broken download link.
function documentSize(urlPath) {
  const bytes = fs.statSync(path.join(DOC_ROOT, urlPath)).size;
  return bytes >= 1024 * 1024
    ? `${(bytes / (1024 * 1024)).toFixed(1)} MB`
    : `${Math.round(bytes / 1024)} KB`;
}

// Every count here is derived from the product records, never written down.
// Paint Brushes publishes a Product Data Sheet rather than a TDS — it is an
// article, not a chemical product — so it is counted separately and never
// folded into the TDS number. Adding a TDS to a product does not give it an
// SDS, and these three counts are independent for that reason.
const withDocuments = products.filter((p) => p.tdsUrl || p.sdsUrl || p.pdsUrl);
const withoutDocuments = products.filter((p) => !p.tdsUrl && !p.sdsUrl && !p.pdsUrl);

const tdsCount = products.filter((p) => p.tdsUrl).length;
const sdsCount = products.filter((p) => p.sdsUrl).length;
const pdsCount = products.filter((p) => p.pdsUrl).length;
const totalDocuments = tdsCount + sdsCount + pdsCount;

// Grouped in the same category order the rest of the site uses, so this page
// can never present a different product taxonomy from the nav or /products/.
const groups = CATEGORIES.map((category) => ({
  category,
  hub: CATEGORY_HUBS[category] ? `/products/${CATEGORY_HUBS[category]}/` : null,
  items: withDocuments.filter((p) => p.category === category),
})).filter((g) => g.items.length > 0);

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: buildCanonicalUrl('/') },
    { "@type": "ListItem", position: 2, name: "Technical Documents", item: buildCanonicalUrl(Astro.url.pathname) },
  ],
};

// CollectionPage only. No `DigitalDocument` entries: that type's useful
// properties (datePublished, version, encodingFormat specifics) are exactly
// the ones this repo has no data for.
const collectionJsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": buildCanonicalUrl(Astro.url.pathname),
  name: "Technical, Safety & Product Data Sheets",
  url: buildCanonicalUrl(Astro.url.pathname),
  description: `${tdsCount} Technical Data Sheets, ${sdsCount} Safety Data Sheets and ${pdsCount} Product Data Sheet published across ${withDocuments.length} ${site.name} resin and allied product grades.`,
  isPartOf: { "@type": "WebSite", name: site.name, url: site.url },
  about: { "@type": "Thing", name: "Resin technical data sheets and safety data sheets" },
};
---
<Base
  title="Resin TDS & SDS Documents"
  description={`Download ${tdsCount} Technical Data Sheets, ${sdsCount} Safety Data Sheets and ${pdsCount} Product Data Sheet for Samrat Poly Resins polyester, epoxy, gelcoat, fire retardant and allied products.`}
  keywords={['polyester resin TDS', 'resin technical data sheet', 'resin SDS', 'epoxy resin TDS', 'MEKP hardener SDS', 'resin safety data sheet India']}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionJsonLd)} />

  <div class="wrap crumb">
    <a href="/">Home</a><span>/</span><span class="cur">Technical Documents</span>
  </div>

  <section class="section td-hero">
    <div class="wrap td-hero-inner">
      <div>
        <p class="eyebrow">Document library</p>
        <h1>Technical Data Sheets &amp; Safety Data Sheets</h1>
        <p class="td-hero-sub">
          {`Every published data sheet for the ${site.name} range, in one place: ${tdsCount} Technical Data Sheets, ${sdsCount} Safety Data Sheets and ${pdsCount} Product Data Sheet across ${withDocuments.length} of our ${products.length} grades. `}
          Each document is the current sheet for that grade as
          supplied — the same file linked from the grade’s own product page. Download what
          you need before specifying, quoting or handling a material.
        </p>
      </div>
      <div class="td-hero-badge">
        <span class="td-hero-badge-num">{totalDocuments}</span>
        <span class="td-hero-badge-label">Published<br/>Documents</span>
      </div>
    </div>
  </section>

  <section class="section td-what">
    <div class="wrap td-prose">
      <div class="section-head">
        <p class="eyebrow">What each document is</p>
        <h2>TDS and SDS answer different questions</h2>
      </div>
      <div class="td-explain">
        <div class="td-explain-card">
          <h3>Technical Data Sheet (TDS)</h3>
          <p>
            The grade’s published supply properties — the parameters you specify and
            purchase against, such as viscosity, gel time, styrene content and curing
            system. Use it to confirm a grade suits the component and process you are
            making before you order.
          </p>
        </div>
        <div class="td-explain-card">
          <h3>Product Data Sheet (PDS)</h3>
          <p>
            Used where a product is an article rather than a chemical — our application
            brushes, for example. It carries the product specification and the standard it
            is described against. Where no Safety Data Sheet is published for a product,
            none is listed.
          </p>
        </div>
        <div class="td-explain-card">
          <h3>Safety Data Sheet (SDS)</h3>
          <p>
            The hazard, handling, storage, personal-protection, first-aid and disposal
            information for the same material. It is the document your site safety file,
            risk assessment and transport paperwork need — and it should be read before
            anyone handles the drum, not after.
          </p>
        </div>
      </div>
      <p class="td-caveat">
        These sheets state supply parameters and safety information. They are not a
        process specification, and they do not replace your own trial and qualification.
        Confirm dosing, cure schedule and handling against the current sheet before
        production. If you need a parameter that is not published for a grade,{' '}
        <a href="/contact/">ask us</a>{' '}rather than assuming a value.
      </p>
    </div>
  </section>

  {groups.map((group) => (
    <section class="section td-group">
      <div class="wrap">
        <div class="section-head td-group-head">
          <div>
            <p class="eyebrow">{group.items.length} {group.items.length === 1 ? 'grade' : 'grades'}</p>
            <h2>{group.category}</h2>
          </div>
          {group.hub && (
            <a href={group.hub} class="td-group-hub">View all {group.category} →</a>
          )}
        </div>
        <div class="td-table-scroll">
          <table class="td-table" role="table">
            <thead>
              <tr>
                <th scope="col" role="columnheader">Product</th>
                <th scope="col" role="columnheader">Technical / Product Data Sheet</th>
                <th scope="col" role="columnheader">Safety Data Sheet</th>
              </tr>
            </thead>
            <tbody>
              {group.items.map((p) => (
                <tr>
                  <th scope="row" role="rowheader"><a href={`/products/${p.slug}/`}>{p.name}</a></th>
                  {/* A product publishes EITHER a TDS or, where it is an article
                      rather than a chemical, a PDS. Showing "Not published" for a
                      grade that does have a document, just a different kind of
                      one, would be wrong — so the cell renders whichever exists
                      under its own correct label. */}
                  <td role="cell">
                    {p.tdsUrl || p.pdsUrl ? (
                      <a href={p.tdsUrl || p.pdsUrl} class="td-doc" target="_blank" rel="noopener" download
                         aria-label={`Download ${p.name} ${p.tdsUrl ? 'Technical' : 'Product'} Data Sheet (PDF, ${documentSize(p.tdsUrl || p.pdsUrl)})${p.tdsNote ? `. ${p.tdsNote}` : ''}`}>
                        <span class="td-doc-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12"/><path d="M6.5 10.5 12 16l5.5-5.5"/><path d="M5 20h14"/></svg>
                        </span>
                        <span class="td-doc-kind">{p.tdsUrl ? 'TDS' : 'PDS'}</span>
                        <span class="td-doc-name">{p.tdsUrl ? 'Technical Data Sheet' : 'Product Data Sheet'}</span>
                        <span class="td-doc-meta">PDF · {documentSize(p.tdsUrl || p.pdsUrl)}</span>
                      </a>
                    ) : (
                      <span class="td-none">Technical Data Sheet not published</span>
                    )}
                    {p.tdsUrl && p.tdsNote && <p class="td-doc-caution">{p.tdsNote}</p>}
                  </td>
                  {/* No published SDS: the cell stays empty. No "not published" or
                      "not applicable" text stands in for a missing document. */}
                  <td role="cell" class:list={[!p.sdsUrl && 'td-cell-empty']}>
                    {p.sdsUrl && (
                      <a href={p.sdsUrl} class="td-doc" target="_blank" rel="noopener" download
                         aria-label={`Download ${p.name} Safety Data Sheet (PDF, ${documentSize(p.sdsUrl)})`}>
                        <span class="td-doc-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4v12"/><path d="M6.5 10.5 12 16l5.5-5.5"/><path d="M5 20h14"/></svg>
                        </span>
                        <span class="td-doc-kind">SDS</span>
                        <span class="td-doc-name">Safety Data Sheet</span>
                        <span class="td-doc-meta">PDF · {documentSize(p.sdsUrl)}</span>
                      </a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>
  ))}

  {withoutDocuments.length > 0 && (
    <section class="section td-missing">
      <div class="wrap td-prose">
        <div class="section-head">
          <p class="eyebrow">Not listed above</p>
          <h2>Grades without a published sheet</h2>
        </div>
        <p>
          {withoutDocuments.length} products in the range do not currently have a TDS, PDS or
          SDS published on this site:{' '}
          {withoutDocuments.map((p, i) => (
            <>
              {i > 0 && ', '}
              <a href={`/products/${p.slug}/`}>{p.name}</a>
            </>
          ))}. Their product pages carry the details that are published. If you need
          documentation for one of them,{' '}
          <a href="/contact/">request it directly</a>{' '}and we will tell you what is
          available.
        </p>
      </div>
    </section>
  )}

  <section class="section td-enquire">
    <div class="wrap td-enquire-inner">
      <div class="section-head">
        <p class="eyebrow">Enquiry</p>
        <h2>Need a document that isn’t here?</h2>
        <p class="td-enquiry-note">
          Tell us the grade, the component you are making and the quantity, and we will
          confirm the right grade and send its current documentation.
        </p>
      </div>
      <div class="td-enquire-box">
        <EnquiryForm pageContext="technical-documents" messagePlaceholder="Grade, document needed, application, quantity" />
      </div>
      <DocLink kind="range" href={site.catalogue.url} title={site.catalogue.title} note="Browse the product range" class="td-doc-link" />
    </div>
  </section>

  <style>
    .td-hero { padding-bottom: 0; }
    .td-hero-inner { display: flex; align-items: flex-start; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
    .td-hero h1 { font-size: clamp(2rem, 5.5vw, 3.2rem); margin-top: 0.6rem; }
    .td-hero-sub { color: var(--ink-dim); margin-top: 1rem; max-width: 68ch; line-height: 1.7; }
    .td-hero-badge {
      flex-shrink: 0; display: flex; flex-direction: column; align-items: center; text-align: center;
      padding: 1.4rem 1.8rem; border: 1px solid var(--line-2); background: var(--bg-3);
      box-shadow: var(--surface-shadow-rest);
    }
    .td-hero-badge-num { font-family: var(--font-display); font-size: 2.4rem; font-weight: 700; color: var(--accent-gold-light); line-height: 1; }
    .td-hero-badge-label {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-faint); margin-top: 0.6rem; line-height: 1.5;
    }

    .td-prose { max-width: 78ch; }
    .td-prose p { color: var(--ink-dim); line-height: 1.8; margin-top: 1rem; }
    .td-explain { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.2rem; margin-top: 1.6rem; }
    .td-explain-card { border: 1px solid var(--line-2); background: var(--bg-3); padding: 1.4rem 1.5rem; box-shadow: var(--surface-shadow-rest); }
    .td-explain-card h3 { font-size: 1.05rem; }
    .td-explain-card p { margin-top: 0.7rem; font-size: 0.94rem; }
    .td-caveat {
      margin-top: 1.6rem; padding: 1rem 1.2rem; border-left: 2px solid var(--accent-gold);
      background: var(--bg-3); font-size: 0.92rem;
    }

    .td-group-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
    .td-group-hub { font-size: 0.9rem; color: var(--accent-gold-light); white-space: nowrap; }
    .td-table-scroll { overflow-x: auto; margin-top: 1.4rem; }
    .td-table { width: 100%; border-collapse: collapse; min-width: 560px; background: var(--bg-3); }
    .td-table th, .td-table td { padding: 0.85rem 1rem; border: 1px solid var(--line-2); text-align: left; vertical-align: middle; }
    .td-table thead th {
      font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.09em; text-transform: uppercase;
      color: var(--ink-faint); background: var(--bg-2); white-space: nowrap;
    }
    .td-table tbody th { font-weight: 600; }
    .td-table tbody th a { color: var(--ink); }
    .td-table tbody th a:hover { color: var(--accent-gold-light); }

    /* The table sits on the dark industrial surface (--bg-3), not the light
       ledger, so the chip is built for dark: a bordered control with the same
       gold document marker as DocLink, so a file reads as a file here too.
       An earlier pass styled it for the ledger — white chips on a dark table,
       with light gold text on white that failed contrast. */
    .td-doc {
      display: inline-flex; align-items: center; gap: 0.55rem;
      min-height: 44px; padding: 0.45rem 0.8rem 0.45rem 0.7rem;
      border: 1px solid var(--line-2); border-left: 2px solid var(--accent-gold);
      background: var(--bg-2); color: var(--ink);
      transition: border-color .2s var(--ease-premium), background-color .2s var(--ease-premium);
    }
    .td-doc:hover { border-color: var(--ink-dim); border-left-color: var(--accent-gold); background: var(--bg); }
    .td-doc:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
    .td-doc-icon { display: flex; color: var(--accent-gold); flex-shrink: 0; transition: transform .2s var(--ease-premium); }
    .td-doc:hover .td-doc-icon { transform: translateY(2px); }
    .td-doc-kind {
      font-family: var(--font-mono); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.1em;
      color: var(--accent-gold);
    }
    .td-doc-meta { font-size: 0.8rem; color: var(--ink-dim); }
    @media (prefers-reduced-motion: reduce) { .td-doc, .td-doc-icon { transition: none; } .td-doc:hover .td-doc-icon { transform: none; } }
    .td-none { font-size: 0.85rem; color: var(--ink-faint); }

    .td-enquire-inner { max-width: 720px; }
    .td-enquiry-note { color: var(--ink-dim); margin-top: 0.8rem; line-height: 1.7; }
    .td-enquire-box { margin-top: 1.6rem; }
    /* :global() — this class lands on DocLink.astro's own root element, which
   never carries THIS page's scope hash, so a scoped rule would silently
   not apply. */
    :global(.td-doc-link) { margin-top: 1.6rem; }

    /* The full document name is only needed where the column headers are not
       visible (the mobile card layout below). */
    .td-doc-name { display: none; }
    .td-doc-caution { margin: 0.45rem 0 0; font-size: 0.78rem; line-height: 1.4; color: var(--accent-gold-light); max-width: 34ch; }

    @media (max-width: 640px) {
      .td-hero-badge { display: none; }

      /* Phone: every product becomes a card. The earlier table needed a
         sideways scroll to reach the SDS column, so a buyer could not see at a
         glance which documents a grade has. Now each available document is a
         full-width control carrying its full name; a product with no SDS simply
         shows no SDS control. ARIA roles are set on the elements because
         changing a table's display can drop its semantics. */
      .td-table-scroll { overflow-x: visible; }
      .td-table, .td-table tbody, .td-table tr, .td-table th, .td-table td { display: block; width: 100%; }
      .td-table { min-width: 0; background: transparent; border: 0; }
      .td-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
      .td-table tr { background: var(--bg-3); border: 1px solid var(--line-2); padding: 0.9rem 0.9rem 0.3rem; margin-bottom: 0.75rem; }
      .td-table th, .td-table td { border: 0; padding: 0 0 0.6rem; }
      .td-table tbody th { font-size: 1rem; padding-bottom: 0.7rem; }
      .td-table td.td-cell-empty { display: none; }
      .td-doc { display: grid; grid-template-columns: auto auto 1fr auto; align-items: center; column-gap: 0.55rem; width: 100%; min-height: 52px; padding: 0.55rem 0.8rem; }
      .td-doc-name { display: inline; color: var(--ink); font-weight: 600; font-size: 0.92rem; }
      .td-doc-meta { justify-self: end; font-size: 0.74rem; white-space: nowrap; }
      .td-doc-caution { max-width: none; }
      .td-none { display: block; font-size: 0.85rem; padding: 0.2rem 0; }
    }
  </style>
</Base>
