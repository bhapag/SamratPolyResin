---
import Base from '../layouts/Base.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, buildWhatsAppLink, buildCanonicalUrl, buildOrganizationSchema, ORGANIZATION_ID } from '../data/site.js';

const waLink = buildWhatsAppLink('generic');

const fullAddress = `${site.address.line1}, ${site.address.line2}, ${site.address.state} ${site.address.pin}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${site.mapsQuery}`;

// LocalBusiness for the one real facility, derived from the SAME shared
// Organization node used sitewide (see src/data/site.js) so the name, address,
// phone and certification here can never drift from the rest of the site. Only
// the @type and the map link differ.
//
// Search Console shows genuine local demand this page is marked up for:
// `resin shop in ludhiana` (position 14.5), `doraha ludhiana fabricator with
// phone number` (11.0), `factory near doraha, ludhiana with phone number`
// (38.5), `resin shop near me` (7.0), `frp resin suppliers near me` (1.0),
// with Ludhiana the top city in GA4 for the last 7 days.
//
// Still deliberately ABSENT, because the repository does not contain them and
// inventing them would be a false business claim:
//   openingHours / openingHoursSpecification, geo coordinates, priceRange,
//   aggregateRating, review.
// Supply real opening hours and verified coordinates and they can be added.
const localBusinessJsonLd = {
  ...buildOrganizationSchema(),
  '@type': 'LocalBusiness',
  hasMap: mapsUrl,
};

const contactPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Contact ${site.name}`,
  url: buildCanonicalUrl('/contact/'),
  mainEntity: { '@id': ORGANIZATION_ID },
};
---
<Base
  title="Contact Samrat Poly Resins — Doraha, Ludhiana"
  description={`Contact ${site.name} — phone, WhatsApp, email and enquiry form, plus directions to the plant at ${site.address.line1}, ${site.address.line2} — ${site.address.pin}, ${site.address.state}. Proprietor ${site.proprietor}. GSTIN ${site.gst}.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(contactPageJsonLd)} />
  <section class="section contact">
    <div class="wrap contact-grid">
      <div class="contact-info">
        <p class="eyebrow">Get in touch</p>
        <h1>Request a quote.</h1>
        <p class="contact-lead">
          Tell us the grade and quantity you need. We send prices quickly —
          or reach us directly on WhatsApp or phone.
        </p>
        <div class="contact-lines">
          {site.phones.map((phone) => (
            <a href={`tel:${phone.dial}`} class="cline">
              <span class="cline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 3.5 L9.5 3.5 L11 8 L8.5 9.5 C9.3 12 12 14.7 14.5 15.5 L16 13 L20.5 14.5 L20.5 17.5 C20.5 19.4 18.9 21 17 20.9 C10 20.5 3.5 14 3.1 7 C3 5.1 4.6 3.5 6.5 3.5 Z" /></svg></span>
              <span class="cline-body"><span class="cline-k">Phone</span>{phone.display}</span>
            </a>
          ))}
          <a href={`mailto:${site.email}`} class="cline">
            <span class="cline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="M4 6.5 L12 13 L20 6.5" /></svg></span>
            <span class="cline-body"><span class="cline-k">Email</span>{site.email}</span>
          </a>
          <a href={waLink} target="_blank" rel="noopener" class="cline">
            <span class="cline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.7L7 20.4A10 10 0 1 0 12 2z"/></svg></span>
            <span class="cline-body"><span class="cline-k">WhatsApp</span>Chat now</span>
          </a>
          <a href={mapsUrl} target="_blank" rel="noopener" class="cline">
            <span class="cline-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22 C12 22 19 15 19 9.5 A7 7 0 0 0 5 9.5 C5 15 12 22 12 22 Z" /><circle cx="12" cy="9.5" r="2.4" /></svg></span>
            <span class="cline-body"><span class="cline-k">Plant &amp; office — get directions</span>{fullAddress}</span>
          </a>
        </div>
        <div class="map-embed">
          <iframe
            title="Location map"
            src={`https://www.google.com/maps?q=${site.mapsQuery}&output=embed`}
            loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="contact-catalogue-note">
          <p class="contact-catalogue-heading">Need our complete product range?</p>
          <a href={site.catalogue.url} class="doc-link" target="_blank" rel="noopener" download
             aria-label={`Download ${site.catalogue.title} (PDF)`}>
            <span class="doc-link-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5V4.5A1.5 1.5 0 0 1 5.5 3H18a1 1 0 0 1 1 1v15.2"/><path d="M6.5 3v18"/><path d="M6.5 21H19a1 1 0 0 0 1-1v-.5a1 1 0 0 0-1-1H6.8"/></svg>
            </span>
            <span class="doc-link-body"><span class="doc-link-kind">Catalogue</span><span class="doc-link-title">{site.catalogue.title}</span></span>
            <span class="doc-link-arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <div class="contact-form" id="enquiry">
        <h2 class="contact-form-heading">Send an enquiry</h2>
        {/*
          A quote reply is only as good as the enquiry. Listing what to include
          costs nothing and materially raises the quality of what arrives — the
          same five details the /how-to-order/ page asks for, so the two pages
          cannot drift apart.
        */}
        <ul class="contact-checklist">
          <li><strong>Which grade</strong> — or the component you are making, if you are not sure</li>
          <li><strong>Quantity</strong> and how often you expect to reorder</li>
          <li><strong>Delivery location</strong></li>
          <li><strong>Process</strong> — hand lay-up, spray-up, casting, moulding</li>
          <li><strong>Any specification</strong> or drawing you have been given</li>
        </ul>
        <p class="contact-checklist-foot">
          Not sure which grade? <a href="/tools/resin-selector/">Use the resin selector</a>,
          read <a href="/how-to-order/">how ordering works</a>, or
          <a href="/technical-documents/">download a TDS</a> first.
        </p>
        <div class="custom-request-callout">
          <div>
            <p class="custom-request-label">Need target properties reviewed?</p>
            <p>Record your preferred resin requirements in a focused 2–5 minute request.</p>
          </div>
          <a href="/custom-resin-request/" class="btn btn-solid">Request Custom Resin Specification</a>
        </div>
        <EnquiryForm />
      </div>
    </div>
  </section>

  <style>
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 4rem); }
    .contact-info h1 { font-size: clamp(2.2rem, 6vw, 3.6rem); margin-top: 0.6rem; }
    .contact-lead { color: var(--ink-dim); margin-top: 1rem; max-width: 40ch; }
    .contact-lines { margin-top: 1.8rem; display: flex; flex-direction: column; gap: 0.1rem; }
    .cline {
      display: flex; align-items: center; gap: 0.9rem;
      padding: 0.85rem 0; border-top: 1px solid var(--line); font-size: 0.95rem; color: var(--ink);
      transition: color .25s var(--ease-premium);
    }
    .cline:last-child { border-bottom: 1px solid var(--line); }
    a.cline:hover { color: var(--accent-gold-light); }
    a.cline:hover .cline-icon { color: var(--accent-gold-light); }
    .cline-icon { flex-shrink: 0; display: flex; color: var(--ink-faint); transition: color .25s var(--ease-premium); }
    .cline-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
    .cline-k { font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faint); }
    .contact-checklist {
      list-style: none; margin: 1rem 0 0; padding: 0;
      display: flex; flex-direction: column; gap: 0.45rem;
      font-size: 0.9rem; color: var(--ink-dim);
    }
    .contact-checklist li { padding-left: 1.15rem; position: relative; line-height: 1.55; }
    .contact-checklist li::before {
      content: '—'; position: absolute; left: 0;
      color: var(--ink-faint); font-family: var(--font-mono);
    }
    .contact-checklist strong { color: var(--ink); font-weight: 500; }
    .contact-checklist-foot {
      margin-top: 0.9rem; font-size: 0.85rem; color: var(--ink-faint); line-height: 1.6;
    }
    .contact-checklist-foot a { color: var(--ink-dim); }
    .contact-checklist-foot a:hover { color: var(--accent-gold-light); }

    .map-embed { margin-top: 1.8rem; border: 1px solid var(--line); aspect-ratio: 16 / 10; }
    .map-embed iframe { width: 100%; height: 100%; border: 0; filter: grayscale(0.3) contrast(1.05); }

    .contact-catalogue-note { margin-top: 1.8rem; display: flex; flex-direction: column; gap: 0.6rem; max-width: 420px; }
    .contact-catalogue-heading {
      font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-faint);
    }
    .contact-form { background: var(--bg-3); border: 1px solid var(--line); box-shadow: var(--surface-shadow-rest); padding: clamp(1.4rem, 4vw, 2.2rem); align-self: start; }
    .contact-form-heading {
      font-size: 1.1rem; text-transform: none; letter-spacing: 0; color: var(--ink);
      background: none; -webkit-text-fill-color: unset; text-shadow: none;
      margin-bottom: 1.2rem;
    }
    .custom-request-callout {
      display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem;
      margin-bottom: 1.35rem; padding: 1rem; border: 1px solid rgba(var(--gold-rgb), .3);
      background: rgba(var(--gold-rgb), .06);
    }
    .custom-request-callout p { color: var(--ink-dim); font-size: 0.86rem; line-height: 1.55; }
    .custom-request-callout .custom-request-label {
      color: var(--accent-gold-light); font-family: var(--font-mono); font-size: 0.7rem;
      letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 0.2rem;
    }
    .custom-request-callout .btn { width: 100%; justify-content: center; text-align: center; }
    @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }
  </style>
</Base>
