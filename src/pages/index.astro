    .apps-industries {
      margin-top: clamp(1.8rem, 4vw, 2.6rem); padding-top: 1.3rem; border-top: 1px solid var(--line);
      display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0.8rem 2rem; align-items: baseline;
    }
    .apps-industries-label {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-faint);
    }
    .apps-industries-list { list-style: none; display: flex; flex-wrap: wrap; gap: 0.55rem 0; }
    .apps-industries-list li {
      font-size: 0.88rem; color: var(--ink-dim); line-height: 1.4;
      padding-right: 1rem; margin-right: 1rem; border-right: 1px solid var(--line-2);
    }
    .apps-industries-list li:last-child { border-right: none; margin-right: 0; padding-right: 0; }
    @media (max-width: 760px) {
      .apps-industries { grid-template-columns: 1fr; }
    }

    /* ---------- 05 · credentials & reach ---------- */
    .cred-grid {
      display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      gap: clamp(2rem, 5vw, 4rem); align-items: start;
    }
    .cred-list { border-top: 1px solid var(--line-2); }
    .cred-row {
      display: grid; grid-template-columns: 9.5rem minmax(0, 1fr); gap: 0.4rem 1.5rem;
      padding: 0.95rem 0; border-bottom: 1px solid var(--line);
    }
    .cred-row dt {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--ink-faint); padding-top: 0.2em;
