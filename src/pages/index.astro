    .close-about h2 { font-size: clamp(1.8rem, 3.4vw, 2.6rem); margin-top: 0.55rem; }
    .close-copy { color: var(--ink-dim); margin: 1.1rem 0 1.5rem; max-width: 50ch; line-height: 1.7; }
    .close-enquiry {
      padding: 1.6rem 1.7rem 1.5rem;
      background: color-mix(in srgb, var(--bg-3) 85%, transparent); border: 1px solid var(--line-2);
      border-top: 2px solid var(--accent-gold); border-radius: 4px;
      box-shadow: var(--surface-shadow-rest);
    }
    .close-label {
      font-family: var(--font-display); font-size: clamp(1.4rem, 2.4vw, 1.8rem); text-transform: uppercase;
      letter-spacing: 0.02em; color: var(--ink); line-height: 1.05;
