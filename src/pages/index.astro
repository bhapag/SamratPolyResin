    @media (max-width: 520px) {
      .cat-tile { grid-template-columns: 1.6rem minmax(0, 1fr) auto; }
      .fam-cta { display: none; }
    }

    /* ---------- 02 · selected grades ---------- */
    .flag-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; }
    @media (max-width: 980px) { .flag-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 600px) { .flag-grid { grid-template-columns: 1fr; } }

    /* ---------- 03 · manufacturing & quality ---------- */
    .make-grid {
      display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 5vw, 4rem); align-items: start;
    }
    .make-label {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--ink-faint); padding-bottom: 0.8rem; border-bottom: 1px solid var(--line-2);
    }
    .make-steps { list-style: none; display: flex; flex-direction: column; }
    .make-steps li {
      display: grid; grid-template-columns: 2.4rem minmax(0, 1fr); gap: 0.6rem; align-items: baseline;
      padding: 0.95rem 0; border-bottom: 1px solid var(--line);
    }
    .make-no { font-family: var(--font-mono); font-size: 0.74rem; color: var(--accent-gold); letter-spacing: 0.04em; }
    .make-body { color: var(--ink-dim); font-size: 0.93rem; line-height: 1.6; }
    .make-body strong { color: var(--ink); font-weight: 600; }
    .make-links { margin-top: 1.5rem; }

    .make-media {
      display: grid; grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr);
      grid-template-rows: 1fr 1fr; gap: 0.8rem; align-items: stretch;
    }
    .make-film { grid-row: 1 / 3; min-height: 0; display: flex; }
    .make-photo { display: flex; flex-direction: column; gap: 0.55rem; min-width: 0; }
    .make-frame {
      position: relative; aspect-ratio: 16 / 10; overflow: hidden; flex: 1;
      border: 1px solid var(--line-2); border-radius: 4px; background: var(--bg-3);
      box-shadow: var(--surface-shadow-rest);
    }
    .make-frame img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s var(--ease-premium); }
    .make-photo:hover .make-frame img { transform: scale(1.035); }
    .make-caption {
      font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--ink-faint);
    }
    @media (max-width: 860px) {
      .make-grid { grid-template-columns: 1fr; }
      .make-media { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); }
      .make-frame { aspect-ratio: 4 / 3; }
    }
    @media (max-width: 520px) {
      .make-media { grid-template-columns: 1fr; grid-template-rows: none; }
      /* The frame carries its own ratio as a normal block. The previous
         aspect-ratio-on-a-flex-cell rendered the brand film at 2x3 px in
         WebKit (every iPhone), because all of its content is absolutely
         positioned and nothing gave the flex container a width. */
      .make-film { grid-row: auto; display: block; width: 100%; aspect-ratio: auto; }
      .make-film :global(.brandfilm) { aspect-ratio: 4 / 5; height: auto; min-height: 0; }
      .make-frame { aspect-ratio: 16 / 10; }
