---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import BrandFilm from '../components/home/BrandFilm.astro';
import { products, CATEGORIES, CATEGORY_HUBS } from '../data/products.js';
import { applications } from '../data/applications.js';
import { site, buildWhatsAppLink } from '../data/site.js';
import qcLaboratory from '../assets/quality/qc-laboratory.jpg';
import productionInfrastructure from '../assets/facility/production-infrastructure.jpg';
import heroVideoPosterMobile from '../assets/hero/hero-video-poster-mobile.jpg';
import frpWaterTanks from '../assets/applications/frp-water-tanks.jpg';
import frpRoofingSheets from '../assets/applications/frp-roofing-sheets.jpg';
import coolingTowers from '../assets/applications/cooling-towers.jpg';
import marineBoatComponents from '../assets/applications/marine-boat-components.jpg';
import frpDoor from '../assets/applications/frp-door.jpg';
import frpMouldedGrating from '../assets/applications/frp-moulded-grating.jpg';
import vinylEsterChemicalTanks from '../assets/applications/vinyl-ester-chemical-tanks.jpg';

const waLink = buildWhatsAppLink('generic');
const years = new Date().getFullYear() - Number(site.established);
const certificateUrl = site.certification.url;

// Homepage catalogue entry points: one row per family, with example grades and
// a grade count so the breadth is visible without leaving the page. The
// destination comes from CATEGORY_HUBS — the same single source of truth the
// mega-menu and breadcrumbs read — so a family with a real hub page links to
// it, and one without links to its section on /products/.
const categoryEntries = CATEGORIES.map((cat) => {
  const items = products.filter((p) => p.category === cat);
  const anchor = `/products/#${cat.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`;
  return {
    name: cat,
    count: items.length,
    href: CATEGORY_HUBS[cat] ? `/products/${CATEGORY_HUBS[cat]}/` : anchor,
    hasHub: Boolean(CATEGORY_HUBS[cat]),
    examples: items.slice(0, 3).map((p) => p.name),
  };
});

// One representative grade from six different families, rather than the
// first six entries of the catalogue (which were five GP grades and a sheet
// grade). Resolved by slug so a renamed or removed grade fails the build
// instead of silently dropping a card.
const featuredSlugs = [
  'unsaturated-polyester-resin',
  'roof-light-resin',
  'gp-gelcoat-resin',
  'fire-retardant-resin',
  'vinyl-ester-resin',
  'epoxy-clear-casting-resin',
];
const featured = featuredSlugs.map((slug) => {
  const product = products.find((p) => p.slug === slug);
  if (!product) throw new Error(`homepage features a grade that is not in the catalogue: ${slug}`);
  return product;
});

// Published documentation, counted rather than asserted.
const tdsCount = products.filter((p) => p.tdsUrl).length;
const sdsCount = products.filter((p) => p.sdsUrl).length;
const docsLine = tdsCount === products.length && sdsCount === products.length
  ? 'TDS & SDS published for every grade'
  : tdsCount === sdsCount
    ? `TDS & SDS published for ${tdsCount} of ${products.length} grades`
    : `TDS published for ${tdsCount} of ${products.length} grades`;

// Application tiles link to the real application guides. Alt text and the
// guide title come from the guide itself, and a tile pointing at a guide that
// no longer exists fails the build.
const appTiles = [
  { slug: 'resin-for-water-tank-manufacturing', image: frpWaterTanks, tag: 'Storage', name: 'FRP water tanks' },
  { slug: 'resin-for-roofing-sheet-manufacturing', image: frpRoofingSheets, tag: 'Building materials', name: 'FRP roofing sheets' },
  { slug: 'resin-for-cooling-tower-manufacturing', image: coolingTowers, tag: 'Industrial cooling', name: 'Cooling towers' },
  { slug: 'resin-for-boat-manufacturing', image: marineBoatComponents, tag: 'Marine', name: 'Boat & marine components' },
  { slug: 'resin-for-frp-door-manufacturing', image: frpDoor, tag: 'Doors & panels', name: 'FRP doors' },
  { slug: 'resin-for-general-frp-moulded-products', image: frpMouldedGrating, tag: 'Moulded products', name: 'FRP gratings & mouldings' },
  { slug: 'vinyl-ester-resin-for-chemical-storage-tanks', image: vinylEsterChemicalTanks, tag: 'Chemical process', name: 'Chemical storage tanks' },
].map((tile) => {
  const guide = applications.find((a) => a.slug === tile.slug);
  if (!guide) throw new Error(`homepage links to a missing application guide: ${tile.slug}`);
  return { ...tile, alt: guide.cardImageAlt ?? guide.title };
});

const industries = [
  'FRP fabricators',
  'Water tank manufacturers',
  'Roofing & daylight sheet manufacturers',
  'Door & door-skin manufacturers',
  'Marine & boat builders',
  'Cooling towers & process equipment',
  'Quartz & engineered stone',
  'Decorative FRP — statues, cabins, sculptures',
  'Composite moulders',
];

// site.statesServed mixes domestic states and "Export <country>" entries in
// one list; split them here rather than touching the shared array.
const domesticStates = site.statesServed.filter((s) => !s.startsWith('Export '));
const exportMarkets = site.statesServed.filter((s) => s.startsWith('Export ')).map((s) => s.replace('Export ', ''));

// Hero background video: a still frame from the approved hero footage itself
// is the poster/fallback everywhere in the hero (shown instantly, and
// permanently for prefers-reduced-motion or if video playback fails) — the
// video plays on top of it once it can. Both sizes come from the SAME source
// frame, rendered at the resolution each breakpoint needs, so there is never a
// visible swap between two different images while the hero loads.
//
// Neither hero <video> carries a `poster` attribute: a `poster` is never lazy,
// so both encodes' posters were fetched on every load — the same frame the
// eager <Image> already renders. Removing them moved Slow-4G LCP from
// 13,200 ms to 8,308 ms (measured, 5 cold runs — see HERO_LOADING_OPTIONS.md).
//
// A <video> with no poster and no frames yet paints as an opaque black
// rectangle, which would hide the <Image> underneath it. So the videos start
// at opacity 0 and fade in only once they are genuinely playing
// (`data-playing`, set by the inline script below on the `playing` event).
---
<Base
  title="Samrat Poly Resins | Polyester Resin Manufacturer, Epoxy & FRP Supplies"
  description="Samrat Poly Resins: ISO 9001:2015 certified manufacturer of polyester, gelcoat and fire-retardant resins, supplying epoxy systems and FRP materials. Based in Ludhiana, Punjab — request a quote."
>
  <!-- ================= HERO ================= -->
  <section class="hero home-hero">
    <div class="hero-media" aria-hidden="true">
      <Image src={heroVideoPosterMobile} alt="" loading="eager" fetchpriority="high" widths={[800, 1280, 1920, 2400]} sizes="100vw" />
      <!-- Desktop hero video. The source carries `data-src` instead of `src`,
           and the inline script below assigns the real URL to whichever single
           encode this breakpoint actually needs.
           Why: `display:none` does NOT stop a <video> with `autoplay` from
           being fetched. Measured on this build — a 390px mobile load
           downloaded BOTH encodes (20.7 MB desktop + 6.4 MB mobile).
           `data-src` + an explicit assignment keeps selection in JS we
           control, while still guaranteeing that only one file is ever
           requested. -->
      <video
        class="hero-video hero-video-desktop"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
      >
        <source data-src="/videos/hero-background.mp4" type="video/mp4" />
      </video>
      <!-- Mobile hero video — separate lighter encode (~6MB vs ~20MB). Two
           iOS-Safari-specific reliability fixes, both handled entirely by
           the script below and never touching the desktop element above:
           1) No `loop` attribute — native `loop` was confirmed (via direct
              diagnosis) to seek back to frame 0 correctly but then never
              resume playback. The script's `ended` handler restarts it.
           2) No `<source media>` gating — real iOS Safari's resource
              selection for that attribute cannot be verified without
              physical hardware. Source selection is instead an explicit
              `data-src` → `src` assignment made by the inline script below,
              which never assigns anything to the encode this breakpoint
              does not use. -->
      <video
        class="hero-video hero-video-mobile"
        id="heroVideoMobile"
        autoplay
        muted
        playsinline
        webkit-playsinline="true"
        preload="metadata"
      >
        <source data-src="/videos/hero-background-mobile.mp4" type="video/mp4" />
      </video>
    </div>
    <script is:inline>
      // Runs synchronously during parse, immediately after the two <video>
      // elements — before the browser has any `src` to fetch. This is what
      // guarantees exactly ONE hero video is ever requested. It must stay
      // inline (not a bundled/deferred module): a deferred script would run
      // after the browser had already begun fetching, which is precisely the
      // bug this replaces.
      (function () {
        try {
          // Reduced motion: assign nothing at all. The eager poster frame is
          // already the full experience, and no video is fetched.
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

          // Save-Data: the visitor has asked their browser to use less data.
          // A 1.7-4 MB decorative hero is exactly what that setting is for,
          // so no video is requested and the poster frame stands in. Safari
          // does not implement navigator.connection, so this is a no-op
          // there rather than a false negative - iOS keeps the full
          // experience, which is the safe direction to fail in.
          var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
          if (conn && conn.saveData === true) return;

          var isMobile = window.matchMedia('(max-width: 760px)').matches;
          var video = document.querySelector(isMobile ? '.hero-video-mobile' : '.hero-video-desktop');
          if (!video) return;
          var source = video.querySelector('source[data-src]');
          if (!source) return;
          source.src = source.dataset.src;
          // The video has no `poster` (see the note in the frontmatter), so it
          // would paint an opaque black rectangle over the eager <Image>
          // underneath until it had frames. Reveal it only once playback has
          // genuinely started; until then the poster frame shows through.
          video.addEventListener('playing', function () {
            video.dataset.playing = 'true';
          }, { once: true });
          // Explicit load() after a script-assigned src: some mobile browsers
          // (notably Android Chrome) don't re-run resource selection without it.
          video.load();
        } catch (e) {
          /* If anything here fails the poster frame remains, which is a valid
             visual state — never leave the hero blank. */
        }
      })();
    </script>
    <div class="hero-scrim" aria-hidden="true"></div>

    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">Resin manufacturer · {site.address.line2}, Punjab · Est. {site.established}</p>
        <h1 class="hero-title">
          Polyester, Epoxy &amp; Composite Resin <span class="hero-accent">Manufacturer</span>
        </h1>
        <p class="hero-sub">
          {site.name} manufactures premium GP Polyester, Gel Coat, Fire Retardant,
          Epoxy and Specialty Resin systems for FRP manufacturers and industrial
          applications across India.
        </p>
        <div class="hero-cta">
          <a href="/products/" class="btn btn-solid">Explore products</a>
          <a href={waLink} class="btn btn-wa" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.5-.1-.7.2s-.8.9-.9 1.1c-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.1-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.5c-.2 0-.5 0-.7.3-.2.3-.9.9-.9 2.2s1 2.5 1.1 2.7c.1.2 1.9 3 4.7 4.2 2.8 1.2 2.8.8 3.3.8.5 0 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg>
            Request quotation
          </a>
        </div>
      </div>

      <aside class="hero-desk" aria-label="Sales and technical enquiries">
        <p class="hero-desk-label">Sales &amp; technical enquiries</p>
        <a class="hero-desk-phone" href={`tel:${site.phones[0].dial}`}>{site.phones[0].display}</a>
        <p class="hero-desk-lines">
          <a href={`tel:${site.phones[1].dial}`}>{site.phones[1].display}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <ul class="hero-desk-facts">
          <li>{docsLine}</li>
          <li>{site.packagingRange} drums · bulk orders accepted</li>
          <li>Supplying {domesticStates.length} Indian states · export to {exportMarkets.join(' & ')}</li>
        </ul>
        <a href="/technical-documents/" class="hero-desk-link">TDS &amp; SDS library<span aria-hidden="true"> →</span></a>
      </aside>
    </div>

    <div class="wrap">
      <dl class="hero-ledger">
        <div class="hero-ledger-item"><dt>Quality system</dt><dd>ISO 9001:2015 certified</dd></div>
        <div class="hero-ledger-item"><dt>Established</dt><dd>{site.established} · {years} years</dd></div>
        <div class="hero-ledger-item"><dt>Product range</dt><dd>{products.length} grades · {CATEGORIES.length} families</dd></div>
        <div class="hero-ledger-item"><dt>GSTIN</dt><dd class="num">{site.gst}</dd></div>
      </dl>
    </div>
  </section>

  <!-- ================= 01 · PRODUCT FAMILIES ================= -->
  <section class="hs hs-families">
    <div class="wrap">
      <header class="section-head hs-head">
        <div>
          <p class="eyebrow"><span class="idx">01</span>Product range</p>
          <h2>What we manufacture</h2>
        </div>
        <div class="hs-head-aside">
          <p class="hs-lead">
            <strong>{products.length} grades</strong> across {CATEGORIES.length} families — polyester,
            epoxy, gelcoat, fire-retardant, hardeners and FRP allied materials, each with
            its own published data.
          </p>
          <p class="hs-links">
            <a href="/products/">Full catalogue<span aria-hidden="true"> →</span></a>
            <a href="/technical-documents/">TDS &amp; SDS library<span aria-hidden="true"> →</span></a>
          </p>
        </div>
      </header>

      <div class="fam-list">
        {categoryEntries.map((cat, i) => (
          <a href={cat.href} class="cat-tile">
            <span class="fam-idx">{String(i + 1).padStart(2, '0')}</span>
            <span class="fam-main">
              <span class="fam-name">{cat.name}</span>
              <span class="fam-examples">{cat.examples.join(' · ')}{cat.count > 3 ? ' …' : ''}</span>
            </span>
            <span class="fam-count"><strong>{cat.count}</strong> {cat.count === 1 ? 'grade' : 'grades'}</span>
            <span class="fam-cta" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= 02 · SELECTED GRADES ================= -->
  <section class="hs hs-band hs-flagship">
    <div class="wrap">
      <header class="section-head hs-head">
        <div>
          <p class="eyebrow"><span class="idx">02</span>Selected grades</p>
          <h2>Six grades, six families</h2>
        </div>
        <div class="hs-head-aside">
          <p class="hs-lead">
            One representative grade each from the general-purpose polyester, sheet,
            gelcoat, fire-retardant, industrial vinyl ester and epoxy casting families.
          </p>
          <p class="hs-links">
            <a href="/products/">See all {products.length} products<span aria-hidden="true"> →</span></a>
          </p>
        </div>
      </header>
      <div class="flag-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- ================= 03 · MANUFACTURING & QUALITY ================= -->
  <section class="hs hs-make">
    <div class="wrap">
      <header class="section-head hs-head">
        <div>
          <p class="eyebrow"><span class="idx">03</span>Manufacturing &amp; quality control</p>
          <h2>Batch-controlled production at Doraha</h2>
        </div>
        <div class="hs-head-aside">
          <p class="hs-lead">
            Precision starts on the shop floor. Stainless-steel reactor systems and
            batch-controlled processes hold viscosity, gel time and colour within tight
            tolerances — so every drum performs as specified, not approximately.
          </p>
        </div>
      </header>

      <div class="make-grid">
        <div class="make-text">
          <p class="make-label">Every batch, in order</p>
          <ol class="make-steps">
            <li>
              <span class="make-no">01</span>
              <span class="make-body"><strong>Batch manufacturing</strong> on stainless-steel processing equipment, to a defined specification.</span>
            </li>
            <li>
              <span class="make-no">02</span>
              <span class="make-body"><strong>Viscosity verification</strong> — each batch checked for consistent viscosity.</span>
            </li>
            <li>
              <span class="make-no">03</span>
              <span class="make-body"><strong>Gel time testing</strong> — cure behaviour confirmed before the batch is approved.</span>
            </li>
            <li>
              <span class="make-no">04</span>
              <span class="make-body"><strong>Visual quality inspection</strong> against defined quality parameters, and against prior production runs.</span>
            </li>
            <li>
              <span class="make-no">05</span>
              <span class="make-body"><strong>Dispatch</strong> in {site.packagingRange} drums, with the grade's technical and safety data sheets.</span>
            </li>
          </ol>
          <p class="hs-links make-links">
            <a href="/about/">Inside the facility<span aria-hidden="true"> →</span></a>
            <a href="/technical-documents/">Technical documents<span aria-hidden="true"> →</span></a>
          </p>
        </div>

        <div class="make-media">
          <div class="make-film">
            <BrandFilm />
          </div>
          <figure class="make-photo">
            <div class="facility-frame make-frame">
              <Image src={productionInfrastructure} alt="Stainless-steel resin processing reactors at the Samrat Poly Resins manufacturing facility" widths={[480, 760, 1100]} sizes="(max-width: 860px) 50vw, 520px" loading="lazy" />
            </div>
            <figcaption class="make-caption">Stainless-steel production reactors</figcaption>
          </figure>
          <figure class="make-photo">
            <div class="why-quality-frame make-frame">
              <Image src={qcLaboratory} alt="Quality inspection laboratory at Samrat Poly Resins" widths={[480, 760, 1100]} sizes="(max-width: 860px) 50vw, 520px" loading="lazy" />
            </div>
            <figcaption class="make-caption">Quality inspection laboratory</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 04 · APPLICATIONS ================= -->
  <section class="hs hs-apps">
    <div class="wrap">
      <header class="section-head hs-head">
        <div>
          <p class="eyebrow"><span class="idx">04</span>Applications</p>
          <h2>Where the resin goes to work</h2>
        </div>
        <div class="hs-head-aside">
          <p class="hs-lead">
            {applications.length} documented application guides, each matched to the grade it
            actually uses — from water tanks and roofing sheets to marine hulls and
            chemical storage.
          </p>
          <p class="hs-links">
            <a href="/applications/">All application guides<span aria-hidden="true"> →</span></a>
          </p>
        </div>
      </header>

      <div class="apps-mosaic">
        {appTiles.map((tile, i) => (
          <a href={`/applications/${tile.slug}/`} class:list={['apps-tile', { 'apps-tile-lead': i === 0 }]}>
            <Image
              src={tile.image}
              alt={tile.alt}
              loading="lazy"
              widths={i === 0 ? [360, 480, 620] : [240, 360, 480]}
              sizes={i === 0 ? '(max-width: 760px) 50vw, (max-width: 1080px) 60vw, 460px' : '(max-width: 760px) 50vw, 230px'}
            />
            <span class="apps-cap">
              <span class="apps-tag">{tile.tag}</span>
              <span class="apps-title">{tile.name}</span>
            </span>
          </a>
        ))}
        <figure class="apps-tile apps-tile-video">
          <video class="lazy-video" data-src="/applications-video.mp4" muted loop playsinline preload="none" data-poster="/applications-video-poster.jpg" disablepictureinpicture disableremoteplayback aria-label="Real industrial applications of Samrat Poly Resins products, including cooling towers, FRP roofing and marine components"></video>
          <figcaption class="apps-cap">
            <span class="apps-tag">Showreel</span>
            <span class="apps-title">Resin in application</span>
          </figcaption>
        </figure>
      </div>

      <div class="apps-industries">
        <p class="apps-industries-label">Industries supplied</p>
        <ul class="apps-industries-list">
          {industries.map((name) => <li>{name}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- ================= 05 · CREDENTIALS & REACH ================= -->
  <section class="hs hs-band hs-cred">
    <div class="wrap">
      <header class="section-head hs-head">
        <div>
          <p class="eyebrow"><span class="idx">05</span>Credentials &amp; reach</p>
          <h2>A manufacturer on record</h2>
        </div>
        <div class="hs-head-aside">
          <p class="hs-lead">
            The registration, certification, location and supply coverage a purchase
            department checks before raising an order — stated once, verifiable.
          </p>
        </div>
      </header>

      <div class="cred-grid">
        <dl class="cred-list">
          <div class="cred-row">
            <dt>Certification</dt>
            <dd class="cred-cert-dd">
              <a class="cred-cert" href={certificateUrl} target="_blank" rel="noopener">
                <img src={certificateUrl} alt="ISO 9001:2015 Certificate of Registration — Samrat Poly Resins" width="727" height="1055" loading="lazy" />
              </a>
              <span>
                <strong>ISO 9001:2015</strong> — Quality Management System<br />
                <a class="cred-link" href={certificateUrl} target="_blank" rel="noopener">View the certificate<span aria-hidden="true"> →</span></a>
              </span>
            </dd>
          </div>
          <div class="cred-row">
            <dt>Established</dt>
            <dd><strong>{site.established}</strong> — {years} years of resin manufacturing</dd>
          </div>
          <div class="cred-row">
            <dt>GSTIN</dt>
            <dd class="cred-gst">
              <span class="num cred-gst-no">{site.gst}</span>
              <button type="button" id="gstCopyBtn" class="cred-copy" data-gstin={site.gst}>
                <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M8 7V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2zm2 0h4a2 2 0 0 1 2 2v4h2V5h-8v2zM6 9v8h8V9H6z"/></svg>
                <span class="why-gst-copy-text" aria-live="polite">Copy GSTIN</span>
              </button>
            </dd>
          </div>
          <div class="cred-row">
            <dt>Proprietor</dt>
            <dd>{site.proprietor}</dd>
          </div>
          <div class="cred-row">
            <dt>Facility</dt>
            <dd>{site.address.line1}, {site.address.line2} — {site.address.pin}, {site.address.state}</dd>
          </div>
          <div class="cred-row">
            <dt>Packaging</dt>
            <dd>{site.packagingRange} drums · bulk orders accepted</dd>
          </div>
          <div class="cred-row">
            <dt>Documentation</dt>
            <dd>{docsLine} — <a class="cred-link" href="/technical-documents/">document library<span aria-hidden="true"> →</span></a></dd>
          </div>
        </dl>

        <div class="reach">
          <div class="reach-block">
            <svg class="reach-map" viewBox="-26 -26 360 364" aria-hidden="true">
