    /* ---------- 06 · about & enquiry ---------- */
    .hs-close { background: color-mix(in srgb, var(--bg-2) 88%, transparent); padding-bottom: clamp(3rem, 6vw, 4.5rem); }
    .close-grid {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(2rem, 5vw, 4.5rem); align-items: start;
