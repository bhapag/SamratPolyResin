  <!-- ================= 06 · ABOUT & ENQUIRY ================= -->
  <section class="hs hs-close">
    <div class="wrap close-grid">
      <div class="close-about">
        <p class="eyebrow"><span class="idx">06</span>About the company</p>
        <h2>Built on consistent chemistry.</h2>
        <p class="close-copy">
          Established in {site.established}, {site.name} is a Punjab-based
          manufacturer of coating resin, fire-retardant resin, GP resin and
          allied composite materials — made to perform on the shop floor.
        </p>
        <a href="/about/" class="btn">More about us</a>
      </div>

      <div class="close-enquiry">
        <p class="close-label">Request a quote</p>
        <p class="close-sub">
          Tell us the grade, quantity, application and delivery location —
          we send prices quickly.
        </p>
        <div class="close-cta">
          <a href="/contact/" class="btn btn-solid">Contact us</a>
          <a href={waLink} class="btn btn-wa" target="_blank" rel="noopener">WhatsApp us</a>
        </div>
        <p class="close-lines">
          {site.phones.map((phone) => <a href={`tel:${phone.dial}`}>{phone.display}</a>)}
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <p class="close-tool">Not sure which grade? <a href="/tools/resin-selector/">Use the resin selector<span aria-hidden="true"> →</span></a></p>
      </div>
    </div>
  </section>

  <style is:global>
    /* Homepage-only header treatment. The header is the shared sitewide
       component and is not edited; on this page alone it floats over the top
       of the hero (see .home-hero's negative top margin) and only takes its
       solid ground once the visitor has scrolled. Gated on the hero's own
       class, so no other page can match these rules. */
    body:has(.home-hero) .site-header {
      background-color: transparent;
      border-bottom-color: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      transition: background-color .35s ease, border-color .35s ease, box-shadow .35s ease;
    }
    html[data-home-scrolled] body:has(.home-hero) .site-header,
    body:has(.home-hero) .site-header:has(.nav-toggle[aria-expanded="true"]) {
      background-color: color-mix(in srgb, var(--bg) 88%, transparent);
      border-bottom-color: rgba(var(--gold-rgb), .14);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .22);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
    }
  </style>

  <style>
    /* ==================================================================
       HOMEPAGE — a single dark industrial register, sectioned like a
       technical index: hairlines, mono labels, one rationed gold accent.
       ================================================================== */

    /* ---------- hero ---------- */
    .hero { position: relative; overflow: hidden; }
    /* Pull the hero up under the sticky header so the header floats over the
       footage at the top of the page (the header is 68px tall, Base.astro). */
    .home-hero { margin-top: -68px; padding-top: 68px; }
    .hero-media { position: absolute; inset: 0; z-index: 0; }
    .hero-media img {
      width: 100%; height: 100%; object-fit: cover; object-position: center 35%;
      filter: grayscale(.25) contrast(1.06) brightness(.9);
    }
    /* Background video — sits directly on top of the still photo (which stays
       mounted underneath as the poster/fallback), same fixed frame. */
    .hero-video {
      position: absolute; inset: 0; z-index: 1;
      width: 100%; height: 100%; object-fit: cover; object-position: center 35%;
      filter: grayscale(0) contrast(1.08) brightness(1.22);
      pointer-events: none;
      /* No `poster` attribute (that download was the measured LCP cost).
         A frameless <video> paints opaque black, so stay invisible until
         the inline script confirms playback has started. */
      opacity: 0;
      transition: opacity .45s ease;
    }
    .hero-video[data-playing="true"] { opacity: 1; }
    /* Respect reduced-motion by never even starting playback: the poster
       frame (identical still photo) remains the entire experience. */
    @media (prefers-reduced-motion: reduce) {
      .hero-video { display: none; transition: none; }
    }
    /* These rules control which encode is VISIBLE. Download selection is
       handled by the inline script in the hero markup, which assigns `src`
       to one element only. Breakpoint matches the nav collapse in Base.astro. */
    @media (max-width: 760px) { .hero-video-desktop { display: none; } }
    @media (min-width: 761px) { .hero-video-mobile { display: none; } }

    .hero-scrim {
      position: absolute; inset: 0; z-index: 1;
      background:
        linear-gradient(180deg, rgba(9, 11, 18, .78) 0%, rgba(9, 11, 18, .5) 22%, rgba(9, 11, 18, .56) 68%, var(--bg) 100%),
        linear-gradient(90deg, rgba(9, 11, 18, .62) 0%, rgba(9, 11, 18, .22) 55%, rgba(9, 11, 18, .05) 100%);
    }

    .hero-inner {
      position: relative; z-index: 4;
      display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.72fr);
      gap: clamp(2rem, 5vw, 4.5rem); align-items: end;
      padding-block: clamp(4.5rem, 10vw, 7.5rem) clamp(2.2rem, 4vw, 3rem);
    }
    @media (prefers-reduced-motion: no-preference) {
      .hero-copy > *, .hero-desk, .hero-ledger { animation: hero-fade-up .7s var(--ease-premium) both; }
      .hero-eyebrow { animation-delay: .05s; }
      .hero-title   { animation-delay: .14s; }
      .hero-sub     { animation-delay: .24s; }
      .hero-cta     { animation-delay: .34s; }
      .hero-desk    { animation-delay: .46s; }
      .hero-ledger  { animation-delay: .58s; }
    }
    @keyframes hero-fade-up {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .hero-eyebrow { letter-spacing: 0.16em; }
    .hero-title {
      font-size: clamp(2.55rem, 5.4vw, 4.9rem); font-weight: 700; line-height: 0.98;
      letter-spacing: 0.005em; margin-top: 1.1rem; max-width: 19ch;
      text-wrap: balance;
    }
    /* Static gold — the one accent word on the page, no shine animation. */
    .hero-accent {
      background: linear-gradient(180deg, #f5e3a6 0%, #d4af37 52%, #a9791f 100%);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; color: transparent;
    }
    .hero-sub {
      color: var(--ink-dim); font-size: clamp(1rem, 1.6vw, 1.15rem); max-width: 56ch;
      margin-top: 1.3rem; line-height: 1.7;
    }
    .hero-cta { display: flex; gap: 0.8rem; margin-top: 2rem; flex-wrap: wrap; }

    /* Order desk: the one panel in the hero, a machined plate not a card. */
    .hero-desk {
      position: relative;
      padding: 1.35rem 1.5rem 1.4rem;
      background: rgba(11, 13, 19, .66);
      border: 1px solid rgba(255, 255, 255, .11);
      border-top: 2px solid var(--accent-gold);
      border-radius: 4px;
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      box-shadow: 0 1px 0 rgba(255, 255, 255, .05) inset, 0 26px 50px rgba(0, 0, 0, .38);
    }
    .hero-desk-label {
      font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--ink-faint);
    }
    .hero-desk-phone {
      display: block; margin-top: 0.6rem;
      font-family: var(--font-display); font-size: clamp(1.55rem, 2.2vw, 1.9rem); font-weight: 600;
      letter-spacing: 0.02em; color: var(--ink); line-height: 1.1;
      font-variant-numeric: tabular-nums;
      transition: color .25s var(--ease-premium);
    }
    .hero-desk-phone:hover { color: var(--accent-gold-light); }
    .hero-desk-lines { display: flex; flex-direction: column; gap: 0.2rem; margin-top: 0.55rem; }
    .hero-desk-lines a {
      font-family: var(--font-mono); font-size: 0.8rem; letter-spacing: 0.02em; color: var(--ink-dim);
      transition: color .25s var(--ease-premium);
    }
    .hero-desk-lines a:hover { color: var(--accent-gold-light); }
    .hero-desk-facts {
      list-style: none; margin-top: 1.1rem; padding-top: 1rem; border-top: 1px solid rgba(255, 255, 255, .1);
      display: flex; flex-direction: column; gap: 0.5rem;
      font-size: 0.84rem; line-height: 1.5; color: var(--ink-dim);
    }
    .hero-desk-facts li { position: relative; padding-left: 1rem; }
    .hero-desk-facts li::before {
      content: ''; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px;
      background: var(--accent-gold); transform: rotate(45deg);
    }
    .hero-desk-link {
      display: inline-block; margin-top: 1.1rem;
      font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ink); border-bottom: 1px solid var(--line-2); padding-bottom: 0.2rem;
      transition: color .25s var(--ease-premium), border-color .25s var(--ease-premium);
    }
    .hero-desk-link:hover { color: var(--accent-gold-light); border-color: var(--accent-gold); }

    /* Fact ledger along the hero's lower edge. */
    .hero-ledger {
      position: relative; z-index: 4;
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
      border-top: 1px solid rgba(255, 255, 255, .14);
      margin-top: clamp(0.6rem, 2vw, 1.2rem);
      padding-bottom: clamp(1.4rem, 3vw, 2.2rem);
    }
    .hero-ledger-item { padding: 1rem 1.2rem 0 0; border-right: 1px solid rgba(255, 255, 255, .1); }
    .hero-ledger-item + .hero-ledger-item { padding-left: 1.2rem; }
    .hero-ledger-item:last-child { border-right: none; }
    .hero-ledger dt {
      font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--ink-faint);
    }
    .hero-ledger dd {
      margin-top: 0.35rem; font-family: var(--font-display); font-size: 1.02rem;
      letter-spacing: 0.03em; text-transform: uppercase; color: var(--ink); line-height: 1.2;
    }

    @media (max-width: 980px) {
      .hero-inner { grid-template-columns: 1fr; align-items: start; }
      .hero-desk { max-width: 520px; }
    }
    @media (max-width: 760px) {
      .hero-inner { padding-top: clamp(3.2rem, 12vw, 4.5rem); gap: 2rem; }
      .hero-title { max-width: none; }
      .hero-cta .btn { flex: 1 1 auto; justify-content: center; }
      .hero-ledger { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 0.4rem; }
      .hero-ledger-item:nth-child(2) { border-right: none; }
      .hero-ledger-item:nth-child(3) { padding-left: 0; }
      .hero-ledger-item:nth-child(n + 3) { border-top: 1px solid rgba(255, 255, 255, .08); margin-top: 0.4rem; }
    }

    /* ---------- section system ---------- */
    .hs { position: relative; padding-block: clamp(3.6rem, 7vw, 5.6rem) clamp(3.9rem, 7.5vw, 6rem); }
    .hs::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
      background: linear-gradient(90deg, transparent, var(--line-2) 12%, var(--line-2) 88%, transparent);
    }
    /* Raised bands alternate through the page so long runs of one tone never
       happen; slightly translucent so the sitewide ambient layer still shows
       through in the gutters. */
    .hs-band { background: color-mix(in srgb, var(--bg-2) 86%, transparent); }

    .hs-head {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: 1.4rem clamp(2rem, 5vw, 4rem); align-items: end;
      margin-bottom: clamp(1.9rem, 4vw, 2.8rem);
    }
    .hs-head h2 { font-size: clamp(1.85rem, 3.6vw, 2.85rem); margin-top: 0.55rem; letter-spacing: 0.012em; text-wrap: balance; }
    .idx {
      display: inline-block; margin-right: 0.75rem; padding-right: 0.75rem;
      border-right: 1px solid var(--line-2); color: var(--ink-faint);
    }
    .hs-head-aside { display: flex; flex-direction: column; gap: 0.9rem; padding-bottom: 0.25rem; }
    .hs-lead { color: var(--ink-dim); font-size: 0.95rem; line-height: 1.7; max-width: 52ch; }
    .hs-lead strong { color: var(--ink); }
    .hs-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
    .hs-links a {
      font-family: var(--font-mono); font-size: 0.74rem; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ink); border-bottom: 1px solid var(--line-2); padding-bottom: 0.2rem;
      transition: color .25s var(--ease-premium), border-color .25s var(--ease-premium);
    }
    .hs-links a:hover { color: var(--accent-gold-light); border-color: var(--accent-gold); }
    @media (max-width: 860px) {
      .hs-head { grid-template-columns: 1fr; align-items: start; }
    }

    /* ---------- 01 · family index ---------- */
    .fam-list {
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(1.5rem, 4vw, 3.5rem);
      border-top: 1px solid var(--line-2);
    }
    .cat-tile {
      display: grid; grid-template-columns: 2.1rem minmax(0, 1fr) auto auto;
      align-items: center; gap: 0.9rem;
      padding: 1.05rem 0.5rem 1.05rem 0;
      border-bottom: 1px solid var(--line);
      transition: background-color .25s var(--ease-premium);
    }
    .cat-tile:hover { background-color: color-mix(in srgb, var(--bg-3) 62%, transparent); }
    .cat-tile:hover .fam-name { color: var(--accent-gold-light); }
    .cat-tile:hover .fam-cta { color: var(--ink); transform: translateX(3px); }
    .cat-tile:active { background-color: color-mix(in srgb, var(--bg-3) 85%, transparent); }
    .fam-idx { font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint); letter-spacing: 0.04em; }
    .fam-main { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
    .fam-name {
      font-family: var(--font-display); text-transform: uppercase; font-size: 1.02rem; font-weight: 600;
      letter-spacing: 0.03em; line-height: 1.2; color: var(--ink); transition: color .25s var(--ease-premium);
    }
    .fam-examples { color: var(--ink-dim); font-size: 0.8rem; line-height: 1.5; }
    .fam-count {
      font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ink-faint); white-space: nowrap; font-variant-numeric: tabular-nums;
    }
    .fam-count strong { color: var(--accent-gold-light); font-size: 1rem; font-weight: 500; margin-right: 0.2rem; }
    .fam-cta {
      font-size: 1.05rem; line-height: 1; color: var(--ink-faint); padding-left: 0.4rem;
      transition: color .25s var(--ease-premium), transform .25s var(--ease-premium);
    }
    @media (max-width: 860px) {
      .fam-list { grid-template-columns: 1fr; }
