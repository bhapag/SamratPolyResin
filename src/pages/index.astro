  </style>

  <script>
    // Homepage-only header state: the header floats transparent over the hero
    // at the top of the page and takes its solid ground once scrolled (see the
    // `is:global` style above). Re-evaluated on every client-side navigation;
    // on a page without the hero the attribute is cleared and nothing listens.
    document.addEventListener('astro:page-load', () => {
      const root = document.documentElement;
      const previous = (window as any).__homeHeaderScroll as (() => void) | undefined;
      if (previous) {
        window.removeEventListener('scroll', previous);
        (window as any).__homeHeaderScroll = undefined;
      }
      if (!document.querySelector('.home-hero')) {
        root.removeAttribute('data-home-scrolled');
        return;
      }
      const update = () => { root.toggleAttribute('data-home-scrolled', window.scrollY > 32); };
      update();
      window.addEventListener('scroll', update, { passive: true });
      (window as any).__homeHeaderScroll = update;
    });
  </script>

  <script>
    // Mobile hero video reliability. This script only ever touches
    // #heroVideoMobile — the desktop <video> above is never referenced here.
    //
    // 1) Off mobile widths: nothing to do. The inline script in the hero
    //    markup only ever assigns a `src` to the encode this breakpoint
    //    uses, so outside phone viewports this element has no source and
    //    was never requested.
    //
    // 2) On mobile widths: real iOS Safari autoplay isn't fully verifiable
    //    through desktop-engine automation, so playback isn't left to the
    //    `autoplay` attribute alone — .play() is retried on every event that
    //    can plausibly unlock it (loadeddata, canplay, pageshow, and a
    //    one-time first tap/click as a last resort), each attempt's promise
    //    rejection swallowed safely. `.muted`/`.defaultMuted` are set in JS
    //    too, not just as HTML attributes.
    //
    // 3) Native `loop` was confirmed (via direct WebKit testing) to seek
    //    back to frame 0 correctly at the end of playback but then never
    //    resume — the video freezes on frame 0 instead of looping. Omitting
    //    `loop` (see markup above) makes `ended` fire reliably, so the
    //    restart is driven here instead.
    document.addEventListener('astro:page-load', () => {
      const video = document.getElementById('heroVideoMobile') as HTMLVideoElement | null;
      if (!video || video.dataset.wired === 'true') return;
      video.dataset.wired = 'true';

      const isMobile = () => window.matchMedia('(max-width: 760px)').matches;

      // Off mobile this element has no source at all (see note 1 above) —
      // nothing to unwire, nothing to tear down.
      if (!isMobile()) return;

      // Reduced motion: the inline script deliberately assigned no source,
      // so there is nothing to play and nothing to fetch. Leave the poster.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      video.muted = true;
      video.defaultMuted = true;

      // No "already playing, skip" guard here: .play() on an already-playing
      // video is a harmless no-op, and every one of these listeners —
      // including the loop restart below — needs to be able to actually
      // issue a new play() call for as long as the page lives.
      const tryPlay = () => {
        const result = video.play();
        if (result && typeof result.then === 'function') {
          result.catch(() => {});
        }
      };

      // iOS Safari under Low Power Mode or Low Data Mode can refuse to
      // autoplay even a muted+playsinline video until the user has
      // interacted with the page at all — no error is raised, play() just
      // silently never resolves. document-level listeners (not attached to
      // the video itself, since `.hero-video` is pointer-events:none) retry
      // on the first tap/click/keypress anywhere on the page as a recovery
      // path for exactly that case; none of this affects normal autoplay,
      // which still fires first via loadeddata/canplay/pageshow.
      // No load() here: the inline script in the hero markup already
      // assigned the source and called load() during parse. Calling it a
      // second time would discard that buffer and restart the fetch.
      video.addEventListener('loadeddata', tryPlay);
      video.addEventListener('canplay', tryPlay);
      window.addEventListener('pageshow', tryPlay);
      document.addEventListener('click', tryPlay, { once: true });
      document.addEventListener('touchstart', tryPlay, { once: true, passive: true });
      document.addEventListener('pointerdown', tryPlay, { once: true });
      document.addEventListener('keydown', tryPlay, { once: true });
      tryPlay();

      video.addEventListener('playing', () => {
        video.classList.add('is-playing');
      });

      video.addEventListener('ended', () => {
        video.currentTime = 0;
        tryPlay();
      });
    });
  </script>

  <script>
    document.addEventListener('astro:page-load', () => {
      const btn = document.getElementById('gstCopyBtn') as HTMLButtonElement | null;
      if (!btn || btn.dataset.wired === 'true') return;
      btn.dataset.wired = 'true';

      const label = btn.querySelector('.why-gst-copy-text');
      const gstin = btn.dataset.gstin ?? '';
      let resetTimer: number | undefined;

      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(gstin);
          btn.classList.add('copied');
          if (label) label.textContent = 'Copied';
          window.clearTimeout(resetTimer);
          resetTimer = window.setTimeout(() => {
            btn.classList.remove('copied');
            if (label) label.textContent = 'Copy GSTIN';
          }, 1800);
        } catch {
          // clipboard access unavailable/denied — GSTIN remains visible to copy manually
        }
      });
    });
  </script>

  <script>
    // Applications showreel: don't fetch the file until it's actually about
    // to scroll into view (rootMargin gives it a head start so playback is
    // ready by the time it's visible, not loading on arrival). A tile that is
    // `display:none` at the current breakpoint never intersects, so its clip
    // is never requested.
    document.addEventListener('astro:page-load', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Save-Data: this below-fold clip is decorative, so it is not fetched
      // when the visitor has asked their browser to conserve data.
      const conn = (navigator as any).connection;
      if (conn && conn.saveData === true) return;

      document.querySelectorAll<HTMLVideoElement>('.lazy-video').forEach((video) => {
        if (video.dataset.wired === 'true') return;
        video.dataset.wired = 'true';

        const src = video.dataset.src;
        if (!src) return;

        // Belt-and-braces for mobile autoplay gating: re-assert muted as a
        // JS property (not just the HTML attribute) at the moment we're
        // about to play, since some mobile browsers re-check eligibility
        // here rather than only at parse time.
        const attemptPlay = () => {
          video.muted = true;
          video.play().catch(() => {
            // First attempt can be rejected on some mobile browsers before
            // the resource is fully ready; retry once metadata is loaded.
            video.addEventListener('canplay', () => { video.muted = true; video.play().catch(() => {}); }, { once: true });
          });
        };

        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            video.muted = true;
            // The poster travels as `data-poster` rather than `poster`: a
            // `poster` attribute is never lazy, so it would be fetched during
            // the initial page load. Applying it here means it is requested
            // at the same moment as the video it belongs to.
            const poster = video.dataset.poster;
            if (poster && !video.poster) video.poster = poster;
            video.src = src;
            // Explicit load() after assigning src: some mobile browsers
            // (notably Android Chrome) don't reliably re-run resource
            // selection from a script-assigned src on a preload="none"
            // element without this.
            video.load();
            attemptPlay();
            io.unobserve(video);
          }
        }, { rootMargin: '200px 0px' });

        io.observe(video);

        // This ambient clip must never stay stopped: resume on any
        // browser-initiated pause (tab backgrounded, a network stall across
        // the loop point, OS battery-saver throttling) — there is no user
        // control to pause it, so any pause while the tab is visible is
        // unintended and should self-heal.
        video.addEventListener('pause', () => {
          if (document.visibilityState === 'visible' && video.src) attemptPlay();
        });
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'visible' && video.src && video.paused) attemptPlay();
        });
      });
    });
  </script>
