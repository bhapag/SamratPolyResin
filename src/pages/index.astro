    /* ---------- 04 · applications ---------- */
    /* Five columns: the lead tile (2 rows), six 4:3 tiles in a 3 x 2 block,
       and the portrait showreel (2 rows) — the row height set by the small
       tiles gives the showreel cell a 9:16 shape without any cropping. */
    .apps-mosaic {
      display: grid; grid-template-columns: 2fr 1fr 1fr 1fr 0.9fr; gap: 0.75rem;
    }
    .apps-tile {
      position: relative; overflow: hidden; display: block; min-width: 0;
      background: var(--bg-3); border: 1px solid var(--line); border-radius: 4px;
      aspect-ratio: 4 / 3;
      transition: border-color .3s var(--ease-premium), box-shadow .3s var(--ease-premium);
    }
    .apps-tile:hover { border-color: var(--line-2); box-shadow: var(--surface-shadow-hover); }
    .apps-tile:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }
    .apps-tile img, .apps-tile video {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform .6s var(--ease-premium);
    }
    .apps-tile:hover img { transform: scale(1.05); }
    .apps-tile-lead { grid-column: 1; grid-row: 1 / 3; aspect-ratio: auto; min-height: 0; }
    .apps-tile-video { grid-column: 5; grid-row: 1 / 3; aspect-ratio: auto; min-height: 0; margin: 0; background: #000; }
    /* The two row-spanning tiles take their height from the rows the small
       4:3 tiles define — their media is taken out of flow so its intrinsic
       size can never stretch the rows and leave gaps under the small tiles. */
    .apps-tile-lead img, .apps-tile-video video { position: absolute; inset: 0; }
    .apps-tile-video video { background: #000; }
    .apps-cap {
      position: absolute; inset: auto 0 0 0; padding: 1.5rem 1rem 0.85rem;
      display: flex; flex-direction: column; gap: 0.2rem;
      background: linear-gradient(180deg, transparent, rgba(8, 9, 11, 0.9) 72%);
      pointer-events: none;
    }
    .apps-tile-lead .apps-cap { padding: 2.2rem 1.3rem 1.1rem; }
    .apps-tag {
      font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--accent-gold-light);
    }
    .apps-title { font-family: var(--font-display); font-size: 0.92rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--ink); line-height: 1.15; }
    .apps-tile-lead .apps-title { font-size: 1.35rem; }
    @media (max-width: 1080px) {
      /* Two columns: the lead tile spans both, then six tiles in three rows.
         The showreel needs a portrait cell; below this width there is no
         honest one, so it is not rendered at all — `display:none` keeps its
         IntersectionObserver from ever firing, so the clip is never fetched. */
      .apps-mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .apps-tile-lead { grid-column: 1 / 3; grid-row: auto; aspect-ratio: 16 / 8; }
      .apps-tile-video { display: none; }
    }
    @media (max-width: 600px) {
      .apps-mosaic { gap: 0.6rem; }
      .apps-tile-lead { aspect-ratio: 16 / 10; }
      .apps-tile-lead .apps-cap { padding: 1.5rem 1rem 0.85rem; }
      .apps-tile-lead .apps-title { font-size: 1.1rem; }
