    .cred-row dd { color: var(--ink-dim); font-size: 0.93rem; line-height: 1.6; }
    .cred-row dd strong { color: var(--ink); font-weight: 600; }
    .cred-link {
      font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.04em; color: var(--ink);
      white-space: nowrap;
      border-bottom: 1px solid var(--line-2); transition: color .25s var(--ease-premium), border-color .25s var(--ease-premium);
    }
    .cred-link:hover { color: var(--accent-gold-light); border-color: var(--accent-gold); }
    .cred-cert-dd { display: flex; align-items: flex-start; gap: 1rem; }
    .cred-cert {
      display: block; flex: 0 0 auto; width: 52px; overflow: hidden;
      border: 1px solid var(--line-2); background: #fff;
    }
    .cred-cert img { width: 100%; height: auto; display: block; transition: transform .4s var(--ease-premium); }
    .cred-cert:hover img { transform: scale(1.04); }
    .cred-gst { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .cred-gst-no { font-family: var(--font-mono); font-size: 1rem; font-weight: 600; letter-spacing: 0.12em; color: var(--ink); }
    .cred-copy {
