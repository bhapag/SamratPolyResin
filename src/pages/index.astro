      background: var(--line); border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
    }
    .reach-block {
      background: color-mix(in srgb, var(--bg-3) 80%, transparent); padding: 1.4rem 1.3rem 1.3rem;
      display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem;
    }
    .reach-map { width: 100%; max-width: 150px; height: auto; }
    .reach-map-export { max-width: 170px; }
    .reach-land { fill: var(--line-2); stroke: var(--line); stroke-width: 1; stroke-linejoin: round; }
    .reach-dot { fill: var(--accent-gold); }
    .reach-neighbour { fill: var(--line-2); stroke: var(--accent-gold); stroke-width: 1.5; stroke-linejoin: round; }
    .reach-label {
      font-family: var(--font-mono); font-size: 0.64rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--ink-faint); margin-top: 0.4rem;
