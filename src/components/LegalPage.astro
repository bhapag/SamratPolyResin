---
import Base from '../layouts/Base.astro';
import { buildCanonicalUrl } from '../data/site.js';

// Shared frame for the policy pages: plain reading layout, dates stated at
// the top, a contents list, and a breadcrumb. Deliberately not a landing page.
const { title, description, path, effective, revised, sections = [] } = Astro.props;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: buildCanonicalUrl('/') },
    { '@type': 'ListItem', position: 2, name: title, item: buildCanonicalUrl(path) },
  ],
};
---
<Base title={`${title} | Samrat Poly Resins`} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <article class="section legal">
    <div class="wrap legal-wrap">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{title}</span>
      </nav>
      <h1>{title}</h1>
      <p class="legal-dates">Effective {effective}{revised && revised !== effective ? ` · Last revised ${revised}` : ''}</p>
      {sections.length > 0 && (
        <nav class="legal-toc" aria-labelledby="legal-toc-h">
          <h2 id="legal-toc-h">Contents</h2>
          <ol>
            {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          </ol>
        </nav>
      )}
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </article>

  <style>
    .legal-wrap { max-width: 50rem; }
    .legal h1 { font-size: clamp(2rem, 5vw, 3rem); margin-top: 0.8rem; }
    .legal-dates { color: var(--ink-dim); font-family: var(--font-mono); font-size: 0.8rem; margin-top: 0.6rem; }
    .legal-toc { margin-top: 1.8rem; padding: 1rem 1.2rem; border: 1px solid var(--line-2); background: var(--bg-2); }
    .legal-toc h2 { font-size: 0.95rem; margin: 0 0 0.5rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .legal-toc ol { margin: 0; padding-left: 1.3rem; display: grid; gap: 0.2rem; }
    .legal-toc a { color: var(--ink-dim); text-decoration: underline; text-underline-offset: 0.16em; display: inline-block; padding: 0.2rem 0; }
    .legal-toc a:hover { color: var(--accent-gold-light); }
    .legal-body { margin-top: 2rem; }
    .legal-body :global(h2) { font-size: 1.35rem; margin: 2.2rem 0 0.7rem; scroll-margin-top: 6rem; }
    .legal-body :global(h3) { font-size: 1.05rem; margin: 1.4rem 0 0.5rem; }
    .legal-body :global(p), .legal-body :global(li) { color: var(--ink-dim); line-height: 1.75; font-size: 0.98rem; }
    .legal-body :global(p) { margin: 0 0 0.9rem; max-width: 68ch; }
    .legal-body :global(ul) { margin: 0 0 1rem; padding-left: 1.3rem; display: grid; gap: 0.35rem; max-width: 68ch; }
    .legal-body :global(a) { color: var(--accent-gold-light); text-decoration: underline; text-underline-offset: 0.16em; }
    .legal-body :global(strong) { color: var(--ink); }
    .legal-body :global(.legal-table-wrap) { overflow-x: auto; margin: 0.6rem 0 1.2rem; }
    .legal-body :global(table) { border-collapse: collapse; width: 100%; min-width: 36rem; font-size: 0.9rem; }
    .legal-body :global(th), .legal-body :global(td) { text-align: left; vertical-align: top; padding: 0.6rem 0.7rem; border-bottom: 1px solid var(--line); color: var(--ink-dim); line-height: 1.55; }
    .legal-body :global(th) { color: var(--ink); font-weight: 600; }
    .legal-body :global(caption) { text-align: left; color: var(--ink-dim); font-size: 0.85rem; padding-bottom: 0.4rem; }
  </style>
</Base>
