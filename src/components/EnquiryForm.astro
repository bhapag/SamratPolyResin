---
import { site } from '../data/site.js';
// optional: pass product={name} to pre-fill the enquiry
const {
  product,
  productSlug,
  pageContext,
  messagePlaceholder = 'Application, grade, technical specifications, or anything else we should know…',
} = Astro.props;
const demo = !site.formEndpoint;
---
<form
  class="enq"
  id="enquiryForm"
  novalidate
  data-demo={demo ? 'true' : 'false'}
  data-lead-form
  data-product-slug={productSlug}
  data-product-name={product}
  data-page-context={pageContext}
>
  <!-- Web3Forms access key -->
  <input type="hidden" name="access_key" value={site.formEndpoint} />
  <input type="hidden" name="subject" value={`New enquiry — ${site.name}`} />
  <input type="hidden" name="from_name" value={site.name} />
  <!-- Populated client-side and sent with Web3Forms; never shown in the form UI. -->
  <input type="hidden" name="utm_source" value="" />
  <input type="hidden" name="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" value="" />
  <input type="hidden" name="utm_content" value="" />
  <input type="hidden" name="utm_term" value="" />
  <input type="hidden" name="initial_landing_page" value="" />
  <input type="hidden" name="current_page" value="" />
  <input type="hidden" name="referrer" value="" />
  <input type="hidden" name="first_touch_channel" value="" />
  <input type="hidden" name="product_slug" value="" />
  <input type="hidden" name="product_name" value="" />
  <input type="hidden" name="page_context" value="" />
  <!-- honeypot -->
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

  {/* 2026-09-13 data minimisation: phone was mandatory even for buyers who
      prefer email. Now either one is enough; name and message stay required
      because a reply is not possible without them. */}
  <div class="row two">
    <label>
      <span>Name</span>
      <input type="text" name="name" required autocomplete="name" placeholder="Your name" aria-describedby="enqNameError" />
      <small class="enq-field-error" id="enqNameError" hidden>Please enter your name.</small>
    </label>
    <label>
      <span>Company <em>(optional)</em></span>
      <input type="text" name="company" autocomplete="organization" placeholder="Company or workshop" />
    </label>
  </div>

  <fieldset class="row enq-contact" aria-describedby="enqContactHelp enqContactError">
    <legend class="enq-legend">How should we reply? <em>(phone or email, at least one)</em></legend>
    <div class="row two">
      <label>
        <span>Phone / WhatsApp</span>
        <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="Mobile number" />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" autocomplete="email" placeholder="you@company.com" />
      </label>
    </div>
    <small class="enq-help" id="enqContactHelp">We only use these to answer this enquiry.</small>
    <small class="enq-field-error" id="enqContactError" hidden>Please give a phone number or an email address so we can reply.</small>
  </fieldset>

  <div class="row two">
    <label>
      <span>Product of interest <em>(optional)</em></span>
      <input type="text" name="product" value={product ?? ''} placeholder="e.g. Fire Retardant Resin" />
    </label>
    <label>
      <span>Requirement type <em>(optional)</em></span>
      <select name="requirement_type">
        <option value="">Select an option</option>
        <option value="Quote request">Quote request</option>
        <option value="TDS request">TDS request</option>
        <option value="Technical discussion">Technical discussion</option>
      </select>
    </label>
  </div>

  <div class="row two">
    <label>
      <span>Quantity required <em>(optional)</em></span>
      <input type="text" name="quantity_required" placeholder="e.g. 500 kg per month" />
    </label>
    <label>
      <span>Delivery location <em>(optional)</em></span>
      <input type="text" name="delivery_location" autocomplete="address-level1" placeholder="City, state" />
    </label>
  </div>

  <label class="row">
    <span>Requirement / message</span>
    <textarea name="message" rows="4" required placeholder={messagePlaceholder} aria-describedby="enqMessageError"></textarea>
    <small class="enq-field-error" id="enqMessageError" hidden>Please describe what you need.</small>
  </label>

  <p class="enq-privacy">
    Your enquiry is delivered to our email inbox by Web3Forms, a form-delivery service.
    The page you sent it from and how you reached the site (for example a search or a link) are attached so we know what you were looking at.
    We use the details to reply to you and discuss your requirement. This form does not sign you up to any newsletter or mailing list.
    <a href="/privacy-policy/">Privacy Policy</a>
  </p>

  <div class="enq-foot">
    <button type="submit" class="btn btn-solid">Send enquiry</button>
    <p class="enq-status" id="enqStatus" role="status" aria-live="polite"></p>
  </div>

  {demo && (
    <p class="demo-note">
      Demo mode — no email is sent yet. Add a Web3Forms key in <code>src/data/site.js</code> to go live. See README.
    </p>
  )}
</form>

<style>
  .enq { display: flex; flex-direction: column; gap: 1.1rem; }
  .row { display: flex; flex-direction: column; gap: 0.4rem; }
  .row.two { display: grid; grid-template-columns: 1fr 1fr; gap: 1.1rem; }
  @media (max-width: 560px) { .row.two { grid-template-columns: 1fr; } }
  .enq label > span {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--ink-dim);
  }
  .enq label > span em { color: var(--ink-faint); font-style: normal; }
  .enq input, .enq select, .enq textarea {
    background: var(--bg); border: 1px solid var(--line-2); color: var(--ink);
    padding: 0.75rem 0.85rem; font-family: var(--font-body); font-size: 0.95rem;
    width: 100%; transition: border-color .16s;
  }
  @media (max-width: 760px) {
    .enq input, .enq select, .enq textarea { font-size: 1rem; }
  }
  .enq input:focus, .enq select:focus, .enq textarea:focus { outline: none; border-color: var(--accent-gold); }
  .enq input::placeholder, .enq textarea::placeholder { color: var(--ink-faint); }
  .enq-foot { display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap; margin-top: 0.3rem; }
  .enq-status { font-family: var(--font-mono); font-size: 0.8rem; }
  .enq-contact { border: 0; padding: 0; margin: 0; min-width: 0; }
  .enq-legend { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-dim); margin-bottom: 0.5rem; padding: 0; }
  .enq-legend em { color: var(--ink-faint); font-style: normal; text-transform: none; letter-spacing: 0.02em; }
  .enq-help { color: var(--ink-faint); font-size: 0.8rem; }
  .enq-field-error { color: #ff8a8a; font-size: 0.85rem; }
  .enq [aria-invalid="true"] { border-color: #ff8a8a; }
  .enq-privacy { color: var(--ink-dim); font-size: 0.84rem; line-height: 1.55; margin: 0; }
  .enq-privacy a { color: var(--accent-gold-light); text-decoration: underline; text-underline-offset: 0.16em; }
  .enq-status.ok { color: #2ee87a; }
  .enq-status.err { color: #ff6b6b; }
  .demo-note {
    font-family: var(--font-mono); font-size: 0.72rem; color: var(--ink-faint);
    border-left: 2px solid var(--accent-gold); padding-left: 0.8rem; line-height: 1.6;
  }
  .demo-note code { color: var(--accent-gold-light); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('enquiryForm') as HTMLFormElement | null;
    const statusEl = document.getElementById('enqStatus');
    if (!form || !statusEl || form.dataset.wired === 'true') return;
    form.dataset.wired = 'true';

    // Pre-fill from the query string so the resin selector and the quantity
    // tool can hand a buyer straight into a started enquiry instead of an empty
    // one. Only ever fills fields the visitor has not already typed into, and
    // only these two keys — nothing here can populate name, phone or email, so
    // a crafted link cannot put words in a visitor's mouth.
    try {
      const params = new URLSearchParams(window.location.search);
      const productParam = params.get('product');
      const contextParam = params.get('context');

      const productField = form.querySelector('input[name="product"]') as HTMLInputElement | null;
      if (productParam && productField && !productField.value) {
        productField.value = productParam.slice(0, 120);
      }

      const messageField = form.querySelector('textarea[name="message"]') as HTMLTextAreaElement | null;
      if (contextParam && messageField && !messageField.value) {
        messageField.value = contextParam.slice(0, 400);
      }

      if ((productParam || contextParam) && window.location.hash === '#enquiry') {
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    } catch {
      // A malformed query string must never stop the form from working.
    }

    const field = (name: string) => form.querySelector(`[name="${name}"]`) as HTMLInputElement | HTMLTextAreaElement;
    const setError = (el: HTMLElement | null, targets: Element[], show: boolean) => {
      if (el) el.hidden = !show;
      targets.forEach((t) => (show ? t.setAttribute('aria-invalid', 'true') : t.removeAttribute('aria-invalid')));
    };
    const validate = () => {
      const name = field('name'), phone = field('phone'), email = field('email') as HTMLInputElement, message = field('message');
      const nameOk = name.value.trim() !== '';
      const emailFormatOk = !email.value.trim() || email.validity.valid;
      const contactOk = (phone.value.trim() !== '' || email.value.trim() !== '') && emailFormatOk;
      const messageOk = message.value.trim() !== '';
      setError(document.getElementById('enqNameError'), [name], !nameOk);
      const contactErr = document.getElementById('enqContactError');
      if (contactErr) contactErr.textContent = emailFormatOk ? 'Please give a phone number or an email address so we can reply.' : 'Please check the email address.';
      setError(contactErr, [phone, email], !contactOk);
      setError(document.getElementById('enqMessageError'), [message], !messageOk);
      const firstBad = !nameOk ? name : !contactOk ? (emailFormatOk ? phone : email) : !messageOk ? message : null;
      if (firstBad) (firstBad as HTMLElement).focus();
      return !firstBad;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) {
        statusEl.className = 'enq-status err';
        statusEl.textContent = 'Please fix the highlighted fields.';
        return;
      }
      const isDemo = form.dataset.demo === 'true';
      statusEl.className = 'enq-status';
      document.dispatchEvent(new CustomEvent('samrat:prepare-lead-form', { detail: { form } }));

      if (isDemo) {
        statusEl.textContent = '✓ Looks good — connect a form key to actually send.';
        statusEl.classList.add('ok');
        form.reset();
        return;
      }

      statusEl.textContent = 'Sending…';
      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form) as any)),
        });
        const data = await res.json();
        if (data.success) {
          document.dispatchEvent(new CustomEvent('samrat:lead-submitted', { detail: { form } }));
          statusEl.textContent = '✓ Enquiry sent — we’ll be in touch shortly.';
          statusEl.classList.add('ok');
          form.reset();
        } else {
          throw new Error(data.message || 'failed');
        }
      } catch {
        statusEl.textContent = '✗ Could not send. Please call or WhatsApp us instead.';
        statusEl.classList.add('err');
      }
    });
  });
</script>
