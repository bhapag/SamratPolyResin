---
// Compact top-of-article CTA linking a resource article to the single
// product it maps 1:1 to. `product` is a full entry from products.js —
// name and URL are read from it, never duplicated here.
const { product } = Astro.props;
---
<a href={`/products/${product.slug}/`} class="product-cta">
  <span class="product-cta-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 8 L12 3 L20 8 L20 17 L12 22 L4 17 Z" />
      <path d="M4 8 L12 13 L20 8" />
      <path d="M12 13 L12 22" />
    </svg>
  </span>
  <span class="product-cta-text">
    <span class="product-cta-label">Related product</span>
    <span class="product-cta-name">View {product.name}</span>
  </span>
  <span class="product-cta-arrow" aria-hidden="true">→</span>
</a>

<style>
  .product-cta {
    position: relative; overflow: hidden;
    display: flex; align-items: center; gap: 0.9rem;
    margin: 1.6rem 0 2rem;
    padding: 1rem 1.2rem;
    background: var(--bg-3);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent-gold);
    box-shadow: var(--surface-shadow-rest);
    transition: border-color .3s var(--ease-premium), transform .3s var(--ease-premium), box-shadow .3s var(--ease-premium);
  }
  .product-cta::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: -45%; width: 35%;
    background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.16), transparent);
    transform: translateX(0) skewX(-18deg);
    transition: transform .65s var(--ease-premium);
    pointer-events: none;
  }
  .product-cta:hover::after { transform: translateX(340%) skewX(-18deg); }
  .product-cta:hover {
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: var(--surface-shadow-hover);
  }
  .product-cta:focus-visible { outline: 2px solid var(--accent-gold); outline-offset: 2px; }

  .product-cta-icon {
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; width: 40px; height: 40px;
    color: var(--accent-gold);
    background: color-mix(in srgb, var(--accent-gold) 10%, transparent);
    border: 1px solid rgba(var(--gold-rgb), .25);
  }

  .product-cta-text { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; flex: 1; }
  .product-cta-label {
    font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-faint);
  }
  .product-cta-name {
    font-family: var(--font-display); font-weight: 600; letter-spacing: 0.01em;
    font-size: 1.02rem; color: var(--ink); text-transform: uppercase;
  }

  .product-cta-arrow {
    flex-shrink: 0; color: var(--accent-gold-light); font-size: 1.2rem;
    transition: transform .3s var(--ease-premium);
  }
  .product-cta:hover .product-cta-arrow { transform: translateX(4px); }

  @media (max-width: 560px) {
    .product-cta { padding: 0.85rem 1rem; gap: 0.7rem; }
    .product-cta-icon { width: 34px; height: 34px; }
    .product-cta-name { font-size: 0.92rem; }
  }
</style>
