---
// Foreground manufacturer Brand Film — independent of the hero video and the
// sitewide AmbientBackground layer. Renders a single portrait media frame that
// the homepage places inside its manufacturing mosaic. Runs a managed cycle:
// the supplied video plays once in full, then the supplied still photo holds
// for 5 seconds, then the video plays again — forever. See the <script> below
// for the single-timer state machine that drives it.
import { Image, getImage } from 'astro:assets';
import { site } from '../../data/site.js';
import brandFilmStill from '../../assets/brand-film/samrat-poly-resins-brand-film-still.png';

// The supplied master is a 1.7 MB PNG (941x1672). Routing it through Astro's
// image pipeline emits sized WebP derivatives; the original master is
// untouched and still present in public/videos/ and src/assets/brand-film/.
//
// The poster is applied by JS on activation (`data-poster`), not as a `poster`
// attribute: a `poster` is never lazy, and this frame sits well below the
// fold. The <Image> layer below renders the identical still, responsively and
// lazily, and is the visible layer until the video is genuinely playing.
const brandFilmPoster = await getImage({ src: brandFilmStill, width: 1020, format: 'webp' });
---

<figure class="brandfilm" id="brandFilmFrame">
  <video
    class="brandfilm-layer brandfilm-video"
    id="brandFilmVideo"
    muted
    playsinline
    preload="none"
    data-poster={brandFilmPoster.src}
    aria-label={`${site.name} manufacturing brand film`}
    disablepictureinpicture
    disableremoteplayback
  >
    <source data-src="/videos/samrat-poly-resins-brand-film.mp4" type="video/mp4" />
  </video>
  <Image
    class="brandfilm-layer brandfilm-photo is-active"
    id="brandFilmPhoto"
    src={brandFilmStill}
    alt={`${site.name} manufacturing — brand film still`}
    widths={[340, 680, 1020]}
    sizes="(max-width: 860px) 50vw, 320px"
    format="webp"
    loading="lazy"
  />
  <figcaption class="brandfilm-caption">
    <span class="brandfilm-tag">Brand film</span>
    <span class="brandfilm-title">Inside the plant</span>
  </figcaption>
</figure>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.getElementById('brandFilmFrame');
    if (!root || root.dataset.wired === 'true') return;
    root.dataset.wired = 'true';

    const video = document.getElementById('brandFilmVideo') as HTMLVideoElement | null;
    const photo = document.getElementById('brandFilmPhoto') as HTMLImageElement | null;
    if (!video || !photo) return;

    // Reduced motion, or Save-Data: static supplied photo only. No video
    // load, no cycle. The <Image> layer is already the visible state, so this
    // costs the visitor nothing but the 25.9MB-master-derived clip.
    const conn = (navigator as any).connection;
    const saveData = Boolean(conn && conn.saveData === true);
    if (saveData || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.style.display = 'none';
      photo.classList.add('is-active');
      return;
    }

    let activated = false;
    // Which half of the cycle we are in. The photo is the initially visible
    // layer (the video has no poster and would otherwise paint black), so the
    // video is not `is-active` during its own first buffering.
    let phase: 'video' | 'photo' = 'video';
    // The single managed timer for the whole cycle — always cleared before
    // being reassigned, so pausing/resuming off-screen or a fast re-entry
    // can never stack a second one.
    let photoTimer: ReturnType<typeof window.setTimeout> | undefined;

    const showVideo = () => { video.classList.add('is-active'); photo.classList.remove('is-active'); };
    const showPhoto = () => { photo.classList.add('is-active'); video.classList.remove('is-active'); };

    const attemptPlay = () => {
      video.muted = true;
      const result = video.play();
      if (result && typeof result.then === 'function') {
        result.catch(() => {
          video.addEventListener('canplay', () => { video.muted = true; video.play().catch(() => {}); }, { once: true });
        });
      }
    };

    // Attach the real source only once the frame is actually approaching the
    // viewport — see the scroll check below.
    const ensureActivated = () => {
      if (activated) return;
      activated = true;
      const posterSrc = video.dataset.poster;
      if (posterSrc && !video.poster) video.poster = posterSrc;
      const source = video.querySelector('source');
      const src = source?.dataset.src;
      if (source && src) source.src = src;
      video.load();
      attemptPlay();
    };

    // The one place the cycle advances: video ends -> show the photo for
    // exactly 5s -> hide it, rewind the video, play it again. Native
    // `ended` (not `loop`) is what makes the 5s still interval possible.
    // Hand over from the still to the video only once frames are actually
    // being presented — never while it is still black.
    video.addEventListener('playing', () => { if (phase === 'video') showVideo(); });

    video.addEventListener('ended', () => {
      phase = 'photo';
      showPhoto();
      if (photoTimer) window.clearTimeout(photoTimer);
      photoTimer = window.setTimeout(() => {
        photoTimer = undefined;
        phase = 'video';
        showVideo();
        video.currentTime = 0;
        attemptPlay();
      }, 5000);
    });

    // Off-screen: pause decoding. Back on-screen: resume — but only if the
    // cycle is currently in its video phase; during the photo phase the
    // video is already paused and the 5s timer keeps running regardless of
    // visibility, so the cycle's timing never drifts.
    //
    // A plain rAF-throttled scroll check, not IntersectionObserver: a freshly
    // created observer's first callback isn't reliably synchronous with real
    // layout state on a cold load in this project's test environment. A
    // synchronous rect check sidesteps that entirely.
    const checkVisibility = () => {
      const rect = root.getBoundingClientRect();
      const nearOrInViewport = rect.top < window.innerHeight + 200 && rect.bottom > -200;
      if (nearOrInViewport) {
        ensureActivated();
        if (phase === 'video' && video.paused && video.src) attemptPlay();
      } else if (!video.paused) {
        video.pause();
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { ticking = false; checkVisibility(); });
    };

    checkVisibility();
    window.addEventListener('scroll', onScroll, { passive: true });
  });
</script>

<style>
  /* The frame fills whatever grid cell the homepage gives it; the portrait
     media covers the cell, so the parent decides the shape. */
  .brandfilm {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--line-2);
    border-radius: 4px;
    background: var(--bg-3);
    box-shadow: var(--surface-shadow-rest);
  }
  .brandfilm-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 320ms var(--ease-premium);
  }
  .brandfilm-layer.is-active { opacity: 1; }
  .brandfilm-video { z-index: 1; }
  .brandfilm-photo { z-index: 2; }
  .brandfilm-caption {
    position: absolute; inset: auto 0 0 0; z-index: 3;
    display: flex; flex-direction: column; gap: 0.2rem;
    padding: 1.6rem 1rem 0.9rem;
    background: linear-gradient(180deg, transparent, rgba(8, 9, 11, 0.86) 70%);
    pointer-events: none;
  }
  .brandfilm-tag {
    font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent-gold-light);
  }
  .brandfilm-title {
    font-family: var(--font-display); font-size: 0.98rem; letter-spacing: 0.02em;
    text-transform: uppercase; color: var(--ink);
  }
</style>
